<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.esprit.Controller.EquipeDetailController"
            styleClass="page-root">
    <top>
        <HBox fx:id="navbarRoot" alignment="CENTER_LEFT" spacing="16" styleClass="navbar-root" BorderPane.alignment="CENTER">
            <padding>
                <Insets top="10" right="20" bottom="10" left="20"/>
            </padding>

            <Button fx:id="adminNavButton"
                    onAction="#handleOpenAdmin"
                    text="Admin"
                    mnemonicParsing="false"
                    styleClass="navbar-admin-button"/>

            <HBox fx:id="sidebarBrandBox" alignment="CENTER_LEFT" spacing="10" styleClass="navbar-brand" onMouseClicked="#handleOpenHome">
                <StackPane styleClass="navbar-logo-shell">
                    <ImageView fitWidth="152" fitHeight="50" preserveRatio="true" smooth="true">
                        <image>
                            <Image url="@../images/sport-insight-logo.png"/>
                        </image>
                    </ImageView>
                </StackPane>
            </HBox>

            <StackPane HBox.hgrow="ALWAYS" styleClass="navbar-center-wrap">
                <HBox alignment="CENTER" spacing="9" styleClass="navbar-modules">
                    <Button fx:id="matchsNavButton"
                            onAction="#handleOpenMatchs"
                            text="Matchs"
                            styleClass="navbar-nav-button"/>
                    <HBox fx:id="sidebarModuleChildrenBox"
                          spacing="8"
                          alignment="CENTER"
                          managed="false"
                          visible="false"
                          styleClass="navbar-submenu">
                        <Button fx:id="equipesNavButton"
                                onAction="#handleOpenEquipes"
                                text="Equipes"
                                styleClass="navbar-nav-button navbar-submenu-button"/>
                        <Button fx:id="leaguesNavButton"
                                onAction="#handleOpenLeagues"
                                text="Leagues"
                                styleClass="navbar-nav-button navbar-submenu-button"/>
                        <Button fx:id="joueursNavButton"
                                onAction="#handleOpenJoueurs"
                                text="Joueurs"
                                styleClass="navbar-nav-button navbar-submenu-button"/>
                    </HBox>
                    <Button fx:id="annonceNavButton"
                            onAction="#handleOpenAnnonces"
                            text="Anonce"
                            styleClass="navbar-nav-button"/>
                </HBox>
            </StackPane>

            <HBox alignment="CENTER_RIGHT" styleClass="navbar-theme-wrap">
                <ToggleButton fx:id="themeToggleButton"
                              mnemonicParsing="false"
                              contentDisplay="GRAPHIC_ONLY"
                              styleClass="theme-toggle">
                    <graphic>
                        <StackPane styleClass="theme-toggle-track">
                            <StackPane styleClass="theme-toggle-thumb">
                                <StackPane styleClass="theme-toggle-icon-shell">
                                    <Label text="☀" styleClass="theme-toggle-icon theme-toggle-sun"/>
                                    <Label text="☾" styleClass="theme-toggle-icon theme-toggle-moon"/>
                                </StackPane>
                            </StackPane>
                        </StackPane>
                    </graphic>
                </ToggleButton>
            </HBox>
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true"
                    hbarPolicy="NEVER"
                    pannable="true"
                    styleClass="page-scroll"
                    BorderPane.alignment="CENTER">
            <content>
                <StackPane styleClass="page-shell-wrap">
                <VBox spacing="18" alignment="TOP_CENTER" maxWidth="1180" styleClass="page-shell team-detail-page-shell">
                    <padding>
                        <Insets top="24" right="28" bottom="28" left="28"/>
                    </padding>

                    <VBox spacing="16" styleClass="panel-card detail-page-shell">
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <Button onAction="#handleBack"
                                    text="Retour"
                                    styleClass="ghost-button"/>
                            <Label fx:id="competitionBadgeLabel" text="Competition" styleClass="toolbar-chip"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label text="Lecture seule" styleClass="toolbar-chip-soft"/>
                        </HBox>

                        <HBox spacing="20" alignment="CENTER_LEFT" styleClass="detail-header-shell">
                            <StackPane styleClass="detail-logo-shell">
                                <ImageView fx:id="detailLogoView"
                                           fitHeight="180"
                                           fitWidth="180"
                                           managed="false"
                                           preserveRatio="true"
                                           visible="false"/>
                                <Label fx:id="detailLogoFallbackLabel" text="SI" styleClass="detail-logo-fallback"/>
                            </StackPane>

                            <VBox spacing="10" HBox.hgrow="ALWAYS">
                                <Label fx:id="detailTitleLabel" text="Equipe" styleClass="detail-title"/>
                                <Label fx:id="detailSubtitleLabel"
                                       text="Competition | Coach"
                                       wrapText="true"
                                       styleClass="detail-subtitle"/>

                                <HBox spacing="10">
                                    <VBox HBox.hgrow="ALWAYS" styleClass="stat-chip">
                                        <Label text="Fiche" styleClass="stat-caption"/>
                                        <Label fx:id="detailIdValueLabel" text="Equipe" styleClass="stat-value"/>
                                    </VBox>
                                    <VBox HBox.hgrow="ALWAYS" styleClass="stat-chip">
                                        <Label text="Coach" styleClass="stat-caption"/>
                                        <Label fx:id="detailCoachValueLabel" text="-" styleClass="stat-value"/>
                                    </VBox>
                                    <VBox HBox.hgrow="ALWAYS" styleClass="stat-chip">
                                        <Label text="Joueurs" styleClass="stat-caption"/>
                                        <Label fx:id="detailPlayerCountValueLabel" text="0" styleClass="stat-value"/>
                                    </VBox>
                                </HBox>
                            </VBox>
                        </HBox>
                    </VBox>

                    <HBox spacing="18" styleClass="content-shell">
                        <VBox spacing="16" styleClass="panel-card" HBox.hgrow="ALWAYS">
                            <Label text="Informations du club" styleClass="section-title"/>

                            <VBox spacing="12" styleClass="detail-info-card">
                                <HBox spacing="16" alignment="CENTER_LEFT">
                                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                                        <Label text="Competition" styleClass="field-label"/>
                                        <Label fx:id="detailCompetitionValueLabel" text="-" styleClass="info-value-label"/>
                                    </VBox>
                                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                                        <Label text="Source" styleClass="field-label"/>
                                        <Label fx:id="detailSourceValueLabel" text="-" styleClass="info-value-label"/>
                                    </VBox>
                                </HBox>

                                <VBox spacing="4">
                                    <Label text="Adresse" styleClass="field-label"/>
                                    <Label fx:id="detailAddressValueLabel" text="-" wrapText="true" styleClass="info-value-label"/>
                                </VBox>

                                <HBox spacing="16" alignment="CENTER_LEFT">
                                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                                        <Label text="Telephone" styleClass="field-label"/>
                                        <Label fx:id="detailPhoneValueLabel" text="-" styleClass="info-value-label"/>
                                    </VBox>
                                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                                        <Label text="Email" styleClass="field-label"/>
                                        <Label fx:id="detailEmailValueLabel" text="-" wrapText="true" styleClass="info-value-label"/>
                                    </VBox>
                                </HBox>
                            </VBox>
                        </VBox>

                        <VBox spacing="16" styleClass="panel-card" HBox.hgrow="ALWAYS">
                            <HBox spacing="10" alignment="CENTER_LEFT">
                                <Label text="Effectif" styleClass="section-title"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Button fx:id="squadToggleButton"
                                        onAction="#handleToggleSquadExpanded"
                                        text="Afficher"
                                        managed="false"
                                        visible="false"
                                        styleClass="ghost-button team-squad-toggle-button"/>
                            </HBox>

                            <Label fx:id="squadEmptyLabel"
                                   text="Aucun joueur rattache a cette equipe pour le moment."
                                   wrapText="true"
                                   styleClass="section-subtitle"/>

                            <FlowPane fx:id="squadContainer"
                                      hgap="10"
                                      vgap="10"
                                      prefWrapLength="540"/>
                        </VBox>
                    </HBox>

                    <HBox spacing="18" styleClass="content-shell team-form-row">
                        <VBox spacing="14" styleClass="panel-card" HBox.hgrow="ALWAYS">
                            <HBox spacing="10" alignment="CENTER_LEFT">
                                <VBox spacing="4">
                                    <Label text="Prochains matchs" styleClass="section-title"/>
                                    <Label text="Les 5 prochains rendez-vous de cette equipe."
                                           styleClass="section-subtitle"/>
                                </VBox>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label text="Next 5" styleClass="toolbar-chip-soft"/>
                            </HBox>

                            <Label fx:id="nextMatchesEmptyLabel"
                                   text="Aucun prochain match programme pour cette equipe."
                                   wrapText="true"
                                   styleClass="section-subtitle"/>

                            <VBox fx:id="nextMatchesContainer" spacing="10"/>
                        </VBox>

                        <VBox spacing="14" styleClass="panel-card" HBox.hgrow="ALWAYS">
                            <HBox spacing="10" alignment="CENTER_LEFT">
                                <VBox spacing="4">
                                    <Label text="5 derniers resultats" styleClass="section-title"/>
                                    <Label text="Vert: victoire, jaune: nul, rouge: defaite."
                                           styleClass="section-subtitle"/>
                                </VBox>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label text="Last 5" styleClass="toolbar-chip-soft"/>
                            </HBox>

                            <Label fx:id="recentResultsEmptyLabel"
                                   text="Aucun resultat recent disponible pour cette equipe."
                                   wrapText="true"
                                   styleClass="section-subtitle"/>

                            <VBox fx:id="recentResultsContainer" spacing="10"/>
                        </VBox>
                    </HBox>

                    <VBox spacing="14" styleClass="panel-card">
                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <VBox spacing="4">
                                <Label text="Meilleurs buteurs" styleClass="section-title"/>
                                <Label text="Classement offensif de l'equipe charge depuis API-Football."
                                       styleClass="section-subtitle"/>
                            </VBox>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label fx:id="topScorersStatusLabel" text="En attente" styleClass="status-pill status-muted"/>
                        </HBox>

                        <Label fx:id="topScorersEmptyLabel"
                               text="Aucun meilleur buteur disponible pour cette equipe."
                               wrapText="true"
                               styleClass="section-subtitle"/>

                        <VBox fx:id="topScorersContainer" spacing="10"/>
                    </VBox>
                </VBox>
                </StackPane>
            </content>
        </ScrollPane>
    </center>
</BorderPane>


