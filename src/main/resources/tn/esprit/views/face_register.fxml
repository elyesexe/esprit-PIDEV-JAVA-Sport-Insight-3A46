<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="tn.esprit.Controller.FaceRegisterController"
           styleClass="page-root auth-page-root auth-feature-root">
    <stylesheets>
        <URL value="@../styles/auth-theme.css"/>
    </stylesheets>

    <Region styleClass="auth-scene-backdrop"/>

    <VBox alignment="CENTER" spacing="14" maxWidth="580" styleClass="auth-feature-card auth-face-card">
        <VBox alignment="CENTER" spacing="6" styleClass="auth-feature-heading">
            <Label text="Register face" styleClass="auth-form-title"/>
            <Label text="Capture 20 samples. Move your head slowly for best accuracy."
                   wrapText="true"
                   textAlignment="CENTER"
                   styleClass="auth-form-copy"/>
        </VBox>

        <StackPane maxWidth="480" maxHeight="360" styleClass="auth-camera-frame">
            <ImageView fx:id="cameraPreview"
                       fitWidth="480"
                       fitHeight="360"
                       preserveRatio="true"/>
        </StackPane>

        <Label fx:id="instructionLabel"
               text="Press Start, then slowly move your head"
               wrapText="true"
               textAlignment="CENTER"
               styleClass="auth-form-copy"/>

        <HBox alignment="CENTER" spacing="10" styleClass="auth-inline-row">
            <Label text="Samples" styleClass="auth-label"/>
            <Label fx:id="sampleCountLabel" text="0 / 20" styleClass="auth-count-label"/>
        </HBox>

        <ProgressBar fx:id="sampleBar"
                     prefWidth="480"
                     prefHeight="8"
                     progress="0"
                     styleClass="auth-progress"/>

        <Label fx:id="statusLabel"
               text="Ready"
               wrapText="true"
               textAlignment="CENTER"
               styleClass="auth-status-label status-muted"/>

        <ProgressIndicator fx:id="trainingSpinner"
                           prefWidth="30"
                           prefHeight="30"
                           styleClass="auth-spinner"/>

        <HBox alignment="CENTER" spacing="12" styleClass="auth-actions">
            <Button fx:id="startBtn"
                    text="Start capture"
                    onAction="#onStart"
                    styleClass="auth-primary-button"/>
            <Button fx:id="cancelBtn"
                    text="Cancel"
                    onAction="#onCancel"
                    styleClass="auth-ghost-button"/>
        </HBox>
    </VBox>
</StackPane>
