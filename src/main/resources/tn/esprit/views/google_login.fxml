<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="tn.esprit.Controller.GoogleLoginController"
           styleClass="page-root auth-page-root auth-feature-root">
    <Region styleClass="auth-scene-backdrop"/>

    <BorderPane styleClass="auth-layout">
        <top>
            <HBox alignment="CENTER_LEFT" spacing="16" styleClass="auth-topbar" BorderPane.alignment="CENTER">
                <padding>
                    <Insets top="14" right="24" bottom="8" left="24"/>
                </padding>
                <StackPane styleClass="auth-logo-shell">
                    <ImageView fitWidth="156" fitHeight="52" preserveRatio="true" smooth="true">
                        <image>
                            <Image url="@../images/sport-insight-logo.png"/>
                        </image>
                    </ImageView>
                </StackPane>
                <Region HBox.hgrow="ALWAYS"/>
            </HBox>
        </top>

        <center>
            <StackPane styleClass="auth-feature-center">
                <VBox alignment="CENTER" spacing="18" maxWidth="440" styleClass="auth-feature-card auth-google-card">
                    <VBox alignment="CENTER" spacing="6" styleClass="auth-feature-heading">
                        <Label text="Google login" styleClass="auth-form-title"/>
                        <Label text="A browser window will open. Sign in, then return here."
                               wrapText="true"
                               textAlignment="CENTER"
                               styleClass="auth-form-copy"/>
                    </VBox>

                    <HBox alignment="CENTER" spacing="10" maxWidth="330" styleClass="auth-google-pill">
                        <Label text="G" styleClass="auth-google-mark"/>
                        <Label text="Connecting with Google..." styleClass="auth-google-text"/>
                    </HBox>

                    <ProgressIndicator fx:id="spinner"
                                       prefWidth="40"
                                       prefHeight="40"
                                       styleClass="auth-spinner"/>

                    <Label fx:id="statusLabel"
                           text="Opening browser..."
                           wrapText="true"
                           textAlignment="CENTER"
                           styleClass="auth-status-label status-muted"/>

                    <Button fx:id="retryBtn"
                            text="Try again"
                            onAction="#onRetry"
                            visible="false"
                            maxWidth="330"
                            styleClass="auth-primary-button"/>

                    <Button fx:id="cancelBtn"
                            text="Cancel"
                            onAction="#onCancel"
                            maxWidth="330"
                            styleClass="auth-ghost-button"/>
                </VBox>
            </StackPane>
        </center>
    </BorderPane>
</StackPane>
