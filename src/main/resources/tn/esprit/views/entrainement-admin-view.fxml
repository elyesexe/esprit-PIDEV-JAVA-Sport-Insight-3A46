<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.esprit.Controller.EntrainementAdminController"
            stylesheets="@../styles/entrainement-theme.css"
            styleClass="page-root">

    <top>
        <HBox fx:id="navbarRoot"
              alignment="CENTER_LEFT"
              spacing="16"
              styleClass="navbar-root"
              BorderPane.alignment="CENTER">
            <padding>
                <Insets top="10" right="20" bottom="10" left="20"/>
            </padding>

            <Button fx:id="adminNavButton"
                    onAction="#handleOpenAdmin"
                    text="Admin"
                    mnemonicParsing="false"
                    styleClass="navbar-admin-button"/>

            <HBox fx:id="sidebarBrandBox"
                  alignment="CENTER_LEFT"
                  spacing="10"
                  styleClass="navbar-brand"
                  onMouseClicked="#handleOpenHome">
                <StackPane styleClass="navbar-logo-shell">
                    <ImageView fitWidth="152" fitHeight="50" preserveRatio="true" smooth="true">
                        <image>
                            <Image url="@../images/sport-insight-logo.png"/>
                        </image>
                    </ImageView>
                </StackPane>
            </HBox>

            <Region HBox.hgrow="ALWAYS"/>

            <HBox alignment="CENTER_RIGHT" styleClass="navbar-theme-wrap">
                <ToggleButton fx:id="themeToggleButton"
                              mnemonicParsing="false"
                              contentDisplay="GRAPHIC_ONLY"
                              styleClass="theme-toggle">
                    <graphic>
                        <StackPane styleClass="theme-toggle-track">
                            <StackPane styleClass="theme-toggle-thumb">
                                <StackPane styleClass="theme-toggle-icon-shell">
                                    <Label text="&#9728;" styleClass="theme-toggle-icon theme-toggle-sun"/>
                                    <Label text="&#9790;" styleClass="theme-toggle-icon theme-toggle-moon"/>
                                </StackPane>
                            </StackPane>
                        </StackPane>
                    </graphic>
                </ToggleButton>
            </HBox>
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="page-scroll">
            <content>
                <VBox spacing="20" styleClass="page-shell" maxWidth="1280">
                    <padding>
                        <Insets top="18" right="18" bottom="28" left="18"/>
                    </padding>

                    <VBox spacing="10" styleClass="panel-card">
                        <Label text="Moderation entrainement, evaluation et participation" styleClass="section-title"/>
                        <Label text="Toutes les options CRUD sont accessibles depuis ce dashboard."
                               styleClass="section-subtitle"/>
                    </VBox>

                    <TabPane tabClosingPolicy="UNAVAILABLE">
                        <tabs>
                            <Tab text="Entrainements">
                                <content>
                                    <HBox spacing="18">
                                        <VBox spacing="12" HBox.hgrow="ALWAYS" styleClass="panel-card">
                                            <HBox spacing="10" styleClass="toolbar-row">
                                                <TextField fx:id="searchField" promptText="Rechercher par type, lieu, objectif"
                                                           styleClass="search-field" HBox.hgrow="ALWAYS"/>
                                                <ComboBox fx:id="sortChoiceBox" prefWidth="160" promptText="Trier par" styleClass="form-combo"/>
                                                <Button onAction="#handleRefresh" text="Actualiser" styleClass="ghost-button"/>
                                            </HBox>

                                            <TableView fx:id="tableView" styleClass="data-table">
                                                <columns>
                                                    <TableColumn fx:id="dateColumn" text="Date"/>
                                                    <TableColumn fx:id="typeColumn" text="Type"/>
                                                    <TableColumn fx:id="lieuColumn" text="Lieu"/>
                                                    <TableColumn fx:id="horaireColumn" text="Horaire"/>
                                                    <TableColumn fx:id="coachColumn" text="Coach"/>
                                                </columns>
                                            </TableView>
                                        </VBox>

                                        <VBox spacing="12" prefWidth="360" styleClass="panel-card">
                                            <Label text="Creer / Modifier" styleClass="section-title"/>
                                            <Label fx:id="formHintLabel" text="Selectionnez une ligne ou saisissez une nouvelle session."
                                                   styleClass="section-subtitle"/>

                                            <DatePicker fx:id="dateField" promptText="Date" styleClass="form-date-picker"/>
                                            <TextField fx:id="startField" promptText="Heure debut (HH:mm)" styleClass="form-field"/>
                                            <TextField fx:id="endField" promptText="Heure fin (HH:mm)" styleClass="form-field"/>
                                            <TextField fx:id="typeField" promptText="Type" styleClass="form-field"/>
                                            <TextField fx:id="objectifField" promptText="Objectif" styleClass="form-field"/>
                                            <TextField fx:id="lieuField" promptText="Lieu" styleClass="form-field"/>
                                            <ComboBox fx:id="coachField" promptText="Coach" styleClass="form-combo"/>

                                            <Label fx:id="validationLabel" text="" styleClass="section-subtitle" visible="false" managed="false"/>

                                            <HBox spacing="10">
                                                <Button onAction="#handleAdd" text="Ajouter" styleClass="primary-button"/>
                                                <Button onAction="#handleUpdate" text="Modifier" styleClass="ghost-button"/>
                                                <Button onAction="#handleDelete" text="Supprimer" styleClass="danger-button"/>
                                            </HBox>
                                            <Button onAction="#handleClear" text="Reinitialiser" styleClass="ghost-button"/>
                                        </VBox>
                                    </HBox>
                                </content>
                            </Tab>

                            <Tab text="Evaluations">
                                <content>
                                    <HBox spacing="18">
                                        <VBox spacing="12" HBox.hgrow="ALWAYS" styleClass="panel-card">
                                            <HBox spacing="10" styleClass="toolbar-row">
                                                <TextField fx:id="evaluationSearchField" promptText="Rechercher dans les commentaires"
                                                           styleClass="search-field" HBox.hgrow="ALWAYS"/>
                                                <ComboBox fx:id="evaluationSortBox" prefWidth="160" promptText="Trier par" styleClass="form-combo"/>
                                                <Button onAction="#handleRefreshEvaluations" text="Actualiser" styleClass="ghost-button"/>
                                            </HBox>
                                            <TableView fx:id="evaluationTableView" styleClass="data-table">
                                                <columns>
                                                    <TableColumn fx:id="evaluationEntrColumn" text="Entrainement"/>
                                                    <TableColumn fx:id="evaluationPlayerColumn" text="Joueur"/>
                                                    <TableColumn fx:id="evaluationScoreColumn" text="Scores"/>
                                                    <TableColumn fx:id="evaluationAvgColumn" text="Moyenne"/>
                                                </columns>
                                            </TableView>
                                        </VBox>

                                        <VBox spacing="12" prefWidth="360" styleClass="panel-card">
                                            <Label text="Creer / Modifier" styleClass="section-title"/>
                                            <Label fx:id="evaluationHintLabel" text="Selectionnez une evaluation ou creez-en une."
                                                   styleClass="section-subtitle"/>
                                            <ComboBox fx:id="evaluationTrainingField" promptText="Entrainement" styleClass="form-combo"/>
                                            <ComboBox fx:id="evaluationPlayerField" promptText="Joueur" styleClass="form-combo"/>
                                            <TextField fx:id="evaluationPhysField" promptText="Note physique" styleClass="form-field"/>
                                            <TextField fx:id="evaluationTechField" promptText="Note technique" styleClass="form-field"/>
                                            <TextField fx:id="evaluationTactField" promptText="Note tactique" styleClass="form-field"/>
                                            <TextField fx:id="evaluationCommentField" promptText="Commentaire" styleClass="form-field"/>
                                            <Label fx:id="evaluationValidationLabel" text="" styleClass="section-subtitle" visible="false" managed="false"/>
                                            <HBox spacing="10">
                                                <Button onAction="#handleAddEvaluation" text="Ajouter" styleClass="primary-button"/>
                                                <Button onAction="#handleUpdateEvaluation" text="Modifier" styleClass="ghost-button"/>
                                                <Button onAction="#handleDeleteEvaluation" text="Supprimer" styleClass="danger-button"/>
                                            </HBox>
                                            <Button onAction="#handleClearEvaluation" text="Reinitialiser" styleClass="ghost-button"/>
                                        </VBox>
                                    </HBox>
                                </content>
                            </Tab>

                            <Tab text="Participations">
                                <content>
                                    <HBox spacing="18">
                                        <VBox spacing="12" HBox.hgrow="ALWAYS" styleClass="panel-card">
                                            <HBox spacing="10" styleClass="toolbar-row">
                                                <TextField fx:id="participationSearchField" promptText="Rechercher par presence"
                                                           styleClass="search-field" HBox.hgrow="ALWAYS"/>
                                                <ComboBox fx:id="participationSortBox" prefWidth="160" promptText="Trier par" styleClass="form-combo"/>
                                                <Button onAction="#handleRefreshParticipations" text="Actualiser" styleClass="ghost-button"/>
                                            </HBox>
                                            <TableView fx:id="participationTableView" styleClass="data-table">
                                                <columns>
                                                    <TableColumn fx:id="participationEntrColumn" text="Entrainement"/>
                                                    <TableColumn fx:id="participationPlayerColumn" text="Joueur"/>
                                                    <TableColumn fx:id="participationPresenceColumn" text="Presence"/>
                                                    <TableColumn fx:id="participationJustifColumn" text="Justification"/>
                                                </columns>
                                            </TableView>
                                        </VBox>

                                        <VBox spacing="12" prefWidth="360" styleClass="panel-card">
                                            <Label text="Creer / Modifier" styleClass="section-title"/>
                                            <Label fx:id="participationHintLabel" text="Selectionnez une participation ou creez-en une."
                                                   styleClass="section-subtitle"/>
                                            <ComboBox fx:id="participationTrainingField" promptText="Entrainement" styleClass="form-combo"/>
                                            <ComboBox fx:id="participationPlayerField" promptText="Joueur" styleClass="form-combo"/>
                                            <ComboBox fx:id="participationPresenceFormField" promptText="Present / Absent" styleClass="form-combo"/>
                                            <TextField fx:id="participationJustifField" promptText="Justification" styleClass="form-field"/>
                                            <Label fx:id="participationValidationLabel" text="" styleClass="section-subtitle" visible="false" managed="false"/>
                                            <HBox spacing="10">
                                                <Button onAction="#handleAddParticipation" text="Ajouter" styleClass="primary-button"/>
                                                <Button onAction="#handleUpdateParticipation" text="Modifier" styleClass="ghost-button"/>
                                                <Button onAction="#handleDeleteParticipation" text="Supprimer" styleClass="danger-button"/>
                                            </HBox>
                                            <Button onAction="#handleClearParticipation" text="Reinitialiser" styleClass="ghost-button"/>
                                        </VBox>
                                    </HBox>
                                </content>
                            </Tab>
                        </tabs>
                    </TabPane>
                </VBox>
            </content>
        </ScrollPane>
    </center>

</BorderPane>
