<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.esprit.Controller.LeagueTableController"
            styleClass="page-root">
    <top>
        <HBox fx:id="navbarRoot" alignment="CENTER_LEFT" spacing="16" styleClass="navbar-root" BorderPane.alignment="CENTER">
            <padding>
                <Insets top="10" right="20" bottom="10" left="20"/>
            </padding>

            <Button fx:id="adminNavButton"
                    onAction="#handleOpenAdmin"
                    text="Admin"
                    mnemonicParsing="false"
                    styleClass="navbar-admin-button"/>

            <HBox fx:id="sidebarBrandBox" alignment="CENTER_LEFT" spacing="10" styleClass="navbar-brand" onMouseClicked="#handleOpenHome">
                <StackPane styleClass="navbar-logo-shell">
                    <ImageView fitWidth="152" fitHeight="50" preserveRatio="true" smooth="true">
                        <image>
                            <Image url="@../images/sport-insight-logo.png"/>
                        </image>
                    </ImageView>
                </StackPane>
            </HBox>

            <StackPane HBox.hgrow="ALWAYS" styleClass="navbar-center-wrap">
                <HBox alignment="CENTER" spacing="9" styleClass="navbar-modules">
                    <Button fx:id="matchsNavButton"
                            onAction="#handleOpenMatchs"
                            text="Matchs"
                            styleClass="navbar-nav-button"/>
                    <HBox fx:id="sidebarModuleChildrenBox"
                          spacing="8"
                          alignment="CENTER"
                          managed="false"
                          visible="false"
                          styleClass="navbar-submenu">
                        <Button fx:id="equipesNavButton"
                                onAction="#handleOpenEquipes"
                                text="Equipes"
                                styleClass="navbar-nav-button navbar-submenu-button"/>
                        <Button fx:id="leaguesNavButton"
                                onAction="#handleOpenLeagues"
                                text="Leagues"
                                styleClass="navbar-nav-button navbar-submenu-button"/>
                        <Button fx:id="joueursNavButton"
                                onAction="#handleOpenJoueurs"
                                text="Joueurs"
                                styleClass="navbar-nav-button navbar-submenu-button"/>
                    </HBox>
                    <Button fx:id="annonceNavButton"
                            onAction="#handleOpenAnnonces"
                            text="Anonce"
                            styleClass="navbar-nav-button"/>
                </HBox>
            </StackPane>

            <HBox alignment="CENTER_RIGHT" styleClass="navbar-theme-wrap">
                <ToggleButton fx:id="themeToggleButton"
                              mnemonicParsing="false"
                              contentDisplay="GRAPHIC_ONLY"
                              styleClass="theme-toggle">
                    <graphic>
                        <StackPane styleClass="theme-toggle-track">
                            <StackPane styleClass="theme-toggle-thumb">
                                <StackPane styleClass="theme-toggle-icon-shell">
                                    <Label text="☀" styleClass="theme-toggle-icon theme-toggle-sun"/>
                                    <Label text="☾" styleClass="theme-toggle-icon theme-toggle-moon"/>
                                </StackPane>
                            </StackPane>
                        </StackPane>
                    </graphic>
                </ToggleButton>
            </HBox>
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true"
                    hbarPolicy="NEVER"
                    pannable="true"
                    styleClass="page-scroll"
                    BorderPane.alignment="CENTER">
            <content>
                <StackPane styleClass="page-shell-wrap">
                <VBox spacing="18" styleClass="page-shell">
                    <padding>
                        <Insets top="24" right="28" bottom="28" left="28"/>
                    </padding>

                    <StackPane styleClass="hero-shell">
                        <StackPane styleClass="league-table-hero-photo"/>
                        <StackPane styleClass="hero-overlay"/>
                        <VBox spacing="14" styleClass="hero-content">
                            <Label fx:id="competitionChipLabel" text="League" styleClass="hero-eyebrow"/>
                            <Label fx:id="pageTitleLabel" text="League Table" styleClass="hero-title"/>
                            <Label fx:id="pageSubtitleLabel"
                                   text="Classement officiel en direct charge depuis football-data.org."
                                   wrapText="true"
                                   styleClass="hero-text"/>
                            <HBox spacing="10">
                                <Label fx:id="clubCountChipLabel" text="0 clubs" styleClass="toolbar-chip"/>
                                <Label fx:id="matchdayChipLabel" text="Journée --" styleClass="toolbar-chip-soft"/>
                                <Label fx:id="seasonChipLabel" text="Saison --" styleClass="toolbar-chip-soft"/>
                            </HBox>
                        </VBox>
                    </StackPane>

                    <HBox alignment="CENTER_LEFT" spacing="12">
                        <Button onAction="#handleBack"
                                text="Competitions"
                                styleClass="ghost-button"/>
                        <Label fx:id="statusLabel" text="Pret" styleClass="status-pill status-muted"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button fx:id="refreshButton"
                                onAction="#handleRefresh"
                                text="Actualiser"
                                styleClass="primary-button"/>
                    </HBox>

                    <VBox spacing="16" styleClass="panel-card standings-panel-card">
                        <VBox spacing="4">
                            <Label text="Classement" styleClass="section-title"/>
                            <Label fx:id="sectionSubtitleLabel"
                                   text="Position, matchs joues, bilan, buts, difference et points."
                                   styleClass="section-subtitle"/>
                        </VBox>

                        <GridPane fx:id="standingsHeaderGrid" hgap="12" styleClass="standings-header-grid"/>

                        <ListView fx:id="standingsListView"
                                  prefHeight="720"
                                  VBox.vgrow="ALWAYS"
                                  styleClass="standings-list-view"/>

                        <VBox fx:id="emptyStateBox"
                              alignment="CENTER"
                              managed="false"
                              visible="false"
                              spacing="10"
                              styleClass="empty-state-box">
                            <Label text="LT" styleClass="empty-icon"/>
                            <Label text="Aucun classement disponible" styleClass="empty-title"/>
                            <Label text="Verifiez la connexion a football-data.org ou relancez l'actualisation."
                                   wrapText="true"
                                   styleClass="empty-text"/>
                        </VBox>
                    </VBox>

                    <VBox spacing="14" styleClass="panel-card standings-panel-card">
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <VBox spacing="4">
                                <Label text="Meilleurs buteurs" styleClass="section-title"/>
                                <Label text="Classement offensif charge depuis API-Football."
                                       styleClass="section-subtitle"/>
                            </VBox>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label fx:id="scorersStatusLabel" text="En attente" styleClass="status-pill status-muted"/>
                        </HBox>

                        <Label fx:id="scorersEmptyLabel"
                               text="Aucun classement des buteurs disponible pour cette competition."
                               wrapText="true"
                               styleClass="section-subtitle"/>

                        <VBox fx:id="scorersContainer" spacing="10"/>
                    </VBox>
                </VBox>
                </StackPane>
            </content>
        </ScrollPane>
    </center>
</BorderPane>


