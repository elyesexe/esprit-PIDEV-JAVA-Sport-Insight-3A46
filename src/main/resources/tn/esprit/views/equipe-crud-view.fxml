<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.esprit.Controller.EquipeController"
            styleClass="page-root">
    <top>
        <HBox fx:id="navbarRoot" alignment="CENTER_LEFT" spacing="16" styleClass="navbar-root" BorderPane.alignment="CENTER">
            <padding>
                <Insets top="10" right="20" bottom="10" left="20"/>
            </padding>

            <Button fx:id="adminNavButton"
                    onAction="#handleOpenAdmin"
                    text="Admin"
                    mnemonicParsing="false"
                    styleClass="navbar-admin-button"/>

            <HBox fx:id="sidebarBrandBox" alignment="CENTER_LEFT" spacing="10" styleClass="navbar-brand" onMouseClicked="#handleOpenHome">
                <StackPane styleClass="navbar-logo-shell">
                    <ImageView fitWidth="152" fitHeight="50" preserveRatio="true" smooth="true">
                        <image>
                            <Image url="@../images/sport-insight-logo.png"/>
                        </image>
                    </ImageView>
                </StackPane>
            </HBox>

            <StackPane HBox.hgrow="ALWAYS" styleClass="navbar-center-wrap">
                <HBox alignment="CENTER" spacing="9" styleClass="navbar-modules">
                    <Button fx:id="matchsNavButton"
                            onAction="#handleOpenMatchsSoon"
                            text="Matchs"
                            styleClass="navbar-nav-button"/>
                    <HBox fx:id="sidebarModuleChildrenBox"
                          spacing="8"
                          alignment="CENTER"
                          managed="false"
                          visible="false"
                          styleClass="navbar-submenu">
                        <Button fx:id="equipesNavButton"
                                onAction="#handleOpenEquipes"
                                text="Equipes"
                                styleClass="navbar-nav-button navbar-submenu-button"/>
                        <Button fx:id="leaguesNavButton"
                                onAction="#handleOpenLeagues"
                                text="Leagues"
                                styleClass="navbar-nav-button navbar-submenu-button"/>
                        <Button fx:id="joueursNavButton"
                                onAction="#handleOpenJoueursSoon"
                                text="Joueurs"
                                styleClass="navbar-nav-button navbar-submenu-button"/>
                    </HBox>
                    <Button fx:id="annonceNavButton"
                            onAction="#handleOpenAnnonces"
                            text="Anonce"
                            styleClass="navbar-nav-button"/>
                </HBox>
            </StackPane>

            <HBox alignment="CENTER_RIGHT" styleClass="navbar-theme-wrap">
                <ToggleButton fx:id="themeToggleButton"
                              mnemonicParsing="false"
                              contentDisplay="GRAPHIC_ONLY"
                              styleClass="theme-toggle">
                    <graphic>
                        <StackPane styleClass="theme-toggle-track">
                            <StackPane styleClass="theme-toggle-thumb">
                                <StackPane styleClass="theme-toggle-icon-shell">
                                    <Label text="&#9728;" styleClass="theme-toggle-icon theme-toggle-sun"/>
                                    <Label text="&#9790;" styleClass="theme-toggle-icon theme-toggle-moon"/>
                                </StackPane>
                            </StackPane>
                        </StackPane>
                    </graphic>
                </ToggleButton>
            </HBox>
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true"
                    hbarPolicy="NEVER"
                    pannable="true"
                    styleClass="page-scroll"
                    BorderPane.alignment="CENTER">
            <content>
                <StackPane styleClass="page-shell-wrap">
                <VBox spacing="18" styleClass="page-shell">
                    <padding>
                        <Insets top="24" right="28" bottom="28" left="28"/>
                    </padding>

                    <VBox spacing="14" styleClass="panel-card toolbar-panel">
                        <HBox alignment="CENTER_LEFT" spacing="12">
                            <VBox spacing="4" HBox.hgrow="ALWAYS">
                                <Label text="Statistiques equipe" styleClass="section-title"/>
                                <Label text="Ecrivez le nom d'une equipe pour afficher son taux de victoire, nul et defaite."
                                       wrapText="true"
                                       styleClass="section-subtitle"/>
                            </VBox>
                        </HBox>

                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <TextField fx:id="statsTeamField"
                                       promptText="Nom de l'equipe"
                                       styleClass="form-text-field"
                                       HBox.hgrow="ALWAYS"/>
                            <Button onAction="#handleShowTeamStats"
                                    text="Afficher"
                                    styleClass="primary-button"/>
                        </HBox>

                        <Label fx:id="teamStatsSummaryLabel"
                               text="Ecrivez le nom d'une equipe pour voir ses statistiques."
                               wrapText="true"
                               styleClass="section-subtitle"/>

                        <BarChart fx:id="teamRateChart"
                                  animated="false"
                                  categoryGap="18"
                                  legendVisible="false"
                                  prefHeight="260"
                                  styleClass="module-stats-chart">
                            <xAxis>
                                <CategoryAxis side="BOTTOM"/>
                            </xAxis>
                            <yAxis>
                                <NumberAxis autoRanging="false" lowerBound="0.0" upperBound="100.0" tickUnit="20.0" side="LEFT"/>
                            </yAxis>
                        </BarChart>
                    </VBox>

                    <VBox spacing="16" styleClass="panel-card toolbar-panel">
                        <HBox spacing="16" alignment="CENTER_LEFT">
                            <VBox spacing="4" HBox.hgrow="ALWAYS">
                                <Label text="Equipe admin" styleClass="section-title"/>
                                <Label text="Gestion des equipes, recherche rapide, edition et suppression depuis une vue de type back-office."
                                       wrapText="true"
                                       styleClass="section-subtitle"/>
                            </VBox>
                            <Label fx:id="statusLabel"
                                   text="Pret"
                                   managed="false"
                                   visible="false"
                                   styleClass="status-pill"/>
                        </HBox>

                        <HBox spacing="12" alignment="CENTER_LEFT">
                            <VBox spacing="4" styleClass="toolbar-summary-card">
                                <Label text="Enregistrements" styleClass="toolbar-summary-caption"/>
                                <Label fx:id="resultCountLabel" text="0 equipe(s)" styleClass="toolbar-summary-value"/>
                            </VBox>
                            <VBox spacing="4" styleClass="toolbar-summary-card">
                                <Label text="Etat courant" styleClass="toolbar-summary-caption"/>
                                <Label fx:id="selectionStateLabel" text="Mode creation" styleClass="toolbar-summary-value"/>
                            </VBox>
                        </HBox>

                        <VBox spacing="6">
                            <Label text="Competition" styleClass="field-label"/>
                            <HBox fx:id="competitionFilterBar" spacing="8" alignment="CENTER_LEFT" styleClass="competition-filter-bar"/>
                        </VBox>

                        <HBox spacing="12" alignment="CENTER_LEFT">
                            <VBox spacing="6" HBox.hgrow="ALWAYS">
                                <Label text="Recherche" styleClass="field-label"/>
                                <TextField fx:id="searchField"
                                           promptText="Rechercher par nom ou coach"
                                           styleClass="form-text-field"/>
                            </VBox>

                            <VBox spacing="6">
                                <Label text="Tri" styleClass="field-label"/>
                                <ComboBox fx:id="sortChoiceBox" prefWidth="150" styleClass="glass-combo"/>
                            </VBox>

                            <VBox spacing="6">
                                <Label text="Ordre" styleClass="field-label"/>
                                <Button fx:id="sortOrderButton"
                                        onAction="#handleToggleSortOrder"
                                        text="Croissant"
                                        prefWidth="132"
                                        styleClass="ghost-button"/>
                            </VBox>

                            <VBox spacing="6">
                                <Label text="Actions" styleClass="field-label"/>
                                <HBox spacing="10">
                                    <Button onAction="#handleExportExcel"
                                            text="Excel"
                                            styleClass="soft-button"/>
                                    <Button fx:id="refreshButton"
                                            onAction="#handleRefresh"
                                            text="Actualiser"
                                            styleClass="primary-button"/>
                                    <Button onAction="#handleResetFilters"
                                            text="Reinitialiser"
                                            styleClass="ghost-button"/>
                                </HBox>
                            </VBox>
                        </HBox>
                    </VBox>

                    <HBox spacing="18" styleClass="content-shell">
                        <VBox spacing="14" styleClass="panel-card results-panel admin-table-panel" HBox.hgrow="ALWAYS">
                            <HBox spacing="12" alignment="CENTER_LEFT">
                                <VBox spacing="4" HBox.hgrow="ALWAYS">
                                    <Label text="Table des equipes" styleClass="section-title"/>
                                    <Label text="Selectionnez une ligne pour alimenter la fiche detail et le formulaire d'edition."
                                           wrapText="true"
                                           styleClass="section-subtitle"/>
                                </VBox>
                                <Label fx:id="resultsMetaLabel" text="0 ligne(s)" styleClass="toolbar-chip-soft"/>
                            </HBox>

                            <StackPane VBox.vgrow="ALWAYS">
                                <TableView fx:id="equipeTableView"
                                           prefHeight="540"
                                           styleClass="data-table">
                                    <columns>
                                        <TableColumn fx:id="idColumn" text="ID" prefWidth="80"/>
                                        <TableColumn fx:id="nomColumn" text="Equipe" prefWidth="230"/>
                                        <TableColumn fx:id="coachColumn" text="Coach" prefWidth="210"/>
                                        <TableColumn fx:id="competitionColumn" text="Competition" prefWidth="160"/>
                                        <TableColumn fx:id="sourceColumn" text="Source" prefWidth="140"/>
                                        <TableColumn fx:id="logoColumn" text="Logo" prefWidth="100"/>
                                    </columns>
                                </TableView>

                                <VBox fx:id="emptyStateBox"
                                      alignment="CENTER"
                                      managed="false"
                                      maxWidth="340"
                                      spacing="12"
                                      visible="false"
                                      styleClass="empty-state-box">
                                    <Label text="+" styleClass="empty-icon"/>
                                    <Label text="Aucune equipe trouvee" styleClass="empty-title"/>
                                    <Label text="Essayez un autre filtre ou rechargez la liste pour retrouver les fiches en base."
                                           wrapText="true"
                                           styleClass="empty-text"/>
                                </VBox>
                            </StackPane>
                        </VBox>

                        <VBox spacing="18" minWidth="390" prefWidth="430" maxWidth="450" styleClass="side-column">
                            <VBox spacing="16" styleClass="panel-card detail-card">
                                <HBox alignment="CENTER_LEFT" spacing="10">
                                    <Label fx:id="detailBadgeLabel" text="Apercu" styleClass="toolbar-chip"/>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Button onAction="#handleClear" text="Nouvelle fiche" styleClass="ghost-button"/>
                                </HBox>

                                <StackPane styleClass="detail-logo-shell">
                                    <ImageView fx:id="detailLogoView"
                                               fitHeight="170"
                                               fitWidth="170"
                                               managed="false"
                                               preserveRatio="true"
                                               visible="false"/>
                                    <Label fx:id="detailLogoFallbackLabel" text="SI" styleClass="detail-logo-fallback"/>
                                </StackPane>

                                <VBox spacing="6">
                                    <Label fx:id="detailNameLabel" text="Aucune equipe selectionnee" styleClass="detail-title"/>
                                    <Label fx:id="detailSubtitleLabel"
                                           text="Selectionnez une ligne du tableau ou creez une nouvelle fiche pour afficher le detail."
                                           wrapText="true"
                                           styleClass="detail-subtitle"/>
                                </VBox>

                                <HBox spacing="10">
                                    <VBox HBox.hgrow="ALWAYS" styleClass="stat-chip">
                                        <Label text="ID" styleClass="stat-caption"/>
                                        <Label fx:id="detailIdValueLabel" text="Nouveau" styleClass="stat-value"/>
                                    </VBox>

                                    <VBox HBox.hgrow="ALWAYS" styleClass="stat-chip">
                                        <Label text="Coach" styleClass="stat-caption"/>
                                        <Label fx:id="detailCoachValueLabel" text="Non renseigne" styleClass="stat-value"/>
                                    </VBox>

                                    <VBox HBox.hgrow="ALWAYS" styleClass="stat-chip">
                                        <Label text="Logo" styleClass="stat-caption"/>
                                        <Label fx:id="detailStatusValueLabel" text="Sans logo" styleClass="stat-value"/>
                                    </VBox>
                                </HBox>
                            </VBox>

                            <VBox spacing="16" styleClass="panel-card form-card">
                                <VBox spacing="4">
                                    <Label text="Formulaire equipe" styleClass="section-title admin-form-section-title"/>
                                    <Label fx:id="formHintLabel"
                                           text="Renseignez les champs ci-dessous pour creer une nouvelle fiche equipe."
                                           wrapText="true"
                                           styleClass="section-subtitle"/>
                                </VBox>

                                <Label fx:id="validationLabel"
                                       managed="false"
                                       visible="false"
                                       wrapText="true"
                                       styleClass="validation-label"/>

                                <VBox spacing="8">
                                    <Label text="Nom de l'equipe" styleClass="field-label"/>
                                    <TextField fx:id="nomField"
                                               promptText="Ex: Real Madrid"
                                               styleClass="form-text-field"/>
                                </VBox>

                                <VBox spacing="8">
                                    <Label text="Coach" styleClass="field-label"/>
                                    <TextField fx:id="coachField"
                                               promptText="Ex: Carlo Ancelotti"
                                               styleClass="form-text-field"/>
                                </VBox>

                                <VBox spacing="8">
                                    <Label text="Logo" styleClass="field-label"/>
                                    <HBox spacing="10" alignment="CENTER_LEFT">
                                        <TextField fx:id="imageField"
                                                   editable="false"
                                                   promptText="Choisissez un logo"
                                                   styleClass="form-text-field"
                                                   HBox.hgrow="ALWAYS"/>
                                        <Button onAction="#handleBrowseImage"
                                                text="Parcourir..."
                                                styleClass="ghost-button"/>
                                    </HBox>
                                    <Label text="Le logo alimente l'aperu detail et la fiche equipe."
                                           wrapText="true"
                                           styleClass="form-helper"/>
                                </VBox>

                                <HBox spacing="10">
                                    <Button fx:id="addButton"
                                            onAction="#handleAdd"
                                            text="Ajouter"
                                            styleClass="primary-button"
                                            HBox.hgrow="ALWAYS"/>
                                    <Button fx:id="updateButton"
                                            onAction="#handleUpdate"
                                            text="Modifier"
                                            styleClass="ghost-button"
                                            HBox.hgrow="ALWAYS"/>
                                </HBox>

                                <HBox spacing="10">
                                    <Button fx:id="deleteButton"
                                            onAction="#handleDelete"
                                            text="Supprimer"
                                            styleClass="danger-button"
                                            HBox.hgrow="ALWAYS"/>
                                    <Button fx:id="clearButton"
                                            onAction="#handleClear"
                                            text="Vider"
                                            styleClass="soft-button"
                                            HBox.hgrow="ALWAYS"/>
                                </HBox>
                            </VBox>
                        </VBox>
                    </HBox>
                </VBox>
                </StackPane>
            </content>
        </ScrollPane>
    </center>
</BorderPane>


