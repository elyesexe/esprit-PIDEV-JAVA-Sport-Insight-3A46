<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.esprit.Controller.JoueurDetailController"
            styleClass="page-root">
    <top>
        <HBox fx:id="navbarRoot" alignment="CENTER_LEFT" spacing="16" styleClass="navbar-root" BorderPane.alignment="CENTER">
            <padding>
                <Insets top="10" right="20" bottom="10" left="20"/>
            </padding>

            <Button fx:id="adminNavButton"
                    onAction="#handleOpenAdmin"
                    text="Admin"
                    mnemonicParsing="false"
                    styleClass="navbar-admin-button"/>

            <HBox fx:id="sidebarBrandBox" alignment="CENTER_LEFT" spacing="10" styleClass="navbar-brand" onMouseClicked="#handleOpenHome">
                <StackPane styleClass="navbar-logo-shell">
                    <ImageView fitWidth="152" fitHeight="50" preserveRatio="true" smooth="true">
                        <image>
                            <Image url="@../images/sport-insight-logo.png"/>
                        </image>
                    </ImageView>
                </StackPane>
            </HBox>

            <StackPane HBox.hgrow="ALWAYS" styleClass="navbar-center-wrap">
                <HBox alignment="CENTER" spacing="9" styleClass="navbar-modules">
                    <Button fx:id="matchsNavButton"
                            onAction="#handleOpenMatchs"
                            text="Matchs"
                            styleClass="navbar-nav-button"/>
                    <HBox fx:id="sidebarModuleChildrenBox"
                          spacing="8"
                          alignment="CENTER"
                          managed="false"
                          visible="false"
                          styleClass="navbar-submenu">
                        <Button fx:id="equipesNavButton"
                                onAction="#handleOpenEquipes"
                                text="Equipes"
                                styleClass="navbar-nav-button navbar-submenu-button"/>
                        <Button fx:id="leaguesNavButton"
                                onAction="#handleOpenLeagues"
                                text="Leagues"
                                styleClass="navbar-nav-button navbar-submenu-button"/>
                        <Button fx:id="joueursNavButton"
                                onAction="#handleOpenJoueurs"
                                text="Joueurs"
                                styleClass="navbar-nav-button navbar-submenu-button"/>
                    </HBox>
                    <Button fx:id="annonceNavButton"
                            onAction="#handleOpenAnnonces"
                            text="Anonce"
                            styleClass="navbar-nav-button"/>
                </HBox>
            </StackPane>

            <HBox alignment="CENTER_RIGHT" styleClass="navbar-theme-wrap">
                <ToggleButton fx:id="themeToggleButton"
                              mnemonicParsing="false"
                              contentDisplay="GRAPHIC_ONLY"
                              styleClass="theme-toggle">
                    <graphic>
                        <StackPane styleClass="theme-toggle-track">
                            <StackPane styleClass="theme-toggle-thumb">
                                <StackPane styleClass="theme-toggle-icon-shell">
                                    <Label text="&#9728;" styleClass="theme-toggle-icon theme-toggle-sun"/>
                                    <Label text="&#9790;" styleClass="theme-toggle-icon theme-toggle-moon"/>
                                </StackPane>
                            </StackPane>
                        </StackPane>
                    </graphic>
                </ToggleButton>
            </HBox>
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true"
                    hbarPolicy="NEVER"
                    pannable="true"
                    styleClass="page-scroll"
                    BorderPane.alignment="CENTER">
            <content>
                <StackPane styleClass="page-shell-wrap">
                <VBox spacing="18" styleClass="page-shell">
                    <padding>
                        <Insets top="24" right="28" bottom="28" left="28"/>
                    </padding>

                    <VBox spacing="16" styleClass="panel-card detail-page-shell">
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <Button onAction="#handleBack"
                                    text="Retour"
                                    styleClass="ghost-button"/>
                            <Label text="Fiche joueur" styleClass="toolbar-chip"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label fx:id="detailSourceValueLabel" text="Manuel" styleClass="toolbar-chip-soft"/>
                        </HBox>

                        <HBox spacing="20" alignment="CENTER_LEFT" styleClass="detail-header-shell">
                            <StackPane styleClass="player-detail-photo-shell">
                                <ImageView fx:id="detailImageView"
                                           fitHeight="190"
                                           fitWidth="190"
                                           managed="false"
                                           preserveRatio="true"
                                           visible="false"/>
                                <Label fx:id="detailImageFallbackLabel" text="J" styleClass="player-detail-photo-fallback"/>
                            </StackPane>

                            <VBox spacing="10" HBox.hgrow="ALWAYS">
                                <Label fx:id="detailNameLabel" text="Joueur" styleClass="detail-title"/>
                                <Label fx:id="detailSubtitleLabel"
                                       text="Equipe | Date de naissance | Poste | Nationalite"
                                       wrapText="true"
                                       styleClass="detail-subtitle"/>

                                <HBox spacing="10">
                                    <VBox HBox.hgrow="ALWAYS" styleClass="stat-chip">
                                        <Label text="Fiche" styleClass="stat-caption"/>
                                        <Label fx:id="detailIdValueLabel" text="Joueur" styleClass="stat-value"/>
                                    </VBox>
                                    <VBox HBox.hgrow="ALWAYS" styleClass="stat-chip">
                                        <Label text="Equipe" styleClass="stat-caption"/>
                                        <Label fx:id="detailEquipeValueLabel" text="Sans equipe" styleClass="stat-value"/>
                                    </VBox>
                                    <VBox HBox.hgrow="ALWAYS" styleClass="stat-chip">
                                        <Label text="Numero" styleClass="stat-caption"/>
                                        <Label fx:id="detailNumeroValueLabel" text="Non defini" styleClass="stat-value"/>
                                    </VBox>
                                </HBox>
                            </VBox>
                        </HBox>
                    </VBox>

                    <VBox spacing="16" styleClass="panel-card" HBox.hgrow="ALWAYS">
                        <Label text="Informations du joueur" styleClass="section-title"/>

                        <VBox spacing="12" styleClass="detail-info-card">
                            <HBox spacing="16" alignment="CENTER_LEFT">
                                <VBox spacing="4" HBox.hgrow="ALWAYS">
                                    <Label text="Date de naissance" styleClass="field-label"/>
                                    <Label fx:id="detailDateNaissanceValueLabel" text="Non renseignee" styleClass="info-value-label"/>
                                </VBox>
                                <VBox spacing="4" HBox.hgrow="ALWAYS">
                                    <Label text="Age" styleClass="field-label"/>
                                    <Label fx:id="detailAgeValueLabel" text="Age indisponible" styleClass="info-value-label"/>
                                </VBox>
                            </HBox>

                            <HBox spacing="16" alignment="CENTER_LEFT">
                                <VBox spacing="4" HBox.hgrow="ALWAYS">
                                    <Label text="Position" styleClass="field-label"/>
                                    <Label fx:id="detailPositionValueLabel" text="Non renseigne" styleClass="info-value-label"/>
                                </VBox>
                                <VBox spacing="4" HBox.hgrow="ALWAYS">
                                    <Label text="Nationalite" styleClass="field-label"/>
                                    <Label fx:id="detailNationaliteValueLabel" text="Non renseignee" styleClass="info-value-label"/>
                                </VBox>
                            </HBox>
                        </VBox>
                    </VBox>

                    <VBox spacing="16" styleClass="panel-card">
                        <HBox spacing="12" alignment="CENTER_LEFT">
                            <VBox spacing="4" HBox.hgrow="ALWAYS">
                                <Label text="Statistiques de saison" styleClass="section-title"/>
                                <Label text="Matchs joues, buts, passes et cartons selon les donnees disponibles."
                                       wrapText="true"
                                       styleClass="section-subtitle"/>
                            </VBox>
                            <Label fx:id="detailStatsStatusLabel" text="Chargement..." styleClass="toolbar-chip-soft status-muted"/>
                        </HBox>

                        <HBox spacing="10">
                            <VBox HBox.hgrow="ALWAYS" styleClass="stat-chip">
                                <Label text="Matchs" styleClass="stat-caption"/>
                                <Label fx:id="detailAppearancesValueLabel" text="-" styleClass="stat-value"/>
                            </VBox>
                            <VBox HBox.hgrow="ALWAYS" styleClass="stat-chip">
                                <Label text="Buts" styleClass="stat-caption"/>
                                <Label fx:id="detailGoalsValueLabel" text="-" styleClass="stat-value"/>
                            </VBox>
                            <VBox HBox.hgrow="ALWAYS" styleClass="stat-chip">
                                <Label text="Assists" styleClass="stat-caption"/>
                                <Label fx:id="detailAssistsValueLabel" text="-" styleClass="stat-value"/>
                            </VBox>
                            <VBox HBox.hgrow="ALWAYS" styleClass="stat-chip">
                                <Label text="Jaunes" styleClass="stat-caption"/>
                                <Label fx:id="detailYellowCardsValueLabel" text="-" styleClass="stat-value"/>
                            </VBox>
                            <VBox HBox.hgrow="ALWAYS" styleClass="stat-chip">
                                <Label text="Rouges" styleClass="stat-caption"/>
                                <Label fx:id="detailRedCardsValueLabel" text="-" styleClass="stat-value"/>
                            </VBox>
                            <VBox HBox.hgrow="ALWAYS" styleClass="stat-chip">
                                <Label text="Minutes" styleClass="stat-caption"/>
                                <Label fx:id="detailMinutesValueLabel" text="-" styleClass="stat-value"/>
                            </VBox>
                        </HBox>
                    </VBox>
                </VBox>
                </StackPane>
            </content>
        </ScrollPane>
    </center>
</BorderPane>


