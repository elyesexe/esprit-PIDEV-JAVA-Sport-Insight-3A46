<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.esprit.Controller.EquipeFormController"
            styleClass="page-root">
    <top>
        <HBox fx:id="navbarRoot" alignment="CENTER_LEFT" spacing="16" styleClass="navbar-root" BorderPane.alignment="CENTER">
            <padding>
                <Insets top="10" right="20" bottom="10" left="20"/>
            </padding>

            <Button fx:id="adminNavButton"
                    onAction="#handleOpenAdmin"
                    text="Admin"
                    mnemonicParsing="false"
                    styleClass="navbar-admin-button"/>

            <HBox fx:id="sidebarBrandBox" alignment="CENTER_LEFT" spacing="10" styleClass="navbar-brand" onMouseClicked="#handleOpenHome">
                <StackPane styleClass="navbar-logo-shell">
                    <ImageView fitWidth="152" fitHeight="50" preserveRatio="true" smooth="true">
                        <image>
                            <Image url="@../images/sport-insight-logo.png"/>
                        </image>
                    </ImageView>
                </StackPane>
            </HBox>

            <StackPane HBox.hgrow="ALWAYS" styleClass="navbar-center-wrap">
                <HBox alignment="CENTER" spacing="9" styleClass="navbar-modules">
                    <Button fx:id="matchsNavButton"
                            onAction="#handleOpenMatchs"
                            text="Matchs"
                            styleClass="navbar-nav-button"/>
                    <HBox fx:id="sidebarModuleChildrenBox"
                          spacing="8"
                          alignment="CENTER"
                          managed="false"
                          visible="false"
                          styleClass="navbar-submenu">
                        <Button fx:id="equipesNavButton"
                                onAction="#handleOpenEquipes"
                                text="Equipes"
                                styleClass="navbar-nav-button navbar-submenu-button"/>
                        <Button fx:id="leaguesNavButton"
                                onAction="#handleOpenLeagues"
                                text="Leagues"
                                styleClass="navbar-nav-button navbar-submenu-button"/>
                        <Button fx:id="joueursNavButton"
                                onAction="#handleOpenJoueurs"
                                text="Joueurs"
                                styleClass="navbar-nav-button navbar-submenu-button"/>
                    </HBox>
                    <Button fx:id="annonceNavButton"
                            onAction="#handleOpenAnnonces"
                            text="Anonce"
                            styleClass="navbar-nav-button"/>
                </HBox>
            </StackPane>

            <HBox alignment="CENTER_RIGHT" styleClass="navbar-theme-wrap">
                <ToggleButton fx:id="themeToggleButton"
                              mnemonicParsing="false"
                              contentDisplay="GRAPHIC_ONLY"
                              styleClass="theme-toggle">
                    <graphic>
                        <StackPane styleClass="theme-toggle-track">
                            <StackPane styleClass="theme-toggle-thumb">
                                <StackPane styleClass="theme-toggle-icon-shell">
                                    <Label text="☀" styleClass="theme-toggle-icon theme-toggle-sun"/>
                                    <Label text="☾" styleClass="theme-toggle-icon theme-toggle-moon"/>
                                </StackPane>
                            </StackPane>
                        </StackPane>
                    </graphic>
                </ToggleButton>
            </HBox>
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true"
                    hbarPolicy="NEVER"
                    pannable="true"
                    styleClass="page-scroll"
                    BorderPane.alignment="CENTER">
            <content>
                <StackPane styleClass="page-shell-wrap">
                <VBox spacing="18" styleClass="page-shell">
                    <padding>
                        <Insets top="24" right="28" bottom="28" left="28"/>
                    </padding>

                    <VBox spacing="16" styleClass="panel-card form-page-shell">
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <Label fx:id="formModeChipLabel" text="Ajout" styleClass="toolbar-chip"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button onAction="#handleCancel"
                                    text="Annuler"
                                    styleClass="ghost-button"/>
                            <Button fx:id="saveButton"
                                    onAction="#handleSave"
                                    text="Ajouter"
                                    styleClass="primary-button"/>
                        </HBox>

                        <VBox spacing="6">
                            <Label fx:id="pageTitleLabel" text="Ajouter une equipe" styleClass="section-title"/>
                            <Label fx:id="pageSubtitleLabel"
                                   text="Renseignez le formulaire pour creer un club dans l'une des 5 competitions."
                                   wrapText="true"
                                   styleClass="section-subtitle"/>
                        </VBox>

                        <Label fx:id="validationLabel"
                               managed="false"
                               visible="false"
                               wrapText="true"
                               styleClass="validation-label"/>

                        <VBox spacing="14">
                            <HBox spacing="14">
                                <VBox spacing="8" HBox.hgrow="ALWAYS">
                                    <Label text="Competition" styleClass="field-label"/>
                                    <ComboBox fx:id="competitionComboBox"
                                              promptText="Selectionnez une competition"
                                              styleClass="glass-combo"/>
                                </VBox>
                                <VBox spacing="8" HBox.hgrow="ALWAYS">
                                    <Label text="Nom de l'equipe" styleClass="field-label"/>
                                    <TextField fx:id="nomField"
                                               promptText="Ex: Liverpool"
                                               styleClass="form-text-field"/>
                                </VBox>
                            </HBox>

                            <HBox spacing="14">
                                <VBox spacing="8" HBox.hgrow="ALWAYS">
                                    <Label text="Coach" styleClass="field-label"/>
                                    <TextField fx:id="coachField"
                                               promptText="Ex: Arne Slot"
                                               styleClass="form-text-field"/>
                                </VBox>
                                <VBox spacing="8" HBox.hgrow="ALWAYS">
                                    <Label text="Telephone" styleClass="field-label"/>
                                    <TextField fx:id="telephoneField"
                                               promptText="Ex: +44 20 0000 0000"
                                               styleClass="form-text-field"/>
                                </VBox>
                            </HBox>

                            <VBox spacing="8">
                                <Label text="Adresse" styleClass="field-label"/>
                                <TextField fx:id="addressField"
                                           promptText="Ex: Anfield Road, Liverpool"
                                           styleClass="form-text-field"/>
                            </VBox>

                            <VBox spacing="8">
                                <Label text="Email" styleClass="field-label"/>
                                <TextField fx:id="emailField"
                                           promptText="Ex: contact@club.com"
                                           styleClass="form-text-field"/>
                            </VBox>

                            <VBox spacing="8">
                                <Label text="Logo" styleClass="field-label"/>
                                <HBox spacing="10" alignment="CENTER_LEFT">
                                    <TextField fx:id="imageField"
                                               editable="false"
                                               promptText="Choisissez un logo"
                                               styleClass="form-text-field"
                                               HBox.hgrow="ALWAYS"/>
                                    <Button onAction="#handleBrowseImage"
                                            text="Parcourir..."
                                            styleClass="ghost-button"/>
                                </HBox>
                                <Label text="Le logo sera affiche sur la carte, la liste et la fiche detail."
                                       wrapText="true"
                                       styleClass="form-helper"/>
                            </VBox>
                        </VBox>
                    </VBox>
                </VBox>
                </StackPane>
            </content>
        </ScrollPane>
    </center>
</BorderPane>


