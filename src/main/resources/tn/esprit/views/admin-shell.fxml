<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<BorderPane fx:id="adminRoot"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.esprit.Controller.AdminShellController"
            styleClass="page-root admin-page-root admin-shell-root">
    <left>
        <ScrollPane fx:id="adminSidebarScroll"
                    fitToWidth="true"
                    hbarPolicy="NEVER"
                    vbarPolicy="AS_NEEDED"
                    pannable="true"
                    prefWidth="286"
                    minWidth="286"
                    maxWidth="286"
                    styleClass="admin-sidebar-scroll"
                    BorderPane.alignment="TOP_LEFT">
            <content>
                <VBox fx:id="adminSidebarRoot" spacing="10" styleClass="admin-sidebar">
                    <padding>
                        <Insets top="24" right="18" bottom="24" left="18"/>
                    </padding>

                    <HBox alignment="CENTER_LEFT" spacing="12" styleClass="admin-sidebar-header">
                        <Label fx:id="adminSidebarTitleLabel" text="%admin.shell.title" styleClass="admin-sidebar-title"/>
                        <Region fx:id="sidebarHeaderSpacer" HBox.hgrow="ALWAYS"/>
                        <Button fx:id="sidebarToggleButton"
                                onAction="#handleToggleSidebar"
                                mnemonicParsing="false"
                                text="‹"
                                styleClass="admin-sidebar-toggle-button"/>
                    </HBox>

                    <Button fx:id="dashboardNavButton"
                            onAction="#handleDashboard"
                            maxWidth="Infinity"
                            styleClass="admin-nav-button">
                        <graphic>
                            <HBox alignment="CENTER_LEFT" spacing="10" styleClass="admin-nav-graphic">
                                <StackPane styleClass="admin-nav-icon-shell">
                                    <SVGPath content="M8.707 1.5a1 1 0 0 0-1.414 0L.646 8.146a.5.5 0 0 0 .708.708L2 8.207V13.5A1.5 1.5 0 0 0 3.5 15h9a1.5 1.5 0 0 0 1.5-1.5V8.207l.646.647a.5.5 0 0 0 .708-.708L13 5.793V2.5a.5.5 0 0 0-.5-.5h-1a.5.5 0 0 0-.5.5v1.293zM13 7.207V13.5a.5.5 0 0 1-.5.5h-9a.5.5 0 0 1-.5-.5V7.207l5-5z"
                                             styleClass="admin-nav-icon-svg"/>
                                </StackPane>
                                <Label text="%admin.shell.dashboard" styleClass="admin-nav-text"/>
                            </HBox>
                        </graphic>
                    </Button>

            <Label text="%admin.shell.data" styleClass="admin-sidebar-section"/>

            <Button fx:id="equipesNavButton"
                    onAction="#handleEquipes"
                    maxWidth="Infinity"
                    styleClass="admin-nav-button">
                <graphic>
                    <HBox alignment="CENTER_LEFT" spacing="10" styleClass="admin-nav-graphic">
                        <StackPane styleClass="admin-nav-icon-shell">
                            <SVGPath content="M15 14s1 0 1-1-1-4-5-4-5 3-5 4 1 1 1 1zm-7.978-1L7 12.996c.001-.264.167-1.03.76-1.72C8.312 10.629 9.282 10 11 10c1.717 0 2.687.63 3.24 1.276.593.69.758 1.457.76 1.72l-.008.002-.014.002zM11 7a2 2 0 1 0 0-4 2 2 0 0 0 0 4m3-2a3 3 0 1 1-6 0 3 3 0 0 1 6 0M6.936 9.28a6 6 0 0 0-1.23-.247A7 7 0 0 0 5 9c-4 0-5 3-5 4q0 1 1 1h4.216A2.24 2.24 0 0 1 5 13c0-1.01.377-2.042 1.09-2.904.243-.294.526-.569.846-.816M4.92 10A5.5 5.5 0 0 0 4 13H1c0-.26.164-1.03.76-1.724.545-.636 1.492-1.256 3.16-1.275ZM1.5 5.5a3 3 0 1 1 6 0 3 3 0 0 1-6 0m3-2a2 2 0 1 0 0 4 2 2 0 0 0 0-4"
                                     styleClass="admin-nav-icon-svg"/>
                        </StackPane>
                        <Label text="%nav.teams" styleClass="admin-nav-text"/>
                    </HBox>
                </graphic>
            </Button>

            <Button fx:id="joueursNavButton"
                    onAction="#handleJoueurs"
                    maxWidth="Infinity"
                    styleClass="admin-nav-button">
                <graphic>
                    <HBox alignment="CENTER_LEFT" spacing="10" styleClass="admin-nav-graphic">
                        <StackPane styleClass="admin-nav-icon-shell">
                            <SVGPath content="M11 6a3 3 0 1 1-6 0 3 3 0 0 1 6 0" styleClass="admin-nav-icon-svg"/>
                            <SVGPath content="M0 8a8 8 0 1 1 16 0A8 8 0 0 1 0 8m8-7a7 7 0 0 0-5.468 11.37C3.242 11.226 4.805 10 8 10s4.757 1.225 5.468 2.37A7 7 0 0 0 8 1" styleClass="admin-nav-icon-svg"/>
                        </StackPane>
                        <Label text="%nav.players" styleClass="admin-nav-text"/>
                    </HBox>
                </graphic>
            </Button>

            <Button fx:id="matchsNavButton"
                    onAction="#handleMatchs"
                    maxWidth="Infinity"
                    styleClass="admin-nav-button">
                <graphic>
                    <HBox alignment="CENTER_LEFT" spacing="10" styleClass="admin-nav-graphic">
                        <StackPane styleClass="admin-nav-icon-shell">
                            <SVGPath content="M8.515 1.019A7 7 0 0 0 8 1V0a8 8 0 0 1 .589.022zm2.004.45a7 7 0 0 0-.985-.299l.219-.976q.576.129 1.126.342zm1.37.71a7 7 0 0 0-.439-.27l.493-.87a8 8 0 0 1 .979.654l-.615.789a7 7 0 0 0-.418-.302zm1.834 1.79a7 7 0 0 0-.653-.796l.724-.69q.406.429.747.91zm.744 1.352a7 7 0 0 0-.214-.468l.893-.45a8 8 0 0 1 .45 1.088l-.95.313a7 7 0 0 0-.179-.483m.53 2.507a7 7 0 0 0-.1-1.025l.985-.17q.1.58.116 1.17zm-.131 1.538q.05-.254.081-.51l.993.123a8 8 0 0 1-.23 1.155l-.964-.267q.069-.247.12-.501m-.952 2.379q.276-.436.486-.908l.914.405q-.24.54-.555 1.038zm-.964 1.205q.183-.183.35-.378l.758.653a8 8 0 0 1-.401.432z"
                                     styleClass="admin-nav-icon-svg"/>
                            <SVGPath content="M8 1a7 7 0 1 0 4.95 11.95l.707.707A8.001 8.001 0 1 1 8 0z" styleClass="admin-nav-icon-svg"/>
                            <SVGPath content="M7.5 3a.5.5 0 0 1 .5.5v5.21l3.248 1.856a.5.5 0 0 1-.496.868l-3.5-2A.5.5 0 0 1 7 9V3.5a.5.5 0 0 1 .5-.5" styleClass="admin-nav-icon-svg"/>
                        </StackPane>
                        <Label text="%nav.matches" styleClass="admin-nav-text"/>
                    </HBox>
                </graphic>
            </Button>

            <Button fx:id="annoncesNavButton"
                    onAction="#handleAnnonces"
                    maxWidth="Infinity"
                    styleClass="admin-nav-button">
                <graphic>
                    <HBox alignment="CENTER_LEFT" spacing="10" styleClass="admin-nav-graphic">
                        <StackPane styleClass="admin-nav-icon-shell">
                            <SVGPath content="M13 2.5a1.5 1.5 0 0 1 3 0v11a1.5 1.5 0 0 1-3 0v-.214c-2.162-1.241-4.49-1.843-6.912-2.083l.405 2.712A1 1 0 0 1 5.51 15.1h-.548a1 1 0 0 1-.916-.599l-1.85-3.49-.202-.003A2.014 2.014 0 0 1 0 9V7a2.02 2.02 0 0 1 1.992-2.013 75 75 0 0 0 2.483-.075c3.043-.154 6.148-.849 8.525-2.199zm1 0v11a.5.5 0 0 0 1 0v-11a.5.5 0 0 0-1 0m-1 1.35c-2.344 1.205-5.209 1.842-8 2.033v4.233q.27.015.537.036c2.568.189 5.093.744 7.463 1.993zm-9 6.215v-4.13a95 95 0 0 1-1.992.052A1.02 1.02 0 0 0 1 7v2c0 .55.448 1.002 1.006 1.009A61 61 0 0 1 4 10.065m-.657.975 1.609 3.037.01.024h.548l-.002-.014-.443-2.966a68 68 0 0 0-1.722-.082z"
                                     styleClass="admin-nav-icon-svg"/>
                        </StackPane>
                        <Label text="%nav.announcements" styleClass="admin-nav-text"/>
                    </HBox>
                </graphic>
            </Button>

            <Button fx:id="productsNavButton"
                    onAction="#handleProducts"
                    maxWidth="Infinity"
                    styleClass="admin-nav-button">
                <graphic>
                    <HBox alignment="CENTER_LEFT" spacing="10" styleClass="admin-nav-graphic">
                        <StackPane styleClass="admin-nav-icon-shell">
                            <SVGPath content="M8.186 1.113a.5.5 0 0 0-.372 0L1.846 3.5l2.404.961L10.404 2zm3.564 1.426L5.596 5 8 5.961 14.154 3.5zm3.25 1.7-6.5 2.6v7.922l6.5-2.6V4.24zM7.5 14.762V6.838L1 4.239v7.923zM7.443.184a1.5 1.5 0 0 1 1.114 0l7.129 2.852A.5.5 0 0 1 16 3.5v8.662a1 1 0 0 1-.629.928l-7.185 2.874a.5.5 0 0 1-.372 0L.63 13.09a1 1 0 0 1-.63-.928V3.5a.5.5 0 0 1 .314-.464z"
                                     styleClass="admin-nav-icon-svg"/>
                        </StackPane>
                        <Label text="%admin.shell.products" styleClass="admin-nav-text"/>
                    </HBox>
                </graphic>
            </Button>

            <Button fx:id="ordersNavButton"
                    onAction="#handleOrders"
                    maxWidth="Infinity"
                    styleClass="admin-nav-button">
                <graphic>
                    <HBox alignment="CENTER_LEFT" spacing="10" styleClass="admin-nav-graphic">
                        <StackPane styleClass="admin-nav-icon-shell">
                            <SVGPath content="M1.92.506a.5.5 0 0 1 .434.14L3 1.293l.646-.647a.5.5 0 0 1 .708 0L5 1.293l.646-.647a.5.5 0 0 1 .708 0L7 1.293l.646-.647a.5.5 0 0 1 .708 0L9 1.293l.646-.647a.5.5 0 0 1 .708 0l.646.647.646-.647a.5.5 0 0 1 .708 0l.646.647.646-.647a.5.5 0 0 1 .801.13l.5 1A.5.5 0 0 1 15 2v12a.5.5 0 0 1-.053.224l-.5 1a.5.5 0 0 1-.8.13L13 14.707l-.646.647a.5.5 0 0 1-.708 0L11 14.707l-.646.647a.5.5 0 0 1-.708 0L9 14.707l-.646.647a.5.5 0 0 1-.708 0L7 14.707l-.646.647a.5.5 0 0 1-.708 0L5 14.707l-.646.647a.5.5 0 0 1-.708 0L3 14.707l-.646.647a.5.5 0 0 1-.801-.13l-.5-1A.5.5 0 0 1 1 14V2a.5.5 0 0 1 .053-.224l.5-1a.5.5 0 0 1 .367-.27m.217 1.338L2 2.118v11.764l.137.274.51-.51a.5.5 0 0 1 .707 0l.646.647.646-.646a.5.5 0 0 1 .708 0l.646.646.646-.646a.5.5 0 0 1 .708 0l.646.646.646-.646a.5.5 0 0 1 .708 0l.646.646.646-.646a.5.5 0 0 1 .708 0l.509.509.137-.274V2.118l-.137-.274-.51.51a.5.5 0 0 1-.707 0L12 1.707l-.646.647a.5.5 0 0 1-.708 0L10 1.707l-.646.647a.5.5 0 0 1-.708 0L8 1.707l-.646.647a.5.5 0 0 1-.708 0L6 1.707l-.646.647a.5.5 0 0 1-.708 0L4 1.707l-.646.647a.5.5 0 0 1-.708 0z"
                                     styleClass="admin-nav-icon-svg"/>
                            <SVGPath content="M3 4.5a.5.5 0 0 1 .5-.5h6a.5.5 0 1 1 0 1h-6a.5.5 0 0 1-.5-.5m0 2a.5.5 0 0 1 .5-.5h6a.5.5 0 1 1 0 1h-6a.5.5 0 0 1-.5-.5m0 2a.5.5 0 0 1 .5-.5h6a.5.5 0 1 1 0 1h-6a.5.5 0 0 1-.5-.5m0 2a.5.5 0 0 1 .5-.5h6a.5.5 0 0 1 0 1h-6a.5.5 0 0 1-.5-.5m8-6a.5.5 0 0 1 .5-.5h1a.5.5 0 0 1 0 1h-1a.5.5 0 0 1-.5-.5m0 2a.5.5 0 0 1 .5-.5h1a.5.5 0 0 1 0 1h-1a.5.5 0 0 1-.5-.5m0 2a.5.5 0 0 1 .5-.5h1a.5.5 0 0 1 0 1h-1a.5.5 0 0 1-.5-.5m0 2a.5.5 0 0 1 .5-.5h1a.5.5 0 0 1 0 1h-1a.5.5 0 0 1-.5-.5"
                                     styleClass="admin-nav-icon-svg"/>
                        </StackPane>
                        <Label text="%admin.shell.orders" styleClass="admin-nav-text"/>
                    </HBox>
                </graphic>
            </Button>

            <Button fx:id="entrainementsNavButton"
                    onAction="#handleEntrainements"
                    maxWidth="Infinity"
                    styleClass="admin-nav-button">
                <graphic>
                    <HBox alignment="CENTER_LEFT" spacing="10" styleClass="admin-nav-graphic">
                        <StackPane styleClass="admin-nav-icon-shell">
                            <SVGPath content="M6 2a.5.5 0 0 1 .47.33L10 12.036l1.53-4.208A.5.5 0 0 1 12 7.5h3.5a.5.5 0 0 1 0 1h-3.15l-1.88 5.17a.5.5 0 0 1-.94 0L6 3.964 4.47 8.171A.5.5 0 0 1 4 8.5H.5a.5.5 0 0 1 0-1h3.15l1.88-5.17A.5.5 0 0 1 6 2"
                                     styleClass="admin-nav-icon-svg"/>
                        </StackPane>
                        <Label text="%nav.training" styleClass="admin-nav-text"/>
                    </HBox>
                </graphic>
            </Button>

            <Button fx:id="sponsorsNavButton"
                    onAction="#handleSponsors"
                    maxWidth="Infinity"
                    styleClass="admin-nav-button">
                <graphic>
                    <HBox alignment="CENTER_LEFT" spacing="10" styleClass="admin-nav-graphic">
                        <StackPane styleClass="admin-nav-icon-shell">
                            <SVGPath content="M6.5 1A1.5 1.5 0 0 0 5 2.5V3H1.5A1.5 1.5 0 0 0 0 4.5v8A1.5 1.5 0 0 0 1.5 14h13a1.5 1.5 0 0 0 1.5-1.5v-8A1.5 1.5 0 0 0 14.5 3H11v-.5A1.5 1.5 0 0 0 9.5 1zm0 1h3a.5.5 0 0 1 .5.5V3H6v-.5a.5.5 0 0 1 .5-.5m1.886 6.914L15 7.151V12.5a.5.5 0 0 1-.5.5h-13a.5.5 0 0 1-.5-.5V7.15l6.614 1.764a1.5 1.5 0 0 0 .772 0M1.5 4h13a.5.5 0 0 1 .5.5v1.616L8.129 7.948a.5.5 0 0 1-.258 0L1 6.116V4.5a.5.5 0 0 1 .5-.5"
                                     styleClass="admin-nav-icon-svg"/>
                        </StackPane>
                        <Label text="%nav.sponsors" styleClass="admin-nav-text"/>
                    </HBox>
                </graphic>
            </Button>

            <Button fx:id="usersNavButton"
                    onAction="#handleUsers"
                    maxWidth="Infinity"
                    styleClass="admin-nav-button">
                <graphic>
                    <HBox alignment="CENTER_LEFT" spacing="10" styleClass="admin-nav-graphic">
                        <StackPane styleClass="admin-nav-icon-shell">
                            <SVGPath content="M2.5 12a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5m0-4a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5m0-4a.5.5 0 0 1 .5-.5h10a.5.5 0 0 1 0 1H3a.5.5 0 0 1-.5-.5"
                                     styleClass="admin-nav-icon-svg"/>
                        </StackPane>
                        <Label text="%admin.shell.users" styleClass="admin-nav-text"/>
                    </HBox>
                </graphic>
            </Button>

            <Region VBox.vgrow="ALWAYS"/>

            <Separator styleClass="admin-sidebar-sep"/>

                    <Button fx:id="userUiButton"
                            onAction="#handleOpenUser"
                            maxWidth="Infinity"
                            styleClass="admin-sidebar-user-button">
                        <graphic>
                            <HBox alignment="CENTER_LEFT" spacing="10" styleClass="admin-nav-graphic">
                                <StackPane styleClass="admin-nav-icon-shell">
                                    <SVGPath content="M14.5 1.5a.5.5 0 0 1 .5.5v4.8a2.5 2.5 0 0 1-2.5 2.5H2.707l3.347 3.346a.5.5 0 0 1-.708.708l-4.2-4.2a.5.5 0 0 1 0-.708l4-4a.5.5 0 1 1 .708.708L2.707 8.3H12.5A1.5 1.5 0 0 0 14 6.8V2a.5.5 0 0 1 .5-.5"
                                             styleClass="admin-nav-icon-svg admin-nav-icon-user"/>
                                </StackPane>
                                <Label text="%admin.shell.userUi" styleClass="admin-nav-text admin-nav-text-user"/>
                            </HBox>
                        </graphic>
                    </Button>

                    <HBox alignment="CENTER_LEFT" spacing="10" styleClass="admin-sidebar-theme-row">
                        <Label text="%theme.title" styleClass="admin-sidebar-theme-label"/>
                        <ToggleButton fx:id="themeToggleButton"
                                      mnemonicParsing="false"
                                      contentDisplay="GRAPHIC_ONLY"
                                      styleClass="theme-toggle">
                            <graphic>
                                <StackPane styleClass="theme-toggle-track">
                                    <StackPane styleClass="theme-toggle-thumb">
                                        <StackPane styleClass="theme-toggle-icon-shell">
                                            <Label text="&#9728;" styleClass="theme-toggle-icon theme-toggle-sun"/>
                                            <Label text="&#9790;" styleClass="theme-toggle-icon theme-toggle-moon"/>
                                        </StackPane>
                                    </StackPane>
                                </StackPane>
                            </graphic>
                        </ToggleButton>
                    </HBox>
                </VBox>
            </content>
        </ScrollPane>
    </left>

    <center>
        <StackPane styleClass="admin-content-stage" BorderPane.alignment="CENTER">
            <StackPane fx:id="contentStack" styleClass="admin-content-stack admin-shell-surface"/>
        </StackPane>
    </center>
</BorderPane>
