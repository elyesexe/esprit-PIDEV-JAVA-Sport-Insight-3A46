<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane fx:id="adminRoot"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.esprit.Controller.AdminShellController"
            styleClass="page-root admin-page-root">
    <left>
        <VBox fx:id="adminSidebarRoot" spacing="10" styleClass="admin-sidebar" prefWidth="248" minWidth="220" maxWidth="280" BorderPane.alignment="TOP_LEFT">
            <padding>
                <Insets top="20" right="16" bottom="20" left="16"/>
            </padding>

            <Label text="Administration" styleClass="admin-sidebar-title"/>

            <Button fx:id="dashboardNavButton"
                    onAction="#handleDashboard"
                    text="Dashboard"
                    maxWidth="Infinity"
                    styleClass="admin-nav-button"/>

            <Label text="Gestion des donnees" styleClass="admin-sidebar-section"/>

            <Button fx:id="equipesNavButton"
                    onAction="#handleEquipes"
                    text="Equipes"
                    maxWidth="Infinity"
                    styleClass="admin-nav-button"/>

            <Button fx:id="joueursNavButton"
                    onAction="#handleJoueurs"
                    text="Joueurs"
                    maxWidth="Infinity"
                    styleClass="admin-nav-button"/>

            <Button fx:id="matchsNavButton"
                    onAction="#handleMatchs"
                    text="Matchs"
                    maxWidth="Infinity"
                    styleClass="admin-nav-button"/>

            <Region VBox.vgrow="ALWAYS"/>

            <Separator styleClass="admin-sidebar-sep"/>

            <Button fx:id="userUiButton"
                    onAction="#handleOpenUser"
                    text="User"
                    maxWidth="Infinity"
                    styleClass="admin-sidebar-user-button"/>

            <HBox alignment="CENTER_LEFT" spacing="10" styleClass="admin-sidebar-theme-row">
                <Label text="Theme" styleClass="admin-sidebar-theme-label"/>
                <ToggleButton fx:id="themeToggleButton"
                              mnemonicParsing="false"
                              contentDisplay="GRAPHIC_ONLY"
                              styleClass="theme-toggle">
                    <graphic>
                        <StackPane styleClass="theme-toggle-track">
                            <StackPane styleClass="theme-toggle-thumb">
                                <StackPane styleClass="theme-toggle-icon-shell">
                                    <Label text="&#9728;" styleClass="theme-toggle-icon theme-toggle-sun"/>
                                    <Label text="&#9790;" styleClass="theme-toggle-icon theme-toggle-moon"/>
                                </StackPane>
                            </StackPane>
                        </StackPane>
                    </graphic>
                </ToggleButton>
            </HBox>
        </VBox>
    </left>

    <center>
        <StackPane fx:id="contentStack" styleClass="admin-content-stack" BorderPane.alignment="CENTER"/>
    </center>
</BorderPane>
