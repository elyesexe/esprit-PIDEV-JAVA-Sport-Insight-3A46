<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.esprit.Controller.NotificationCenterController"
            styleClass="page-root">
    <top>
        <HBox fx:id="navbarRoot" alignment="CENTER_LEFT" spacing="16" styleClass="navbar-root" BorderPane.alignment="CENTER">
            <padding>
                <Insets top="10" right="20" bottom="10" left="20"/>
            </padding>

            <Button fx:id="adminNavButton"
                    onAction="#handleOpenAdmin"
                    text="%nav.admin"
                    mnemonicParsing="false"
                    styleClass="navbar-admin-button"/>

            <HBox fx:id="sidebarBrandBox" alignment="CENTER_LEFT" spacing="10" styleClass="navbar-brand" onMouseClicked="#handleOpenHome">
                <StackPane styleClass="navbar-logo-shell">
                    <ImageView fitWidth="152" fitHeight="50" preserveRatio="true" smooth="true">
                        <image>
                            <Image url="@../images/sport-insight-logo.png"/>
                        </image>
                    </ImageView>
                </StackPane>
            </HBox>

            <StackPane HBox.hgrow="ALWAYS" styleClass="navbar-center-wrap">
                <HBox alignment="CENTER" spacing="9" styleClass="navbar-modules">
                    <Button fx:id="matchsNavButton"
                            onAction="#handleOpenMatchs"
                            text="%nav.matches"
                            styleClass="navbar-nav-button"/>
                    <HBox fx:id="sidebarModuleChildrenBox"
                          spacing="8"
                          alignment="CENTER"
                          managed="false"
                          visible="false"
                          styleClass="navbar-submenu">
                        <Button fx:id="equipesNavButton"
                                onAction="#handleOpenEquipes"
                                text="%nav.teams"
                                styleClass="navbar-nav-button navbar-submenu-button"/>
                        <Button fx:id="leaguesNavButton"
                                onAction="#handleOpenLeagues"
                                text="%nav.leagues"
                                styleClass="navbar-nav-button navbar-submenu-button"/>
                        <Button fx:id="joueursNavButton"
                                onAction="#handleOpenJoueurs"
                                text="%nav.players"
                                styleClass="navbar-nav-button navbar-submenu-button"/>
                    </HBox>
                    <Button fx:id="annonceNavButton"
                            onAction="#handleOpenAnnonces"
                            text="%nav.announcements"
                            styleClass="navbar-nav-button"/>
                </HBox>
            </StackPane>

            <HBox alignment="CENTER_RIGHT" styleClass="navbar-theme-wrap">
                <ToggleButton fx:id="themeToggleButton"
                              mnemonicParsing="false"
                              contentDisplay="GRAPHIC_ONLY"
                              styleClass="theme-toggle">
                    <graphic>
                        <StackPane styleClass="theme-toggle-track">
                            <StackPane styleClass="theme-toggle-thumb">
                                <StackPane styleClass="theme-toggle-icon-shell">
                                    <Label text="&#9728;" styleClass="theme-toggle-icon theme-toggle-sun"/>
                                    <Label text="&#9790;" styleClass="theme-toggle-icon theme-toggle-moon"/>
                                </StackPane>
                            </StackPane>
                        </StackPane>
                    </graphic>
                </ToggleButton>
            </HBox>
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true"
                    hbarPolicy="NEVER"
                    pannable="true"
                    styleClass="page-scroll"
                    BorderPane.alignment="CENTER">
            <content>
                <StackPane styleClass="page-shell-wrap">
                    <VBox spacing="18" styleClass="page-shell notification-page-shell">
                        <padding>
                            <Insets top="24" right="28" bottom="28" left="28"/>
                        </padding>

                        <StackPane styleClass="hero-shell notification-hero-shell">
                            <StackPane styleClass="notification-hero-photo"/>
                            <StackPane styleClass="hero-overlay"/>
                            <VBox spacing="14" styleClass="hero-content">
                                <Label text="%notifications.hero.kicker" styleClass="hero-eyebrow"/>
                                <Label text="%notifications.hero.title" styleClass="hero-title"/>
                                <Label text="%notifications.hero.copy"
                                       wrapText="true"
                                       styleClass="hero-text"/>
                                <HBox spacing="10">
                                    <Label fx:id="unreadCountChipLabel" text="%notifications.chip.unread" styleClass="toolbar-chip"/>
                                    <Label fx:id="totalCountChipLabel" text="%notifications.chip.total" styleClass="toolbar-chip-soft"/>
                                </HBox>
                            </VBox>
                        </StackPane>

                        <VBox spacing="16" styleClass="panel-card toolbar-panel">
                            <HBox alignment="CENTER_LEFT" spacing="12">
                                <VBox spacing="4" HBox.hgrow="ALWAYS">
                                    <Label text="%notifications.history.title" styleClass="section-title"/>
                                    <Label text="%notifications.history.copy"
                                           wrapText="true"
                                           styleClass="section-subtitle"/>
                                </VBox>
                                <Label fx:id="statusLabel" text="%common.status.ready" styleClass="status-pill status-muted"/>
                            </HBox>

                            <HBox alignment="CENTER_LEFT" spacing="12">
                                <VBox spacing="6" HBox.hgrow="ALWAYS">
                                    <Label text="%common.field.search" styleClass="field-label"/>
                                    <TextField fx:id="searchField"
                                               promptText="%notifications.search.prompt"
                                               styleClass="form-text-field"/>
                                </VBox>

                                <VBox spacing="6">
                                    <Label text="%common.field.filter" styleClass="field-label"/>
                                    <ComboBox fx:id="filterComboBox" prefWidth="150" styleClass="glass-combo"/>
                                </VBox>

                                <VBox spacing="6">
                                    <Label text="%common.field.actions" styleClass="field-label"/>
                                    <HBox spacing="10">
                                        <Button fx:id="refreshButton"
                                                onAction="#handleRefresh"
                                                text="%common.action.refresh"
                                                styleClass="primary-button"/>
                                        <Button fx:id="markAllReadButton"
                                                onAction="#handleMarkAllRead"
                                                text="%notifications.action.markAllRead"
                                                styleClass="ghost-button"/>
                                    </HBox>
                                </VBox>
                            </HBox>

                            <HBox alignment="CENTER_LEFT" spacing="10">
                                <Label fx:id="resultsMetaLabel" text="%notifications.results.meta" styleClass="toolbar-chip-soft"/>
                            </HBox>
                        </VBox>

                        <VBox spacing="14" styleClass="panel-card results-panel">
                            <HBox alignment="CENTER_LEFT" spacing="12">
                                <VBox spacing="4" HBox.hgrow="ALWAYS">
                                    <Label text="%notifications.saved.title" styleClass="section-title"/>
                                    <Label text="%notifications.saved.copy"
                                           wrapText="true"
                                           styleClass="section-subtitle"/>
                                </VBox>
                            </HBox>

                            <StackPane VBox.vgrow="ALWAYS">
                                <ListView fx:id="notificationListView" styleClass="notification-list-view"/>

                                <VBox fx:id="emptyStateBox"
                                      alignment="CENTER"
                                      managed="false"
                                      maxWidth="360"
                                      spacing="12"
                                      visible="false"
                                      styleClass="empty-state-box">
                                    <Label text="!" styleClass="empty-icon"/>
                                    <Label text="%notifications.empty.title" styleClass="empty-title"/>
                                    <Label text="%notifications.empty.copy"
                                           wrapText="true"
                                           styleClass="empty-text"/>
                                </VBox>
                            </StackPane>
                        </VBox>
                    </VBox>
                </StackPane>
            </content>
        </ScrollPane>
    </center>
</BorderPane>

