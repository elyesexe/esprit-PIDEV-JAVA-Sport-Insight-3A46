<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.esprit.Controller.JoueurController"
            styleClass="page-root">
    <top>
        <HBox fx:id="navbarRoot" alignment="CENTER_LEFT" spacing="16" styleClass="navbar-root" BorderPane.alignment="CENTER">
            <padding>
                <Insets top="10" right="20" bottom="10" left="20"/>
            </padding>

            <Button fx:id="adminNavButton"
                    onAction="#handleOpenAdmin"
                    text="Admin"
                    mnemonicParsing="false"
                    styleClass="navbar-admin-button"/>

            <HBox fx:id="sidebarBrandBox" alignment="CENTER_LEFT" spacing="10" styleClass="navbar-brand" onMouseClicked="#handleOpenHome">
                <StackPane styleClass="navbar-logo-shell">
                    <ImageView fitWidth="152" fitHeight="50" preserveRatio="true" smooth="true">
                        <image>
                            <Image url="@../images/sport-insight-logo.png"/>
                        </image>
                    </ImageView>
                </StackPane>
            </HBox>

            <StackPane HBox.hgrow="ALWAYS" styleClass="navbar-center-wrap">
                <HBox alignment="CENTER" spacing="9" styleClass="navbar-modules">
                    <Button fx:id="matchsNavButton"
                            onAction="#handleOpenMatchsSoon"
                            text="Matchs"
                            styleClass="navbar-nav-button"/>
                    <HBox fx:id="sidebarModuleChildrenBox"
                          spacing="8"
                          alignment="CENTER"
                          managed="false"
                          visible="false"
                          styleClass="navbar-submenu">
                        <Button fx:id="equipesNavButton"
                                onAction="#handleOpenEquipes"
                                text="Equipes"
                                styleClass="navbar-nav-button navbar-submenu-button"/>
                        <Button fx:id="leaguesNavButton"
                                onAction="#handleOpenLeagues"
                                text="Leagues"
                                styleClass="navbar-nav-button navbar-submenu-button"/>
                        <Button fx:id="joueursNavButton"
                                onAction="#handleOpenJoueurs"
                                text="Joueurs"
                                styleClass="navbar-nav-button navbar-submenu-button"/>
                    </HBox>
                    <Button fx:id="annonceNavButton"
                            onAction="#handleOpenAnnonces"
                            text="Anonce"
                            styleClass="navbar-nav-button"/>
                </HBox>
            </StackPane>

            <HBox alignment="CENTER_RIGHT" styleClass="navbar-theme-wrap">
                <ToggleButton fx:id="themeToggleButton"
                              mnemonicParsing="false"
                              contentDisplay="GRAPHIC_ONLY"
                              styleClass="theme-toggle">
                    <graphic>
                        <StackPane styleClass="theme-toggle-track">
                            <StackPane styleClass="theme-toggle-thumb">
                                <StackPane styleClass="theme-toggle-icon-shell">
                                    <Label text="☀" styleClass="theme-toggle-icon theme-toggle-sun"/>
                                    <Label text="☾" styleClass="theme-toggle-icon theme-toggle-moon"/>
                                </StackPane>
                            </StackPane>
                        </StackPane>
                    </graphic>
                </ToggleButton>
            </HBox>
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true"
                    hbarPolicy="NEVER"
                    pannable="true"
                    styleClass="page-scroll"
                    BorderPane.alignment="CENTER">
            <content>
                <StackPane styleClass="page-shell-wrap">
                <VBox spacing="18" styleClass="page-shell">
                    <padding>
                        <Insets top="24" right="28" bottom="28" left="28"/>
                    </padding>

                    <StackPane styleClass="hero-shell">
                        <Region styleClass="hero-photo"/>
                        <Region styleClass="hero-overlay"/>

                        <VBox spacing="12" styleClass="hero-content">
                            <Label text="Squad" styleClass="hero-eyebrow"/>
                            <Label text="Pilotez votre effectif joueur" styleClass="hero-title"/>
                            <Label text="Retrouvez les profils, filtrez par equipe et gardez une fiche detail vivante pendant la creation ou l'edition."
                                   wrapText="true"
                                   styleClass="hero-text"/>

                            <HBox spacing="10">
                                <Label fx:id="resultCountLabel" text="0 joueur(s)" styleClass="toolbar-chip-soft"/>
                                <Label fx:id="selectionStateLabel" text="Mode creation" styleClass="toolbar-chip"/>
                            </HBox>
                        </VBox>
                    </StackPane>

                    <VBox spacing="14" styleClass="panel-card toolbar-panel">
                        <HBox alignment="CENTER_LEFT" spacing="12">
                            <VBox spacing="4" HBox.hgrow="ALWAYS">
                                <Label text="Statistiques joueurs" styleClass="section-title"/>
                                <Label text="Repartition des joueurs par equipe pour suivre les effectifs."
                                       wrapText="true"
                                       styleClass="section-subtitle"/>
                            </VBox>
                        </HBox>

                        <Label fx:id="playerChartSummaryLabel"
                               text="Chargement des statistiques joueurs..."
                               wrapText="true"
                               styleClass="section-subtitle"/>

                        <BarChart fx:id="playerDistributionChart"
                                  animated="false"
                                  categoryGap="14"
                                  legendVisible="false"
                                  prefHeight="260"
                                  styleClass="module-stats-chart">
                            <xAxis>
                                <CategoryAxis side="BOTTOM"/>
                            </xAxis>
                            <yAxis>
                                <NumberAxis forceZeroInRange="true" side="LEFT"/>
                            </yAxis>
                        </BarChart>
                    </VBox>

                    <VBox spacing="16" styleClass="panel-card toolbar-panel">
                        <HBox spacing="16" alignment="CENTER_LEFT">
                            <VBox spacing="4" HBox.hgrow="ALWAYS">
                                <Label text="Joueurs" styleClass="section-title"/>
                                <Label text="Filtrez l'effectif par nom ou par equipe dans la meme identite visuelle que le module Equipes."
                                       wrapText="true"
                                       styleClass="section-subtitle"/>
                            </VBox>
                            <Label fx:id="teamCountLabel" text="0 equipe(s)" styleClass="toolbar-chip-soft"/>
                            <Label fx:id="statusLabel" text="Pret" styleClass="status-pill status-muted"/>
                        </HBox>

                        <HBox spacing="12" alignment="CENTER_LEFT">
                            <VBox spacing="6" HBox.hgrow="ALWAYS">
                                <Label text="Recherche" styleClass="field-label"/>
                                <TextField fx:id="searchField"
                                           promptText="Rechercher par nom, prenom ou equipe"
                                           styleClass="form-text-field"/>
                            </VBox>

                            <VBox spacing="6">
                                <Label text="Equipe" styleClass="field-label"/>
                                <ComboBox fx:id="equipeFilterComboBox"
                                          prefWidth="190"
                                          promptText="Toutes les equipes"
                                          styleClass="glass-combo"/>
                            </VBox>

                            <VBox spacing="6">
                                <Label text="Actions" styleClass="field-label"/>
                                <HBox spacing="10">
                                    <Button onAction="#handleExportExcel"
                                            text="Excel"
                                            styleClass="soft-button"/>
                                    <Button fx:id="refreshButton"
                                            onAction="#handleRefresh"
                                            text="Actualiser"
                                            styleClass="primary-button"/>
                                    <Button onAction="#handleResetFilters"
                                            text="Reinitialiser"
                                            styleClass="ghost-button"/>
                                </HBox>
                            </VBox>
                        </HBox>
                    </VBox>

                    <HBox spacing="18" styleClass="content-shell">
                        <VBox spacing="14" styleClass="panel-card results-panel" HBox.hgrow="ALWAYS">
                            <HBox spacing="12" alignment="CENTER_LEFT">
                                <VBox spacing="4" HBox.hgrow="ALWAYS">
                                    <Label text="Table des joueurs" styleClass="section-title"/>
                                    <Label text="Selectionnez une ligne pour alimenter la fiche detail et le formulaire d'edition."
                                           wrapText="true"
                                           styleClass="section-subtitle"/>
                                </VBox>
                                <Label fx:id="resultsMetaLabel" text="0 ligne(s)" styleClass="toolbar-chip-soft"/>
                            </HBox>

                            <StackPane VBox.vgrow="ALWAYS">
                                <TableView fx:id="joueurTableView"
                                           prefHeight="540"
                                           styleClass="data-table">
                                    <columns>
                                        <TableColumn fx:id="joueurIdColumn" text="ID" prefWidth="72"/>
                                        <TableColumn fx:id="joueurNomColumn" text="Nom" prefWidth="140"/>
                                        <TableColumn fx:id="joueurPrenomColumn" text="Prenom" prefWidth="140"/>
                                        <TableColumn fx:id="joueurEquipeColumn" text="Equipe" prefWidth="170"/>
                                        <TableColumn fx:id="joueurNumeroColumn" text="Numero" prefWidth="88"/>
                                        <TableColumn fx:id="joueurNaissanceColumn" text="Naissance" prefWidth="118"/>
                                        <TableColumn fx:id="joueurPositionColumn" text="Position" prefWidth="132"/>
                                        <TableColumn fx:id="joueurNationaliteColumn" text="Nationalite" prefWidth="130"/>
                                    </columns>
                                </TableView>

                                <VBox fx:id="emptyStateBox"
                                      alignment="CENTER"
                                      managed="false"
                                      maxWidth="340"
                                      spacing="12"
                                      visible="false"
                                      styleClass="empty-state-box">
                                    <Label text="+" styleClass="empty-icon"/>
                                    <Label text="Aucun joueur trouve" styleClass="empty-title"/>
                                    <Label text="Essayez un autre nom ou reinitialisez le filtre pour revoir l'effectif complet."
                                           wrapText="true"
                                           styleClass="empty-text"/>
                                </VBox>
                            </StackPane>
                        </VBox>

                        <VBox spacing="18" minWidth="400" prefWidth="440" maxWidth="460" styleClass="side-column">
                            <VBox spacing="16" styleClass="panel-card detail-card">
                                <HBox alignment="CENTER_LEFT" spacing="10">
                                    <Label fx:id="detailBadgeLabel" text="Apercu" styleClass="toolbar-chip"/>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Button onAction="#handleClear" text="Nouvelle fiche" styleClass="ghost-button"/>
                                </HBox>

                                <StackPane styleClass="player-detail-photo-shell">
                                    <ImageView fx:id="detailImageView"
                                               fitHeight="190"
                                               fitWidth="190"
                                               managed="false"
                                               preserveRatio="true"
                                               visible="false"/>
                                    <Label fx:id="detailImageFallbackLabel" text="J" styleClass="player-detail-photo-fallback"/>
                                </StackPane>

                                <VBox spacing="6">
                                    <Label fx:id="detailNameLabel" text="Aucun joueur selectionne" styleClass="detail-title"/>
                                    <Label fx:id="detailSubtitleLabel"
                                           text="Selectionnez une carte ou commencez une nouvelle creation pour afficher la fiche detail."
                                           wrapText="true"
                                           styleClass="detail-subtitle"/>
                                </VBox>

                                <HBox spacing="10">
                                    <VBox HBox.hgrow="ALWAYS" styleClass="stat-chip">
                                        <Label text="ID" styleClass="stat-caption"/>
                                        <Label fx:id="detailIdValueLabel" text="Nouveau" styleClass="stat-value"/>
                                    </VBox>

                                    <VBox HBox.hgrow="ALWAYS" styleClass="stat-chip">
                                        <Label text="Equipe" styleClass="stat-caption"/>
                                        <Label fx:id="detailEquipeValueLabel" text="Aucune" styleClass="stat-value"/>
                                    </VBox>

                                    <VBox HBox.hgrow="ALWAYS" styleClass="stat-chip">
                                        <Label text="Numero" styleClass="stat-caption"/>
                                        <Label fx:id="detailNumeroValueLabel" text="Non defini" styleClass="stat-value"/>
                                    </VBox>
                                </HBox>
                            </VBox>

                            <VBox spacing="16" styleClass="panel-card form-card">
                                <VBox spacing="4">
                                    <Label text="Edition de la fiche" styleClass="section-title"/>
                                    <Label fx:id="formHintLabel"
                                           text="Composez une nouvelle fiche joueur et visualisez-la a droite."
                                           wrapText="true"
                                           styleClass="section-subtitle"/>
                                </VBox>

                                <Label fx:id="validationLabel"
                                       managed="false"
                                       visible="false"
                                       wrapText="true"
                                       styleClass="validation-label"/>

                                <VBox spacing="8">
                                    <Label text="Nom" styleClass="field-label"/>
                                    <TextField fx:id="nomField"
                                               promptText="Ex: Mbappe"
                                               styleClass="form-text-field"/>
                                </VBox>

                                <VBox spacing="8">
                                    <Label text="Prenom" styleClass="field-label"/>
                                    <TextField fx:id="prenomField"
                                               promptText="Ex: Kylian"
                                               styleClass="form-text-field"/>
                                </VBox>

                                <VBox spacing="8">
                                    <Label text="Date de naissance" styleClass="field-label"/>
                                    <DatePicker fx:id="dateNaissancePicker" styleClass="form-date-picker"/>
                                </VBox>

                                <VBox spacing="8">
                                    <Label text="Numero de maillot" styleClass="field-label"/>
                                    <TextField fx:id="numeroField"
                                               promptText="Entre 1 et 99"
                                               styleClass="form-text-field"/>
                                </VBox>

                                <VBox spacing="8">
                                    <Label text="Equipe" styleClass="field-label"/>
                                    <ComboBox fx:id="equipeComboBox"
                                              promptText="Choisir une equipe"
                                              styleClass="glass-combo"/>
                                </VBox>

                                <VBox spacing="8">
                                    <Label text="Image" styleClass="field-label"/>
                                    <HBox spacing="10" alignment="CENTER_LEFT">
                                        <TextField fx:id="imageField"
                                                   editable="false"
                                                   promptText="Choisissez une photo"
                                                   styleClass="form-text-field"
                                                   HBox.hgrow="ALWAYS"/>
                                        <Button onAction="#handleBrowseImage"
                                                text="Parcourir..."
                                                styleClass="ghost-button"/>
                                    </HBox>
                                    <Label text="La photo choisie via Windows Explorer s'affiche dans la liste et dans la fiche detail."
                                           wrapText="true"
                                           styleClass="form-helper"/>
                                </VBox>

                                <HBox spacing="10">
                                    <Button fx:id="addButton"
                                            onAction="#handleAdd"
                                            text="Ajouter"
                                            styleClass="primary-button"
                                            HBox.hgrow="ALWAYS"/>
                                    <Button fx:id="updateButton"
                                            onAction="#handleUpdate"
                                            managed="false"
                                            visible="false"
                                            text="Modifier"
                                            styleClass="ghost-button"
                                            HBox.hgrow="ALWAYS"/>
                                </HBox>

                                <HBox spacing="10">
                                    <Button fx:id="deleteButton"
                                            onAction="#handleDelete"
                                            managed="false"
                                            visible="false"
                                            text="Supprimer"
                                            styleClass="danger-button"
                                            HBox.hgrow="ALWAYS"/>
                                    <Button fx:id="clearButton"
                                            onAction="#handleClear"
                                            text="Vider"
                                            styleClass="soft-button"
                                            HBox.hgrow="ALWAYS"/>
                                </HBox>
                            </VBox>
                        </VBox>
                    </HBox>
                </VBox>
                </StackPane>
            </content>
        </ScrollPane>
    </center>
</BorderPane>


