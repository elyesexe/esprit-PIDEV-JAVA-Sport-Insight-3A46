<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.esprit.Controller.JoueurListController"
            styleClass="page-root">
    <top>
        <HBox fx:id="navbarRoot" alignment="CENTER_LEFT" spacing="16" styleClass="navbar-root" BorderPane.alignment="CENTER">
            <padding>
                <Insets top="10" right="20" bottom="10" left="20"/>
            </padding>

            <Button fx:id="adminNavButton"
                    onAction="#handleOpenAdmin"
                    text="Admin"
                    mnemonicParsing="false"
                    styleClass="navbar-admin-button"/>

            <HBox fx:id="sidebarBrandBox" alignment="CENTER_LEFT" spacing="10" styleClass="navbar-brand" onMouseClicked="#handleOpenHome">
                <StackPane styleClass="navbar-logo-shell">
                    <ImageView fitWidth="152" fitHeight="50" preserveRatio="true" smooth="true">
                        <image>
                            <Image url="@../images/sport-insight-logo.png"/>
                        </image>
                    </ImageView>
                </StackPane>
            </HBox>

            <StackPane HBox.hgrow="ALWAYS" styleClass="navbar-center-wrap">
                <HBox alignment="CENTER" spacing="9" styleClass="navbar-modules">
                    <Button fx:id="matchsNavButton"
                            onAction="#handleOpenMatchs"
                            text="Matchs"
                            styleClass="navbar-nav-button"/>
                    <HBox fx:id="sidebarModuleChildrenBox"
                          spacing="8"
                          alignment="CENTER"
                          managed="false"
                          visible="false"
                          styleClass="navbar-submenu">
                        <Button fx:id="equipesNavButton"
                                onAction="#handleOpenEquipes"
                                text="Equipes"
                                styleClass="navbar-nav-button navbar-submenu-button"/>
                        <Button fx:id="leaguesNavButton"
                                onAction="#handleOpenLeagues"
                                text="Leagues"
                                styleClass="navbar-nav-button navbar-submenu-button"/>
                        <Button fx:id="joueursNavButton"
                                onAction="#handleOpenJoueurs"
                                text="Joueurs"
                                styleClass="navbar-nav-button navbar-submenu-button"/>
                    </HBox>
                </HBox>
            </StackPane>

            <HBox alignment="CENTER_RIGHT" styleClass="navbar-theme-wrap">
                <ToggleButton fx:id="themeToggleButton"
                              mnemonicParsing="false"
                              contentDisplay="GRAPHIC_ONLY"
                              styleClass="theme-toggle">
                    <graphic>
                        <StackPane styleClass="theme-toggle-track">
                            <StackPane styleClass="theme-toggle-thumb">
                                <StackPane styleClass="theme-toggle-icon-shell">
                                    <Label text="â˜€" styleClass="theme-toggle-icon theme-toggle-sun"/>
                                    <Label text="â˜¾" styleClass="theme-toggle-icon theme-toggle-moon"/>
                                </StackPane>
                            </StackPane>
                        </StackPane>
                    </graphic>
                </ToggleButton>
            </HBox>
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true"
                    hbarPolicy="NEVER"
                    pannable="true"
                    styleClass="page-scroll"
                    BorderPane.alignment="CENTER">
            <content>
                <VBox spacing="18" styleClass="page-shell">
                    <padding>
                        <Insets top="24" right="28" bottom="28" left="28"/>
                    </padding>

                    <StackPane styleClass="hero-shell">
                        <Region styleClass="hero-photo"/>
                        <Region styleClass="hero-overlay"/>

                        <VBox spacing="12" styleClass="hero-content">
                            <Label text="Squad" styleClass="hero-eyebrow"/>
                            <Label text="Parcourez les joueurs" styleClass="hero-title"/>
                            <Label text="Retrouvez les profils par nom ou par equipe, puis ouvrez chaque joueur sur une page detail dediee."
                                   wrapText="true"
                                   styleClass="hero-text"/>

                            <HBox spacing="10">
                                <Label fx:id="resultCountLabel" text="0 joueur(s)" styleClass="toolbar-chip-soft"/>
                                <Label fx:id="selectionStateLabel" text="Cliquez sur une carte pour ouvrir la fiche" styleClass="toolbar-chip"/>
                            </HBox>
                        </VBox>
                    </StackPane>

                    <VBox spacing="16" styleClass="panel-card toolbar-panel">
                        <HBox spacing="16" alignment="CENTER_LEFT">
                            <VBox spacing="4" HBox.hgrow="ALWAYS">
                                <Label text="Joueurs" styleClass="section-title"/>
                                <Label text="Vue publique en lecture seule : liste, filtres et fiche detail sur une autre page."
                                       wrapText="true"
                                       styleClass="section-subtitle"/>
                            </VBox>
                            <Label fx:id="teamCountLabel" text="0 equipe(s)" styleClass="toolbar-chip-soft"/>
                            <Label fx:id="statusLabel" text="Pret" styleClass="status-pill status-muted"/>
                        </HBox>

                        <HBox spacing="12" alignment="CENTER_LEFT">
                            <VBox spacing="6" HBox.hgrow="ALWAYS">
                                <Label text="Recherche" styleClass="field-label"/>
                                <TextField fx:id="searchField"
                                           promptText="Rechercher par nom, prenom ou equipe"
                                           styleClass="form-text-field"/>
                            </VBox>

                            <VBox spacing="6">
                                <Label text="Equipe" styleClass="field-label"/>
                                <ComboBox fx:id="equipeFilterComboBox"
                                          prefWidth="190"
                                          promptText="Toutes les equipes"
                                          styleClass="glass-combo"/>
                            </VBox>

                            <VBox spacing="6">
                                <Label text="Actions" styleClass="field-label"/>
                                <HBox spacing="10">
                                    <Button fx:id="refreshButton"
                                            onAction="#handleRefresh"
                                            text="Actualiser"
                                            styleClass="primary-button"/>
                                    <Button onAction="#handleResetFilters"
                                            text="Reinitialiser"
                                            styleClass="ghost-button"/>
                                </HBox>
                            </VBox>
                        </HBox>
                    </VBox>

                    <VBox spacing="14" styleClass="panel-card results-panel">
                        <HBox spacing="12" alignment="CENTER_LEFT">
                            <VBox spacing="4" HBox.hgrow="ALWAYS">
                                <Label text="Cartes des joueurs" styleClass="section-title"/>
                                <Label text="Chaque carte ouvre directement une page detail. Aucun formulaire ni action CRUD ici."
                                       wrapText="true"
                                       styleClass="section-subtitle"/>
                            </VBox>
                            <Label fx:id="resultsMetaLabel" text="0 carte(s)" styleClass="toolbar-chip-soft"/>
                        </HBox>

                        <StackPane VBox.vgrow="ALWAYS">
                            <ListView fx:id="joueurListView"
                                      prefHeight="560"
                                      styleClass="player-list-view"/>

                            <VBox fx:id="emptyStateBox"
                                  alignment="CENTER"
                                  managed="false"
                                  maxWidth="340"
                                  spacing="12"
                                  visible="false"
                                  styleClass="empty-state-box">
                                <Label text="+" styleClass="empty-icon"/>
                                <Label text="Aucun joueur trouve" styleClass="empty-title"/>
                                <Label text="Essayez un autre nom ou reinitialisez le filtre pour revoir l'effectif complet."
                                       wrapText="true"
                                       styleClass="empty-text"/>
                            </VBox>
                        </StackPane>
                    </VBox>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
