<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.esprit.Controller.EquipeListController"
            styleClass="page-root">
    <top>
        <HBox fx:id="navbarRoot" alignment="CENTER_LEFT" spacing="16" styleClass="navbar-root" BorderPane.alignment="CENTER">
            <padding>
                <Insets top="10" right="20" bottom="10" left="20"/>
            </padding>

            <Button fx:id="adminNavButton"
                    onAction="#handleOpenAdmin"
                    text="Admin"
                    mnemonicParsing="false"
                    styleClass="navbar-admin-button"/>

            <HBox fx:id="sidebarBrandBox" alignment="CENTER_LEFT" spacing="10" styleClass="navbar-brand" onMouseClicked="#handleOpenHome">
                <StackPane styleClass="navbar-logo-shell">
                    <ImageView fitWidth="152" fitHeight="50" preserveRatio="true" smooth="true">
                        <image>
                            <Image url="@../images/sport-insight-logo.png"/>
                        </image>
                    </ImageView>
                </StackPane>
            </HBox>

            <StackPane HBox.hgrow="ALWAYS" styleClass="navbar-center-wrap">
                <HBox alignment="CENTER" spacing="9" styleClass="navbar-modules">
                    <Button fx:id="matchsNavButton"
                            onAction="#handleOpenMatchs"
                            text="Matchs"
                            styleClass="navbar-nav-button"/>
                    <HBox fx:id="sidebarModuleChildrenBox"
                          spacing="8"
                          alignment="CENTER"
                          managed="false"
                          visible="false"
                          styleClass="navbar-submenu">
                        <Button fx:id="equipesNavButton"
                                onAction="#handleOpenEquipes"
                                text="Equipes"
                                styleClass="navbar-nav-button navbar-submenu-button"/>
                        <Button fx:id="leaguesNavButton"
                                onAction="#handleOpenLeagues"
                                text="Leagues"
                                styleClass="navbar-nav-button navbar-submenu-button"/>
                        <Button fx:id="joueursNavButton"
                                onAction="#handleOpenJoueurs"
                                text="Joueurs"
                                styleClass="navbar-nav-button navbar-submenu-button"/>
                    </HBox>
                    <Button fx:id="annonceNavButton"
                            onAction="#handleOpenAnnonces"
                            text="Anonce"
                            styleClass="navbar-nav-button"/>
                </HBox>
            </StackPane>

            <HBox alignment="CENTER_RIGHT" styleClass="navbar-theme-wrap">
                <ToggleButton fx:id="themeToggleButton"
                              mnemonicParsing="false"
                              contentDisplay="GRAPHIC_ONLY"
                              styleClass="theme-toggle">
                    <graphic>
                        <StackPane styleClass="theme-toggle-track">
                            <StackPane styleClass="theme-toggle-thumb">
                                <StackPane styleClass="theme-toggle-icon-shell">
                                    <Label text="☀" styleClass="theme-toggle-icon theme-toggle-sun"/>
                                    <Label text="☾" styleClass="theme-toggle-icon theme-toggle-moon"/>
                                </StackPane>
                            </StackPane>
                        </StackPane>
                    </graphic>
                </ToggleButton>
            </HBox>
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true"
                    hbarPolicy="NEVER"
                    pannable="true"
                    styleClass="page-scroll"
                    BorderPane.alignment="CENTER">
            <content>
                <StackPane styleClass="page-shell-wrap">
                <VBox spacing="18" alignment="TOP_CENTER" maxWidth="1180" styleClass="page-shell team-list-page-shell">
                    <padding>
                        <Insets top="24" right="28" bottom="28" left="28"/>
                    </padding>

                    <StackPane styleClass="hero-shell">
                        <StackPane styleClass="hero-photo"/>
                        <StackPane styleClass="hero-overlay"/>
                        <VBox spacing="14" styleClass="hero-content">
                            <Label fx:id="competitionChipLabel" text="Competition" styleClass="hero-eyebrow"/>
                            <Label fx:id="pageTitleLabel" text="Equipes" styleClass="hero-title"/>
                            <Label fx:id="pageSubtitleLabel"
                                   text="Tous les clubs de la competition selectionnee sont disponibles ici."
                                   wrapText="true"
                                   styleClass="hero-text"/>
                            <HBox spacing="10">
                                <Label fx:id="resultCountLabel" text="0 equipe(s)" styleClass="toolbar-chip"/>
                                <Label text="Cliquez sur une carte pour ouvrir sa fiche complete" styleClass="toolbar-chip-soft"/>
                            </HBox>
                        </VBox>
                    </StackPane>

                    <VBox spacing="16" styleClass="panel-card toolbar-panel">
                        <HBox spacing="16" alignment="CENTER_LEFT">
                            <VBox spacing="4" HBox.hgrow="ALWAYS">
                                <Label text="Equipes" styleClass="section-title"/>
                                <Label text="Recherchez, triez et ouvrez une fiche equipe sur une page dediee."
                                       wrapText="true"
                                       styleClass="section-subtitle"/>
                            </VBox>
                            <Label fx:id="statusLabel"
                                   text="Pret"
                                   managed="false"
                                   visible="false"
                                   styleClass="status-pill"/>
                        </HBox>

                        <HBox spacing="12" alignment="CENTER_LEFT">
                            <VBox spacing="6" HBox.hgrow="ALWAYS">
                                <Label text="Recherche" styleClass="field-label"/>
                                <TextField fx:id="searchField"
                                           promptText="Rechercher par nom ou coach"
                                           styleClass="form-text-field"/>
                            </VBox>

                            <VBox spacing="6">
                                <Label text="Tri" styleClass="field-label"/>
                                <ComboBox fx:id="sortChoiceBox" prefWidth="150" styleClass="glass-combo"/>
                            </VBox>

                            <VBox spacing="6">
                                <Label text="Ordre" styleClass="field-label"/>
                                <Button fx:id="sortOrderButton"
                                        onAction="#handleToggleSortOrder"
                                        text="Croissant"
                                        prefWidth="132"
                                        styleClass="ghost-button"/>
                            </VBox>

                            <VBox spacing="6">
                                <Label text="Actions" styleClass="field-label"/>
                                <HBox spacing="10">
                                    <Button fx:id="refreshButton"
                                            onAction="#handleRefresh"
                                            text="Actualiser"
                                            styleClass="primary-button"/>
                                    <Button onAction="#handleResetFilters"
                                            text="Reinitialiser"
                                            styleClass="ghost-button"/>
                                </HBox>
                            </VBox>
                        </HBox>

                        <HBox spacing="10" alignment="CENTER_LEFT">
                            <Button onAction="#handleBack"
                                    text="Competitions"
                                    styleClass="ghost-button"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label fx:id="resultsMetaLabel" text="0 resultat(s)" styleClass="toolbar-chip-soft"/>
                        </HBox>
                    </VBox>

                    <VBox spacing="14" styleClass="panel-card results-panel">
                        <HBox spacing="12" alignment="CENTER_LEFT">
                            <VBox spacing="4" HBox.hgrow="ALWAYS">
                                <Label text="Liste des equipes" styleClass="section-title"/>
                                <Label text="Chaque carte ouvre une page detail en lecture seule avec les informations du club et son effectif."
                                       wrapText="true"
                                       styleClass="section-subtitle"/>
                            </VBox>
                        </HBox>

                        <StackPane VBox.vgrow="ALWAYS">
                            <FlowPane fx:id="equipeCatalogPane"
                                      alignment="CENTER"
                                      hgap="18"
                                      vgap="18"
                                      prefWrapLength="1040"
                                      styleClass="team-catalog-pane"/>

                            <VBox fx:id="emptyStateBox"
                                  alignment="CENTER"
                                  managed="false"
                                  maxWidth="340"
                                  spacing="12"
                                  visible="false"
                                  styleClass="empty-state-box">
                                <Label text="+" styleClass="empty-icon"/>
                                <Label text="Aucune equipe trouvee" styleClass="empty-title"/>
                                <Label text="Essayez un autre mot-cle ou revenez aux competitions pour changer de championnat."
                                       wrapText="true"
                                       styleClass="empty-text"/>
                            </VBox>
                        </StackPane>
                    </VBox>
                </VBox>
                </StackPane>
            </content>
        </ScrollPane>
    </center>
</BorderPane>


