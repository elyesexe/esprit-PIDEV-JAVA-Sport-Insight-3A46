<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.esprit.Controller.AdminUserModerationController"
            styleClass="page-root">
    <center>
        <ScrollPane fitToWidth="true"
                    hbarPolicy="NEVER"
                    styleClass="page-scroll"
                    BorderPane.alignment="CENTER">
            <content>
                <StackPane styleClass="page-shell-wrap">
                    <VBox spacing="22" styleClass="page-shell admin-users-shell">
                        <padding>
                            <Insets top="24" right="28" bottom="28" left="28"/>
                        </padding>

                        <HBox alignment="CENTER_LEFT" spacing="16">
                            <VBox spacing="6" HBox.hgrow="ALWAYS">
                                <Label text="%admin.users.title" styleClass="admin-dashboard-title"/>
                                <Label text="%admin.users.subtitle"
                                       wrapText="true"
                                       styleClass="admin-dashboard-subtitle"/>
                            </VBox>
                            <Label fx:id="statusLabel"
                                   text="Loading..."
                                   styleClass="status-pill status-muted"/>
                        </HBox>

                        <FlowPane hgap="16" vgap="16" prefWrapLength="1000" styleClass="admin-kpi-row">
                            <VBox spacing="8" styleClass="admin-kpi-card">
                                <Label text="%admin.users.kpi.users" styleClass="admin-kpi-label"/>
                                <Label fx:id="totalUsersLabel" text="0" styleClass="admin-kpi-value"/>
                                <Label text="%admin.users.kpi.usersMeta" styleClass="admin-kpi-meta"/>
                            </VBox>
                            <VBox spacing="8" styleClass="admin-kpi-card">
                                <Label text="%admin.users.kpi.admins" styleClass="admin-kpi-label"/>
                                <Label fx:id="adminUsersLabel" text="0" styleClass="admin-kpi-value"/>
                                <Label text="%admin.users.kpi.adminsMeta" styleClass="admin-kpi-meta"/>
                            </VBox>
                            <VBox spacing="8" styleClass="admin-kpi-card">
                                <Label text="%admin.users.kpi.inactive" styleClass="admin-kpi-label"/>
                                <Label fx:id="inactiveUsersLabel" text="0" styleClass="admin-kpi-value"/>
                                <Label text="%admin.users.kpi.inactiveMeta" styleClass="admin-kpi-meta"/>
                            </VBox>
                        </FlowPane>

                        <HBox spacing="18" styleClass="admin-dashboard-grid">
                            <VBox spacing="12" styleClass="panel-card admin-chart-card" HBox.hgrow="ALWAYS">
                                <Label text="%admin.users.chart.title" styleClass="section-title admin-section-title"/>
                                <Label fx:id="chartSummaryLabel"
                                       text="%admin.users.chart.summary"
                                       wrapText="true"
                                       styleClass="admin-chart-summary"/>
                                <BarChart fx:id="accountStatusBarChart"
                                          animated="false"
                                          legendVisible="false"
                                          prefHeight="300"
                                          styleClass="admin-stats-chart">
                                    <xAxis>
                                        <CategoryAxis label="%common.table.status"/>
                                    </xAxis>
                                    <yAxis>
                                        <NumberAxis label="%admin.users.accounts"/>
                                    </yAxis>
                                </BarChart>
                            </VBox>

                            <VBox spacing="12" prefWidth="360" styleClass="panel-card admin-chart-card">
                                <Label text="%admin.users.pie.title" styleClass="section-title admin-section-title"/>
                                <Label text="%admin.users.pie.copy"
                                       wrapText="true"
                                       styleClass="admin-chart-summary"/>
                                <PieChart fx:id="accountStatusPieChart"
                                          animated="false"
                                          labelsVisible="true"
                                          legendVisible="true"
                                          prefHeight="300"
                                          styleClass="admin-stats-chart"/>
                            </VBox>
                        </HBox>

                        <VBox spacing="16" styleClass="panel-card toolbar-panel">
                            <HBox spacing="16" alignment="CENTER_LEFT">
                                <VBox spacing="4" HBox.hgrow="ALWAYS">
                                    <Label text="%admin.users.workspace.title" styleClass="section-title"/>
                                    <Label text="%admin.users.workspace.copy"
                                           wrapText="true"
                                           styleClass="section-subtitle"/>
                                </VBox>
                                <Label fx:id="resultsMetaLabel" text="%admin.users.results" styleClass="toolbar-chip-soft"/>
                            </HBox>

                            <HBox spacing="12" alignment="CENTER_LEFT">
                                <VBox spacing="6" HBox.hgrow="ALWAYS">
                                    <Label text="%common.field.search" styleClass="field-label"/>
                                    <TextField fx:id="searchField"
                                               promptText="%admin.users.search.prompt"
                                               styleClass="form-text-field"/>
                                </VBox>

                                <VBox spacing="6">
                                    <Label text="%admin.users.sort" styleClass="field-label"/>
                                    <ComboBox fx:id="sortComboBox"
                                              prefWidth="140"
                                              styleClass="glass-combo"/>
                                </VBox>

                                <VBox spacing="6">
                                    <Label text="%common.field.actions" styleClass="field-label"/>
                                    <HBox spacing="10">
                                        <Button onAction="#handleExportPdf"
                                                text="%common.action.exportPdf"
                                                styleClass="ghost-button"/>
                                        <Button onAction="#handleRefresh"
                                                text="%common.action.refresh"
                                                styleClass="primary-button"/>
                                        <Button onAction="#handleResetFilters"
                                                text="%common.action.reset"
                                                styleClass="ghost-button"/>
                                    </HBox>
                                </VBox>
                            </HBox>
                        </VBox>

                        <HBox spacing="18" styleClass="admin-user-grid">
                            <VBox spacing="12" styleClass="panel-card results-panel" HBox.hgrow="ALWAYS">
                                <HBox alignment="CENTER_LEFT" spacing="10">
                                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                                        <Label text="%admin.users.accountsTitle" styleClass="section-title admin-section-title"/>
                                        <Label text="%admin.users.accountsCopy"
                                               wrapText="true"
                                               styleClass="section-subtitle"/>
                                    </VBox>
                                </HBox>

                                <TableView fx:id="userTableView"
                                           prefHeight="560"
                                           styleClass="data-table admin-user-table">
                                    <columns>
                                        <TableColumn fx:id="idColumn" text="%common.table.id" prefWidth="70"/>
                                        <TableColumn fx:id="nameColumn" text="%admin.users.table.user" prefWidth="180"/>
                                        <TableColumn fx:id="emailColumn" text="%common.field.email" prefWidth="220"/>
                                        <TableColumn fx:id="roleColumn" text="%common.table.role" prefWidth="120"/>
                                        <TableColumn fx:id="statusColumn" text="%common.table.status" prefWidth="120"/>
                                        <TableColumn fx:id="createdColumn" text="%admin.users.table.joined" prefWidth="150"/>
                                    </columns>
                                    <placeholder>
                                        <Label text="%admin.users.table.empty" styleClass="empty-text"/>
                                    </placeholder>
                                </TableView>
                            </VBox>

                            <VBox spacing="14"
                                  styleClass="panel-card form-card admin-user-form-card"
                                  minWidth="380"
                                  prefWidth="410">
                                <HBox alignment="CENTER_LEFT" spacing="10">
                                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                                        <Label text="%admin.users.selected.title" styleClass="section-title"/>
                                        <Label fx:id="selectionStateLabel"
                                               text="%admin.users.selected.placeholder"
                                               styleClass="section-subtitle"/>
                                    </VBox>
                                    <Label text="%admin.users.adminOnly" styleClass="toolbar-chip"/>
                                </HBox>

                                <Label fx:id="validationLabel"
                                       managed="false"
                                       visible="false"
                                       wrapText="true"
                                       styleClass="status-pill status-error"/>

                                <VBox spacing="6">
                                    <Label text="%common.field.email" styleClass="field-label"/>
                                    <TextField fx:id="emailField" promptText="%common.prompt.email" styleClass="form-text-field"/>
                                </VBox>

                                <HBox spacing="10">
                                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                                        <Label text="%common.field.firstName" styleClass="field-label"/>
                                        <TextField fx:id="prenomField" promptText="%common.prompt.firstName" styleClass="form-text-field"/>
                                    </VBox>
                                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                                        <Label text="%common.field.lastName" styleClass="field-label"/>
                                        <TextField fx:id="nomField" promptText="%common.prompt.lastName" styleClass="form-text-field"/>
                                    </VBox>
                                </HBox>

                                <HBox spacing="10">
                                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                                        <Label text="%common.field.phone" styleClass="field-label"/>
                                        <TextField fx:id="telephoneField" promptText="%common.prompt.phone" styleClass="form-text-field"/>
                                    </VBox>
                                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                                        <Label text="%common.field.birthDate" styleClass="field-label"/>
                                        <DatePicker fx:id="dateNaissancePicker" styleClass="form-date-picker"/>
                                    </VBox>
                                </HBox>

                                <HBox spacing="10">
                                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                                        <Label text="%admin.users.field.primaryRole" styleClass="field-label"/>
                                        <ComboBox fx:id="roleComboBox" prefWidth="180" styleClass="glass-combo"/>
                                    </VBox>
                                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                                        <Label text="%common.table.status" styleClass="field-label"/>
                                        <ComboBox fx:id="statusComboBox" prefWidth="180" styleClass="glass-combo"/>
                                    </VBox>
                                </HBox>

                                <HBox spacing="10">
                                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                                        <Label text="%admin.users.field.photoPath" styleClass="field-label"/>
                                        <TextField fx:id="photoField" promptText="%admin.users.prompt.photoPath" styleClass="form-text-field"/>
                                    </VBox>
                                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                                        <Label text="%admin.users.field.cvName" styleClass="field-label"/>
                                        <TextField fx:id="cvField" promptText="%admin.users.prompt.cvName" styleClass="form-text-field"/>
                                    </VBox>
                                </HBox>

                                <VBox spacing="6">
                                    <Label text="%common.field.newPassword" styleClass="field-label"/>
                                    <PasswordField fx:id="passwordField"
                                                   promptText="%common.prompt.keepPassword"
                                                   styleClass="form-text-field"/>
                                </VBox>

                                <VBox spacing="6">
                                    <Label text="%common.field.confirmPassword" styleClass="field-label"/>
                                    <PasswordField fx:id="confirmPasswordField"
                                                   promptText="%common.prompt.confirmPassword"
                                                   styleClass="form-text-field"/>
                                </VBox>

                                <Label text="%admin.users.passwordNote"
                                       wrapText="true"
                                       styleClass="admin-user-note"/>

                                <HBox spacing="10" styleClass="admin-user-form-actions">
                                    <Button fx:id="registerFaceBtn"
                                            onAction="#handleRegisterFace"
                                            text="Register Face"
                                            maxWidth="Infinity"
                                            styleClass="primary-button"
                                            HBox.hgrow="ALWAYS"/>
                                    <Button fx:id="deleteFaceBtn"
                                            onAction="#handleDeleteFace"
                                            text="Delete Face"
                                            maxWidth="Infinity"
                                            styleClass="danger-button"
                                            HBox.hgrow="ALWAYS"/>
                                </HBox>

                                <HBox spacing="10" styleClass="admin-user-form-actions">
                                    <Button fx:id="saveButton"
                                            onAction="#handleSave"
                                            text="%common.action.saveChanges"
                                            maxWidth="Infinity"
                                            styleClass="primary-button"
                                            HBox.hgrow="ALWAYS"/>
                                    <Button fx:id="deleteButton"
                                            onAction="#handleDelete"
                                            text="%admin.users.action.delete"
                                            maxWidth="Infinity"
                                            styleClass="danger-button"
                                            HBox.hgrow="ALWAYS"/>
                                </HBox>

                                <Button onAction="#handleClear"
                                        text="%common.action.clearSelection"
                                        maxWidth="Infinity"
                                        styleClass="ghost-button"/>
                            </VBox>
                        </HBox>
                    </VBox>
                </StackPane>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
