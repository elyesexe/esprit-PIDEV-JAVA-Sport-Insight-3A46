<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.media.MediaView?>
<?import javafx.scene.web.WebView?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.esprit.Controller.MatchDetailController"
            styleClass="page-root">
    <top>
        <HBox fx:id="navbarRoot" alignment="CENTER_LEFT" spacing="16" styleClass="navbar-root" BorderPane.alignment="CENTER">
            <padding>
                <Insets top="10" right="20" bottom="10" left="20"/>
            </padding>

            <Button fx:id="adminNavButton"
                    onAction="#handleOpenAdmin"
                    text="Admin"
                    mnemonicParsing="false"
                    styleClass="navbar-admin-button"/>

            <HBox fx:id="sidebarBrandBox" alignment="CENTER_LEFT" spacing="10" styleClass="navbar-brand" onMouseClicked="#handleOpenHome">
                <StackPane styleClass="navbar-logo-shell">
                    <ImageView fitWidth="152" fitHeight="50" preserveRatio="true" smooth="true">
                        <image>
                            <Image url="@../images/sport-insight-logo.png"/>
                        </image>
                    </ImageView>
                </StackPane>
            </HBox>

            <StackPane HBox.hgrow="ALWAYS" styleClass="navbar-center-wrap">
                <HBox alignment="CENTER" spacing="9" styleClass="navbar-modules">
                    <Button fx:id="matchsNavButton"
                            onAction="#handleOpenMatchs"
                            text="Matchs"
                            styleClass="navbar-nav-button"/>
                    <HBox fx:id="sidebarModuleChildrenBox"
                          spacing="8"
                          alignment="CENTER"
                          managed="false"
                          visible="false"
                          styleClass="navbar-submenu">
                        <Button fx:id="equipesNavButton"
                                onAction="#handleOpenEquipes"
                                text="Equipes"
                                styleClass="navbar-nav-button navbar-submenu-button"/>
                        <Button fx:id="leaguesNavButton"
                                onAction="#handleOpenLeagues"
                                text="Leagues"
                                styleClass="navbar-nav-button navbar-submenu-button"/>
                        <Button fx:id="joueursNavButton"
                                onAction="#handleOpenJoueurs"
                                text="Joueurs"
                                styleClass="navbar-nav-button navbar-submenu-button"/>
                    </HBox>
                    <Button fx:id="annonceNavButton"
                            onAction="#handleOpenAnnonces"
                            text="Anonce"
                            styleClass="navbar-nav-button"/>
                </HBox>
            </StackPane>

            <HBox alignment="CENTER_RIGHT" styleClass="navbar-theme-wrap">
                <ToggleButton fx:id="themeToggleButton"
                              mnemonicParsing="false"
                              contentDisplay="GRAPHIC_ONLY"
                              styleClass="theme-toggle">
                    <graphic>
                        <StackPane styleClass="theme-toggle-track">
                            <StackPane styleClass="theme-toggle-thumb">
                                <StackPane styleClass="theme-toggle-icon-shell">
                                    <Label text="â˜€" styleClass="theme-toggle-icon theme-toggle-sun"/>
                                    <Label text="â˜¾" styleClass="theme-toggle-icon theme-toggle-moon"/>
                                </StackPane>
                            </StackPane>
                        </StackPane>
                    </graphic>
                </ToggleButton>
            </HBox>
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true"
                    hbarPolicy="NEVER"
                    pannable="true"
                    styleClass="page-scroll"
                    BorderPane.alignment="CENTER">
            <content>
                <StackPane styleClass="page-shell-wrap">
                    <VBox spacing="12" maxWidth="1020.0" styleClass="page-shell flashscore-match-shell">
                        <padding>
                            <Insets top="16" right="18" bottom="20" left="18"/>
                        </padding>

                        <VBox spacing="10" styleClass="panel-card flashscore-score-card">
                            <HBox alignment="CENTER_LEFT" spacing="10">
                                <Label fx:id="competitionBadgeLabel" text="Competition" styleClass="toolbar-chip"/>
                                <Label fx:id="detailStatusChipLabel" text="Programme" styleClass="status-pill status-warning"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label fx:id="apiFootballStatusLabel" text="Chargement..." styleClass="status-pill status-muted"/>
                                <Button onAction="#handleBack" text="Retour" styleClass="ghost-button"/>
                            </HBox>

                            <VBox spacing="3" styleClass="flashscore-title-block">
                                <Label fx:id="detailTitleLabel" text="Chargement du match..." styleClass="flashscore-match-title"/>
                                <Label fx:id="detailSubtitleLabel"
                                       text="Presentation compacte inspiree des pages de match Flashscore."
                                       wrapText="true"
                                       styleClass="flashscore-match-subtitle"/>
                            </VBox>

                            <HBox alignment="CENTER" spacing="18" styleClass="flashscore-scoreboard">
                                <VBox alignment="CENTER" spacing="7" HBox.hgrow="ALWAYS" styleClass="flashscore-team-column">
                                    <StackPane styleClass="flashscore-logo-shell">
                                        <ImageView fx:id="detailHomeLogoView"
                                                   fitWidth="118"
                                                   fitHeight="118"
                                                   preserveRatio="true"
                                                   managed="false"
                                                   visible="false"/>
                                        <Label fx:id="detailHomeLogoFallbackLabel"
                                               text="D"
                                               styleClass="match-detail-logo-fallback"/>
                                    </StackPane>
                                    <Label fx:id="detailHomeNameLabel" text="Equipe domicile" wrapText="true" styleClass="flashscore-team-name"/>
                                    <Label text="Domicile" styleClass="flashscore-team-role"/>
                                </VBox>

                                <VBox alignment="CENTER" spacing="6" styleClass="flashscore-center-column">
                                    <Label fx:id="detailDateValueLabel" text="-" styleClass="flashscore-kickoff-date"/>
                                    <Label fx:id="detailHeureValueLabel" text="-" styleClass="flashscore-kickoff-time"/>
                                    <Label fx:id="detailScoreValueLabel" text="- : -" styleClass="flashscore-main-score"/>
                                    <Label fx:id="detailLivePhaseLabel"
                                           text="EN DIRECT"
                                           managed="false"
                                           visible="false"
                                           styleClass="flashscore-live-phase"/>
                                    <Label fx:id="detailLiveMinuteLabel"
                                           text="75'"
                                           managed="false"
                                           visible="false"
                                           styleClass="flashscore-live-minute"/>
                                    <Label fx:id="detailLieuValueLabel" text="Non renseigne" wrapText="true" styleClass="flashscore-venue-label"/>
                                </VBox>

                                <VBox alignment="CENTER" spacing="7" HBox.hgrow="ALWAYS" styleClass="flashscore-team-column">
                                    <StackPane styleClass="flashscore-logo-shell">
                                        <ImageView fx:id="detailAwayLogoView"
                                                   fitWidth="118"
                                                   fitHeight="118"
                                                   preserveRatio="true"
                                                   managed="false"
                                                   visible="false"/>
                                        <Label fx:id="detailAwayLogoFallbackLabel"
                                               text="E"
                                               styleClass="match-detail-logo-fallback"/>
                                    </StackPane>
                                    <Label fx:id="detailAwayNameLabel" text="Equipe exterieur" wrapText="true" styleClass="flashscore-team-name"/>
                                    <Label text="Exterieur" styleClass="flashscore-team-role"/>
                                </VBox>
                            </HBox>

                            <HBox spacing="8" styleClass="flashscore-facts-row">
                                <VBox HBox.hgrow="ALWAYS" styleClass="flashscore-fact-chip">
                                    <Label text="Competition" styleClass="flashscore-fact-caption"/>
                                    <Label fx:id="detailCompetitionValueLabel" text="Non renseignee" styleClass="flashscore-fact-value"/>
                                </VBox>
                                <VBox HBox.hgrow="ALWAYS" styleClass="flashscore-fact-chip">
                                    <Label text="Type match" styleClass="flashscore-fact-caption"/>
                                    <Label fx:id="detailTypeValueLabel" text="Non renseigne" styleClass="flashscore-fact-value"/>
                                </VBox>
                                <VBox HBox.hgrow="ALWAYS" styleClass="flashscore-fact-chip">
                                    <Label text="Fiche" styleClass="flashscore-fact-caption"/>
                                    <Label fx:id="detailIdValueLabel" text="Match" styleClass="flashscore-fact-value"/>
                                </VBox>
                                <VBox HBox.hgrow="ALWAYS" styleClass="flashscore-fact-chip">
                                    <Label text="Statut" styleClass="flashscore-fact-caption"/>
                                    <Label fx:id="detailStatutValueLabel" text="Programme" styleClass="flashscore-fact-value"/>
                                </VBox>
                            </HBox>

                            <HBox spacing="8" alignment="CENTER_LEFT" styleClass="match-follow-toolbar">
                                <Label text="Live alerts" styleClass="flashscore-inline-badge"/>
                                <Button fx:id="followMatchButton"
                                        onAction="#handleToggleFollowMatch"
                                        text="Follow match"
                                        styleClass="soft-button"/>
                                <Button fx:id="followHomeTeamButton"
                                        onAction="#handleToggleFollowHomeTeam"
                                        text="Follow home team"
                                        styleClass="soft-button"/>
                                <Button fx:id="followAwayTeamButton"
                                        onAction="#handleToggleFollowAwayTeam"
                                        text="Follow away team"
                                        styleClass="soft-button"/>
                                <Button fx:id="followCompetitionButton"
                                        onAction="#handleToggleFollowCompetition"
                                        text="Follow competition"
                                        styleClass="ghost-button"/>
                            </HBox>
                        </VBox>

                        <HBox spacing="8" styleClass="detail-tabs-row">
                            <Button fx:id="summaryTabButton"
                                    onAction="#handleShowSummaryTab"
                                    text="Resume"
                                    styleClass="detail-tab-button detail-tab-button-active"/>
                            <Button fx:id="statsTabButton"
                                    onAction="#handleShowStatsTab"
                                    text="Statistiques"
                                    styleClass="detail-tab-button"/>
                            <Button fx:id="lineupTabButton"
                                    onAction="#handleShowLineupTab"
                                    text="Compositions"
                                    styleClass="detail-tab-button"/>
                            <Button fx:id="videosTabButton"
                                    onAction="#handleShowVideosTab"
                                    text="Videos"
                                    styleClass="detail-tab-button"/>
                        </HBox>

                        <VBox fx:id="summarySection" spacing="8" styleClass="panel-card flashscore-summary-card">
                            <HBox alignment="CENTER_LEFT" spacing="10">
                                <Label text="Resume du match" styleClass="section-title flashscore-section-title"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label text="Timeline" styleClass="flashscore-inline-badge"/>
                            </HBox>

                            <HBox alignment="CENTER" spacing="14" styleClass="summary-teams-header">
                                <Label fx:id="summaryHomeTeamLabel" text="Domicile" styleClass="summary-team-header"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label text="Evenements" styleClass="summary-center-header"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label fx:id="summaryAwayTeamLabel" text="Exterieur" styleClass="summary-team-header"/>
                            </HBox>

                            <Label fx:id="summaryEmptyLabel"
                                   text="Aucun resume detaille disponible pour ce match."
                                   wrapText="true"
                                   styleClass="section-subtitle"/>

                            <VBox fx:id="summaryTimelineContainer" spacing="6"/>
                        </VBox>

                        <VBox fx:id="lineupSection" spacing="10" styleClass="panel-card flashscore-lineup-card" visible="false" managed="false">
                            <HBox alignment="CENTER_LEFT" spacing="10">
                                <Label text="Compositions" styleClass="section-title flashscore-section-title"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label text="Vue terrain" styleClass="flashscore-inline-badge"/>
                            </HBox>

                            <HBox spacing="16" styleClass="lineup-summary-row">
                                <VBox spacing="6" HBox.hgrow="ALWAYS" styleClass="lineup-summary-team">
                                    <HBox alignment="CENTER_LEFT" spacing="10">
                                        <Label fx:id="lineupHomeTeamLabel" text="Equipe domicile" styleClass="pitch-team-title"/>
                                        <Label text="Domicile" styleClass="pitch-side-badge"/>
                                    </HBox>
                                    <Label fx:id="lineupDomicileMetaLabel"
                                           text="Formation indisponible"
                                           wrapText="true"
                                           styleClass="section-subtitle lineup-meta"/>
                                </VBox>
                                <VBox spacing="6" alignment="CENTER_RIGHT" HBox.hgrow="ALWAYS" styleClass="lineup-summary-team lineup-summary-team-away">
                                    <HBox alignment="CENTER_RIGHT" spacing="10">
                                        <Label text="Exterieur" styleClass="pitch-side-badge"/>
                                        <Label fx:id="lineupAwayTeamLabel" text="Equipe exterieur" styleClass="pitch-team-title"/>
                                    </HBox>
                                    <Label fx:id="lineupExterieurMetaLabel"
                                           text="Formation indisponible"
                                           wrapText="true"
                                           styleClass="section-subtitle lineup-meta lineup-meta-away"/>
                                </VBox>
                            </HBox>

                            <HBox spacing="0" styleClass="pitch-board">
                                <Pane fx:id="homeLineupPitchContainer"
                                      HBox.hgrow="ALWAYS"
                                      minHeight="500.0"
                                      prefHeight="500.0"
                                      maxWidth="1.7976931348623157E308"
                                      styleClass="pitch-half-pane pitch-half-home"/>
                                <Pane fx:id="awayLineupPitchContainer"
                                      HBox.hgrow="ALWAYS"
                                      minHeight="500.0"
                                      prefHeight="500.0"
                                      maxWidth="1.7976931348623157E308"
                                      styleClass="pitch-half-pane pitch-half-away"/>
                            </HBox>

                            <HBox spacing="18">
                                <VBox spacing="10" HBox.hgrow="ALWAYS" styleClass="bench-column">
                                    <Label text="Remplacants domicile" styleClass="bench-title"/>
                                    <FlowPane fx:id="homeBenchContainer" hgap="8" vgap="8" prefWrapLength="420"/>
                                </VBox>
                                <VBox spacing="10" HBox.hgrow="ALWAYS" styleClass="bench-column">
                                    <Label text="Remplacants exterieur" styleClass="bench-title"/>
                                    <FlowPane fx:id="awayBenchContainer" hgap="8" vgap="8" prefWrapLength="420"/>
                                </VBox>
                            </HBox>
                        </VBox>

                        <VBox fx:id="statsSection" spacing="8" styleClass="panel-card flashscore-stats-card" visible="false" managed="false">
                            <HBox alignment="CENTER_LEFT" spacing="10">
                                <Label text="Statistiques du match" styleClass="section-title flashscore-section-title"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label text="Comparaison" styleClass="flashscore-inline-badge"/>
                            </HBox>

                            <HBox alignment="CENTER" spacing="14" styleClass="stats-teams-header">
                                <Label fx:id="statsHomeTeamLabel" text="Domicile" styleClass="stats-team-header"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label text="Match" styleClass="stats-center-header"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label fx:id="statsAwayTeamLabel" text="Exterieur" styleClass="stats-team-header"/>
                            </HBox>

                            <Label fx:id="matchStatsEmptyLabel"
                                   text="Aucune statistique detaillee disponible pour ce match."
                                   wrapText="true"
                                   styleClass="section-subtitle"/>

                            <VBox fx:id="matchStatsContainer" spacing="12"/>
                        </VBox>

                        <VBox fx:id="videosSection" spacing="10" styleClass="panel-card flashscore-videos-card" visible="false" managed="false">
                            <HBox alignment="CENTER_LEFT" spacing="10">
                                <VBox spacing="4" HBox.hgrow="ALWAYS">
                                    <Label text="YouTube Highlights" styleClass="section-title flashscore-section-title"/>
                                    <Label fx:id="youtubeMatchInfoLabel"
                                           text="Match | Status"
                                           wrapText="true"
                                           styleClass="section-subtitle match-video-status"/>
                                </VBox>
                                <Button fx:id="refreshVideosButton"
                                        onAction="#handleRefreshVideos"
                                        text="Load Highlights"
                                        styleClass="ghost-button"/>
                                <Button fx:id="localMp4DemoButton"
                                        onAction="#handleOpenLocalMp4Demo"
                                        text="Local MP4 demo"
                                        styleClass="ghost-button"/>
                            </HBox>

                            <Label fx:id="matchVideoStatusLabel"
                                   text="Click Load Highlights to search YouTube."
                                   wrapText="true"
                                   styleClass="section-subtitle match-video-status"/>

                            <HBox spacing="14" fillHeight="true" styleClass="match-video-sources-row">
                                <VBox spacing="8" prefWidth="320.0" maxWidth="360.0" HBox.hgrow="NEVER" styleClass="match-video-source-column">
                                    <Label text="YouTube videos" styleClass="match-video-column-title"/>
                                    <ListView fx:id="youtubeVideoListView"
                                              prefHeight="460.0"
                                              styleClass="match-video-source-scroll"/>
                                </VBox>

                                <VBox spacing="12" HBox.hgrow="ALWAYS" styleClass="match-video-player-card">
                                    <HBox alignment="CENTER_LEFT" spacing="10">
                                        <VBox spacing="4" HBox.hgrow="ALWAYS">
                                            <Label fx:id="selectedVideoTitleLabel"
                                                   text="No video selected"
                                                   styleClass="match-video-player-title"/>
                                            <Label fx:id="selectedVideoMetaLabel"
                                                   text="YouTube videos play inside the embedded Chromium player."
                                                   wrapText="true"
                                                   styleClass="match-video-player-meta"/>
                                        </VBox>
                                        <Button fx:id="fullscreenVideoButton"
                                                onAction="#handleOpenVideoFullscreen"
                                                text="Plein ecran"
                                                styleClass="ghost-button"
                                                disable="true"/>
                                        <Button fx:id="inAppYouTubePlayerButton"
                                                onAction="#handleOpenSelectedVideoInApp"
                                                text="Reload in-app player"
                                                styleClass="ghost-button"
                                                managed="false"
                                                visible="false"
                                                disable="true"/>
                                    </HBox>

                                    <StackPane fx:id="matchVideoPlayerShell" styleClass="match-video-player-shell" VBox.vgrow="ALWAYS">
                                        <StackPane fx:id="chromiumPlayerHost"
                                                   minHeight="420.0"
                                                   prefHeight="460.0"
                                                   managed="false"
                                                   visible="false"/>
                                        <MediaView fx:id="localDemoMediaView"
                                                   fitHeight="460.0"
                                                   fitWidth="820.0"
                                                   preserveRatio="true"
                                                   managed="false"
                                                   visible="false"/>
                                        <WebView fx:id="matchVideoWebView"
                                                 minHeight="420.0"
                                                 prefHeight="460.0"
                                                 managed="false"
                                                 visible="false"/>
                                        <VBox fx:id="matchVideoEmptyStateBox"
                                              alignment="CENTER"
                                              spacing="8"
                                              styleClass="match-video-empty-state">
                                            <Label fx:id="matchVideoEmptyTitleLabel"
                                                   text="No video selected"
                                                   styleClass="match-video-empty-title"/>
                                            <Label fx:id="matchVideoEmptyBodyLabel"
                                                   text="YouTube highlights will appear here after the match is finished."
                                                   wrapText="true"
                                                   styleClass="match-video-empty-body"/>
                                        </VBox>
                                    </StackPane>
                                </VBox>
                            </HBox>
                        </VBox>
                    </VBox>
                </StackPane>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
