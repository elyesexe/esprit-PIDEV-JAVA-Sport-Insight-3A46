<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.esprit.Controller.MatchDetailController"
            styleClass="page-root">
    <top>
        <HBox fx:id="navbarRoot" alignment="CENTER_LEFT" spacing="16" styleClass="navbar-root" BorderPane.alignment="CENTER">
            <padding>
                <Insets top="10" right="20" bottom="10" left="20"/>
            </padding>

            <Button fx:id="adminNavButton"
                    onAction="#handleOpenAdmin"
                    text="Admin"
                    mnemonicParsing="false"
                    styleClass="navbar-admin-button"/>

            <HBox fx:id="sidebarBrandBox" alignment="CENTER_LEFT" spacing="10" styleClass="navbar-brand" onMouseClicked="#handleOpenHome">
                <StackPane styleClass="navbar-logo-shell">
                    <ImageView fitWidth="152" fitHeight="50" preserveRatio="true" smooth="true">
                        <image>
                            <Image url="@../images/sport-insight-logo.png"/>
                        </image>
                    </ImageView>
                </StackPane>
            </HBox>

            <StackPane HBox.hgrow="ALWAYS" styleClass="navbar-center-wrap">
                <HBox alignment="CENTER" spacing="9" styleClass="navbar-modules">
                    <Button fx:id="matchsNavButton"
                            onAction="#handleOpenMatchs"
                            text="Matchs"
                            styleClass="navbar-nav-button"/>
                    <HBox fx:id="sidebarModuleChildrenBox"
                          spacing="8"
                          alignment="CENTER"
                          managed="false"
                          visible="false"
                          styleClass="navbar-submenu">
                        <Button fx:id="equipesNavButton"
                                onAction="#handleOpenEquipes"
                                text="Equipes"
                                styleClass="navbar-nav-button navbar-submenu-button"/>
                        <Button fx:id="leaguesNavButton"
                                onAction="#handleOpenLeagues"
                                text="Leagues"
                                styleClass="navbar-nav-button navbar-submenu-button"/>
                        <Button fx:id="joueursNavButton"
                                onAction="#handleOpenJoueurs"
                                text="Joueurs"
                                styleClass="navbar-nav-button navbar-submenu-button"/>
                    </HBox>
                </HBox>
            </StackPane>

            <HBox alignment="CENTER_RIGHT" styleClass="navbar-theme-wrap">
                <ToggleButton fx:id="themeToggleButton"
                              mnemonicParsing="false"
                              contentDisplay="GRAPHIC_ONLY"
                              styleClass="theme-toggle">
                    <graphic>
                        <StackPane styleClass="theme-toggle-track">
                            <StackPane styleClass="theme-toggle-thumb">
                                <StackPane styleClass="theme-toggle-icon-shell">
                                    <Label text="☀" styleClass="theme-toggle-icon theme-toggle-sun"/>
                                    <Label text="☾" styleClass="theme-toggle-icon theme-toggle-moon"/>
                                </StackPane>
                            </StackPane>
                        </StackPane>
                    </graphic>
                </ToggleButton>
            </HBox>
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true"
                    hbarPolicy="NEVER"
                    pannable="true"
                    styleClass="page-scroll"
                    BorderPane.alignment="CENTER">
            <content>
                <VBox spacing="18" styleClass="page-shell">
                    <padding>
                        <Insets top="24" right="28" bottom="28" left="28"/>
                    </padding>

                    <StackPane styleClass="hero-shell">
                        <StackPane styleClass="hero-photo"/>
                        <StackPane styleClass="hero-overlay"/>
                        <VBox spacing="14" styleClass="hero-content">
                            <Label text="Fiche Match" styleClass="hero-eyebrow"/>
                            <Label fx:id="detailTitleLabel" text="Chargement du match..." styleClass="hero-title"/>
                            <Label fx:id="detailSubtitleLabel"
                                   text="Consultez toutes les informations du match sur une page detail en lecture seule."
                                   wrapText="true"
                                   styleClass="hero-text"/>
                        </VBox>
                    </StackPane>

                    <VBox spacing="18" styleClass="panel-card detail-card">
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <Label fx:id="competitionBadgeLabel" text="Competition" styleClass="toolbar-chip"/>
                            <Label fx:id="detailStatusChipLabel" text="Programme" styleClass="status-pill status-warning"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button onAction="#handleBack" text="Retour" styleClass="ghost-button"/>
                            <Label text="Lecture seule" styleClass="toolbar-chip-soft"/>
                        </HBox>

                        <HBox spacing="14" alignment="CENTER" styleClass="match-detail-board">
                            <VBox alignment="CENTER" spacing="10" HBox.hgrow="ALWAYS" styleClass="match-detail-team-shell">
                                <StackPane styleClass="match-detail-logo-shell">
                                    <ImageView fx:id="detailHomeLogoView"
                                               fitWidth="88"
                                               fitHeight="88"
                                               preserveRatio="true"
                                               managed="false"
                                               visible="false"/>
                                    <Label fx:id="detailHomeLogoFallbackLabel"
                                           text="D"
                                           styleClass="match-detail-logo-fallback"/>
                                </StackPane>
                                <Label fx:id="detailHomeNameLabel" text="Equipe domicile" wrapText="true" styleClass="match-detail-team-name"/>
                                <Label text="Domicile" styleClass="match-detail-team-role"/>
                            </VBox>

                            <VBox alignment="CENTER" spacing="6" styleClass="match-detail-score-shell">
                                <Label fx:id="detailScoreValueLabel" text="- : -" styleClass="match-detail-score"/>
                                <Label text="Score" styleClass="match-detail-score-caption"/>
                            </VBox>

                            <VBox alignment="CENTER" spacing="10" HBox.hgrow="ALWAYS" styleClass="match-detail-team-shell">
                                <StackPane styleClass="match-detail-logo-shell">
                                    <ImageView fx:id="detailAwayLogoView"
                                               fitWidth="88"
                                               fitHeight="88"
                                               preserveRatio="true"
                                               managed="false"
                                               visible="false"/>
                                    <Label fx:id="detailAwayLogoFallbackLabel"
                                           text="E"
                                           styleClass="match-detail-logo-fallback"/>
                                </StackPane>
                                <Label fx:id="detailAwayNameLabel" text="Equipe exterieur" wrapText="true" styleClass="match-detail-team-name"/>
                                <Label text="Exterieur" styleClass="match-detail-team-role"/>
                            </VBox>
                        </HBox>

                        <HBox spacing="10">
                            <VBox HBox.hgrow="ALWAYS" styleClass="stat-chip">
                                <Label text="Date" styleClass="stat-caption"/>
                                <Label fx:id="detailDateValueLabel" text="-" styleClass="stat-value"/>
                            </VBox>
                            <VBox HBox.hgrow="ALWAYS" styleClass="stat-chip">
                                <Label text="Heure" styleClass="stat-caption"/>
                                <Label fx:id="detailHeureValueLabel" text="-" styleClass="stat-value"/>
                            </VBox>
                            <VBox HBox.hgrow="ALWAYS" styleClass="stat-chip">
                                <Label text="Lieu" styleClass="stat-caption"/>
                                <Label fx:id="detailLieuValueLabel" text="Non renseigne" styleClass="stat-value"/>
                            </VBox>
                        </HBox>

                        <HBox spacing="10">
                            <VBox HBox.hgrow="ALWAYS" styleClass="stat-chip">
                                <Label text="Type match" styleClass="stat-caption"/>
                                <Label fx:id="detailTypeValueLabel" text="Non renseigne" styleClass="stat-value"/>
                            </VBox>
                            <VBox HBox.hgrow="ALWAYS" styleClass="stat-chip">
                                <Label text="Competition" styleClass="stat-caption"/>
                                <Label fx:id="detailCompetitionValueLabel" text="Non renseignee" styleClass="stat-value"/>
                            </VBox>
                            <VBox HBox.hgrow="ALWAYS" styleClass="stat-chip">
                                <Label text="Reference" styleClass="stat-caption"/>
                                <Label fx:id="detailIdValueLabel" text="-" styleClass="stat-value"/>
                            </VBox>
                        </HBox>

                        <HBox spacing="10">
                            <VBox HBox.hgrow="ALWAYS" styleClass="stat-chip">
                                <Label text="Statut" styleClass="stat-caption"/>
                                <Label fx:id="detailStatutValueLabel" text="Programme" styleClass="stat-value"/>
                            </VBox>
                        </HBox>
                    </VBox>

                    <HBox spacing="18">
                        <VBox spacing="10" HBox.hgrow="ALWAYS" styleClass="panel-card lineup-panel">
                            <Label text="Onze de depart domicile" styleClass="section-title lineup-title"/>
                            <TextArea fx:id="lineupDomicileArea"
                                      editable="false"
                                      focusTraversable="false"
                                      wrapText="true"
                                      prefRowCount="8"
                                      styleClass="lineup-readonly-area"/>
                        </VBox>
                        <VBox spacing="10" HBox.hgrow="ALWAYS" styleClass="panel-card lineup-panel">
                            <Label text="Onze de depart exterieur" styleClass="section-title lineup-title"/>
                            <TextArea fx:id="lineupExterieurArea"
                                      editable="false"
                                      focusTraversable="false"
                                      wrapText="true"
                                      prefRowCount="8"
                                      styleClass="lineup-readonly-area"/>
                        </VBox>
                    </HBox>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
