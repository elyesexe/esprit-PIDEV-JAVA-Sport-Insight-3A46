<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.esprit.Controller.ProfileController"
            styleClass="page-root">

    <top>
        <HBox fx:id="navbarRoot"
              alignment="CENTER_LEFT"
              spacing="16"
              styleClass="navbar-root"
              BorderPane.alignment="CENTER">
            <padding>
                <Insets top="10" right="20" bottom="10" left="20"/>
            </padding>

            <Button fx:id="adminNavButton"
                    onAction="#handleOpenAdmin"
                    text="%nav.admin"
                    mnemonicParsing="false"
                    styleClass="navbar-admin-button"/>

            <HBox fx:id="sidebarBrandBox"
                  alignment="CENTER_LEFT"
                  spacing="10"
                  styleClass="navbar-brand"
                  onMouseClicked="#handleOpenHome">
                <StackPane styleClass="navbar-logo-shell">
                    <ImageView fitWidth="152" fitHeight="50" preserveRatio="true" smooth="true">
                        <image>
                            <Image url="@../images/sport-insight-logo.png"/>
                        </image>
                    </ImageView>
                </StackPane>
            </HBox>

            <StackPane HBox.hgrow="ALWAYS" styleClass="navbar-center-wrap">
                <HBox alignment="CENTER" spacing="9" styleClass="navbar-modules">
                    <Button fx:id="matchsNavButton"
                            onAction="#handleOpenMatchs"
                            text="%nav.matches.plus"
                            styleClass="navbar-nav-button"/>

                    <HBox fx:id="sidebarModuleChildrenBox"
                          spacing="8"
                          alignment="CENTER"
                          managed="false"
                          visible="false"
                          styleClass="navbar-submenu">
                        <Button fx:id="equipesNavButton"
                                onAction="#handleOpenEquipes"
                                text="%nav.teams"
                                styleClass="navbar-nav-button navbar-submenu-button"/>
                        <Button fx:id="leaguesNavButton"
                                onAction="#handleOpenLeagues"
                                text="%nav.leagues"
                                styleClass="navbar-nav-button navbar-submenu-button"/>
                        <Button fx:id="joueursNavButton"
                                onAction="#handleOpenJoueurs"
                                text="%nav.players"
                                styleClass="navbar-nav-button navbar-submenu-button"/>
                    </HBox>

                    <Button fx:id="annonceNavButton"
                            onAction="#handleOpenAnnonces"
                            text="%nav.announcements"
                            styleClass="navbar-nav-button"/>
                </HBox>
            </StackPane>

            <HBox alignment="CENTER_RIGHT" styleClass="navbar-theme-wrap">
                <ToggleButton fx:id="themeToggleButton"
                              mnemonicParsing="false"
                              contentDisplay="GRAPHIC_ONLY"
                              styleClass="theme-toggle">
                    <graphic>
                        <StackPane styleClass="theme-toggle-track">
                            <StackPane styleClass="theme-toggle-thumb">
                                <StackPane styleClass="theme-toggle-icon-shell">
                                    <Label text="&#9728;" styleClass="theme-toggle-icon theme-toggle-sun"/>
                                    <Label text="&#9790;" styleClass="theme-toggle-icon theme-toggle-moon"/>
                                </StackPane>
                            </StackPane>
                        </StackPane>
                    </graphic>
                </ToggleButton>
            </HBox>
        </HBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true"
                    hbarPolicy="NEVER"
                    pannable="true"
                    styleClass="page-scroll"
                    BorderPane.alignment="CENTER">
            <content>
                <StackPane styleClass="page-shell-wrap">
                    <VBox spacing="22" styleClass="page-shell profile-shell">
                        <padding>
                            <Insets top="18" right="20" bottom="28" left="20"/>
                        </padding>

                        <StackPane styleClass="profile-hero-card">
                            <VBox spacing="10" styleClass="profile-hero-content">
                                <Label text="%profile.hero.kicker" styleClass="home-kicker"/>
                                <Label text="%profile.hero.title" styleClass="profile-hero-title"/>
                                <Label text="%profile.hero.copy"
                                       wrapText="true"
                                       styleClass="profile-hero-copy"/>
                            </VBox>
                        </StackPane>

                        <HBox spacing="20" styleClass="profile-grid">
                            <VBox spacing="18" styleClass="profile-side-column">
                                <VBox spacing="16" alignment="TOP_CENTER" styleClass="panel-card profile-photo-card">
                                    <StackPane styleClass="profile-photo-shell">
                                        <ImageView fx:id="profileImageView"
                                                   fitWidth="180"
                                                   fitHeight="180"
                                                   managed="false"
                                                   pickOnBounds="true"
                                                   preserveRatio="true"
                                                   smooth="true"
                                                   visible="false"/>
                                        <StackPane fx:id="profileImageFallback" styleClass="profile-photo-fallback">
                                            <Label fx:id="profileInitialsLabel" text="SI" styleClass="profile-photo-initials"/>
                                        </StackPane>
                                    </StackPane>

                                    <VBox spacing="6" alignment="CENTER" styleClass="profile-identity-box">
                                        <Label fx:id="profileNameLabel" text="%profile.user.fallback" styleClass="profile-title"/>
                                        <Label fx:id="profileEmailLabel" text="%common.prompt.email" styleClass="profile-subtitle"/>
                                    </VBox>

                                    <HBox spacing="8" alignment="CENTER">
                                        <Label fx:id="roleValueLabel" text="%profile.role.user" styleClass="toolbar-chip"/>
                                        <Label fx:id="statusValueLabel" text="%common.status.active" styleClass="toolbar-chip-soft"/>
                                    </HBox>

                                    <Button onAction="#handleBrowsePhoto"
                                            text="%profile.photo.choose"
                                            maxWidth="Infinity"
                                            styleClass="ghost-button"/>
                                </VBox>

                                <VBox spacing="12" styleClass="panel-card profile-info-card">
                                    <Label text="%profile.account.title" styleClass="section-title"/>

                                    <VBox spacing="8">
                                        <Label text="%profile.account.memberSince" styleClass="field-label"/>
                                        <Label fx:id="memberSinceValueLabel" text="%common.value.unknown" styleClass="profile-info-value"/>
                                    </VBox>

                                    <VBox spacing="8">
                                        <Label text="%profile.account.roleAccess" styleClass="field-label"/>
                                        <Label text="%profile.account.roleAccessCopy"
                                               wrapText="true"
                                               styleClass="profile-note"/>
                                    </VBox>
                                </VBox>
                            </VBox>

                            <VBox spacing="16" styleClass="panel-card form-card profile-form-card" HBox.hgrow="ALWAYS">
                                <VBox spacing="6">
                                    <Label fx:id="formTitleLabel" text="%profile.form.title" styleClass="section-title"/>
                                    <Label fx:id="formSubtitleLabel"
                                           text="%profile.form.subtitle"
                                           wrapText="true"
                                           styleClass="section-subtitle"/>
                                </VBox>

                                <Label fx:id="statusLabel"
                                       managed="false"
                                       visible="false"
                                       wrapText="true"
                                       styleClass="status-pill"/>

                                <HBox spacing="12">
                                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                                        <Label text="%common.field.firstName" styleClass="field-label"/>
                                        <TextField fx:id="prenomField" promptText="%common.prompt.firstName" styleClass="form-text-field"/>
                                    </VBox>
                                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                                        <Label text="%common.field.lastName" styleClass="field-label"/>
                                        <TextField fx:id="nomField" promptText="%common.prompt.lastName" styleClass="form-text-field"/>
                                    </VBox>
                                </HBox>

                                <VBox spacing="6">
                                    <Label text="%common.field.email" styleClass="field-label"/>
                                    <TextField fx:id="emailField" promptText="%common.prompt.email" styleClass="form-text-field"/>
                                </VBox>

                                <HBox spacing="12">
                                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                                        <Label text="%common.field.phone" styleClass="field-label"/>
                                        <TextField fx:id="telephoneField" promptText="%common.prompt.phone" styleClass="form-text-field"/>
                                    </VBox>
                                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                                        <Label text="%common.field.birthDate" styleClass="field-label"/>
                                        <DatePicker fx:id="dateNaissancePicker" styleClass="form-date-picker"/>
                                    </VBox>
                                </HBox>

                                <VBox spacing="6">
                                    <Label text="%profile.photo.path" styleClass="field-label"/>
                                    <TextField fx:id="photoPathField"
                                               promptText="%profile.photo.prompt"
                                               styleClass="form-text-field"/>
                                    <Label text="%profile.photo.help"
                                           wrapText="true"
                                           styleClass="profile-note"/>
                                </VBox>

                                <HBox spacing="12">
                                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                                        <Label text="%common.field.newPassword" styleClass="field-label"/>
                                        <PasswordField fx:id="passwordField"
                                                       promptText="%profile.password.prompt"
                                                       styleClass="form-text-field"/>
                                    </VBox>
                                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                                        <Label text="%common.field.confirmPassword" styleClass="field-label"/>
                                        <PasswordField fx:id="confirmPasswordField"
                                                       promptText="%common.prompt.confirmPassword"
                                                       styleClass="form-text-field"/>
                                    </VBox>
                                </HBox>

                                <VBox spacing="14" styleClass="favorite-manager-card">
                                    <VBox spacing="4">
                                        <Label text="%profile.alerts.title" styleClass="section-title"/>
                                        <Label fx:id="favouritesSummaryLabel"
                                               text="%profile.alerts.summary"
                                               wrapText="true"
                                               styleClass="section-subtitle"/>
                                    </VBox>

                                    <HBox spacing="12" alignment="BOTTOM_LEFT">
                                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                                            <Label text="%profile.alerts.followLeague" styleClass="field-label"/>
                                            <ComboBox fx:id="favouriteLeagueComboBox"
                                                      promptText="%profile.alerts.prompt.competition"
                                                      maxWidth="Infinity"
                                                      styleClass="glass-combo"/>
                                        </VBox>
                                                <Button fx:id="addFavouriteLeagueButton"
                                                        onAction="#handleAddFavouriteLeague"
                                                text="%profile.alerts.addLeague"
                                                styleClass="ghost-button"/>
                                    </HBox>

                                    <FlowPane fx:id="favouriteLeagueChipPane"
                                              hgap="8"
                                              vgap="8"
                                              prefWrapLength="640"/>

                                    <HBox spacing="12" alignment="BOTTOM_LEFT">
                                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                                            <Label text="%profile.alerts.followTeam" styleClass="field-label"/>
                                            <ComboBox fx:id="favouriteTeamComboBox"
                                                      promptText="%profile.alerts.prompt.team"
                                                      maxWidth="Infinity"
                                                      styleClass="glass-combo"/>
                                        </VBox>
                                        <Button fx:id="addFavouriteTeamButton"
                                                onAction="#handleAddFavouriteTeam"
                                                text="%profile.alerts.addTeam"
                                                styleClass="ghost-button"/>
                                    </HBox>

                                    <FlowPane fx:id="favouriteTeamChipPane"
                                              hgap="8"
                                              vgap="8"
                                              prefWrapLength="640"/>

                                    <VBox spacing="10" styleClass="favorite-match-section">
                                        <VBox spacing="4">
                                            <Label text="%profile.alerts.favoriteMatches" styleClass="field-label"/>
                                            <Label text="%profile.alerts.favoriteMatchesHelp"
                                                   wrapText="true"
                                                   styleClass="profile-note"/>
                                        </VBox>

                                        <FlowPane fx:id="favouriteMatchChipPane"
                                                  hgap="8"
                                                  vgap="8"
                                                  prefWrapLength="640"/>

                                        <VBox spacing="8">
                                            <Label text="%profile.alerts.suggestedMatches" styleClass="field-label"/>
                                            <VBox fx:id="matchSuggestionContainer"
                                                  spacing="8"
                                                  fillWidth="true"/>
                                        </VBox>
                                    </VBox>
                                </VBox>

                                <Button fx:id="saveButton"
                                        onAction="#handleSaveProfile"
                                        text="%profile.save"
                                        maxWidth="Infinity"
                                        styleClass="primary-button"/>
                            </VBox>
                        </HBox>
                    </VBox>
                </StackPane>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
