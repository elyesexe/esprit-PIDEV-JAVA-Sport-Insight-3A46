<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="tn.esprit.Controller.FaceLoginController"
           styleClass="page-root auth-page-root auth-feature-root">
    <Region styleClass="auth-scene-backdrop"/>

    <BorderPane styleClass="auth-layout">
        <top>
            <HBox alignment="CENTER_LEFT" spacing="16" styleClass="auth-topbar" BorderPane.alignment="CENTER">
                <padding>
                    <Insets top="14" right="24" bottom="8" left="24"/>
                </padding>
                <StackPane styleClass="auth-logo-shell">
                    <ImageView fitWidth="156" fitHeight="52" preserveRatio="true" smooth="true">
                        <image>
                            <Image url="@../images/sport-insight-logo.png"/>
                        </image>
                    </ImageView>
                </StackPane>
                <Region HBox.hgrow="ALWAYS"/>
            </HBox>
        </top>

        <center>
            <StackPane styleClass="auth-feature-center">
                <VBox alignment="CENTER" spacing="16" maxWidth="660" styleClass="auth-feature-card auth-face-card">
                    <VBox alignment="CENTER" spacing="6" styleClass="auth-feature-heading">
                        <Label text="Face authentication" styleClass="auth-form-title"/>
                        <Label text="Look at the camera to continue to Sport Insight."
                               wrapText="true"
                               textAlignment="CENTER"
                               styleClass="auth-form-copy"/>
                    </VBox>

                    <StackPane maxWidth="560" maxHeight="420" styleClass="auth-camera-frame">
                        <ImageView fx:id="cameraPreview"
                                   fitWidth="560"
                                   fitHeight="420"
                                   preserveRatio="true"/>
                    </StackPane>

                    <Label fx:id="instructionLabel"
                           text="Centre your face within the frame"
                           wrapText="true"
                           textAlignment="CENTER"
                           styleClass="auth-form-copy"/>

                    <ProgressBar fx:id="confirmBar"
                                 prefWidth="560"
                                 prefHeight="8"
                                 progress="0"
                                 styleClass="auth-progress"/>

                    <Label fx:id="statusLabel"
                           text="Initialising camera..."
                           wrapText="true"
                           textAlignment="CENTER"
                           styleClass="auth-status-label status-muted"/>

                    <ProgressIndicator fx:id="spinner"
                                       prefWidth="30"
                                       prefHeight="30"
                                       styleClass="auth-spinner"/>

                    <HBox alignment="CENTER" spacing="12" styleClass="auth-actions">
                        <Button fx:id="retryBtn"
                                text="Try again"
                                onAction="#onRetry"
                                styleClass="auth-primary-button"/>
                        <Button fx:id="passwordBtn"
                                text="Use password instead"
                                onAction="#onPasswordLogin"
                                styleClass="auth-ghost-button"/>
                    </HBox>
                </VBox>
            </StackPane>
        </center>
    </BorderPane>
</StackPane>
