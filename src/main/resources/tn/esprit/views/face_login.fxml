<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.geometry.*?>

<!--
  face_login.fxml
  Controller: tn.esprit.Controller.FaceLoginController

  Place this file alongside your other FXML files, e.g.:
    src/main/resources/fxml/face_login.fxml

  Add a stylesheet link to your main CSS or inline styles below
  if you want to use your existing Sport Insight theme variables.
-->
<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="tn.esprit.Controller.FaceLoginController"
      alignment="CENTER"
      spacing="14"
      styleClass="face-auth-root"
      style="-fx-background-color: #1a1a2e; -fx-padding: 28;">

    <!-- Header -->
    <Label text="Sport Insight"
           style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #e0e0e0;"/>
    <Label text="Face Authentication"
           style="-fx-font-size: 13px; -fx-text-fill: #8a8aaa;"/>

    <!-- Camera frame -->
    <StackPane maxWidth="560" maxHeight="420"
               style="-fx-background-color: #0d0d1f;
                      -fx-border-color: #3a3a6e;
                      -fx-border-width: 2;
                      -fx-border-radius: 10;
                      -fx-background-radius: 10;">
        <ImageView fx:id="cameraPreview"
                   fitWidth="560" fitHeight="420"
                   preserveRatio="true"/>
    </StackPane>

    <!-- Instruction hint -->
    <Label fx:id="instructionLabel"
           text="Centre your face within the frame"
           style="-fx-font-size: 12px; -fx-text-fill: #8a8aaa;"/>

    <!-- Confirmation progress -->
    <ProgressBar fx:id="confirmBar"
                 prefWidth="560" prefHeight="7"
                 progress="0"
                 style="-fx-accent: #5865f2;"/>

    <!-- Status -->
    <Label fx:id="statusLabel"
           text="Initialising camera…"
           styleClass="status-muted"
           style="-fx-font-size: 13px;"/>

    <!-- Spinner (API call) -->
    <ProgressIndicator fx:id="spinner" prefWidth="30" prefHeight="30"/>

    <!-- Action buttons -->
    <HBox alignment="CENTER" spacing="14">
        <Button fx:id="retryBtn"
                text="Try Again"
                onAction="#onRetry"
                style="-fx-background-color: #5865f2;
                       -fx-text-fill: white;
                       -fx-font-size: 13px;
                       -fx-background-radius: 6;
                       -fx-padding: 7 22 7 22;"/>
        <Button fx:id="passwordBtn"
                text="Use Password Instead"
                onAction="#onPasswordLogin"
                style="-fx-background-color: transparent;
                       -fx-text-fill: #7289da;
                       -fx-font-size: 12px;
                       -fx-underline: true;"/>
    </HBox>

</VBox>
