<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="authRoot"
           xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="tn.esprit.Controller.LoginController"
           styleClass="page-root auth-page-root">

    <Region styleClass="auth-scene-backdrop"/>

    <BorderPane styleClass="auth-layout">

        <top>
            <HBox alignment="CENTER_LEFT" spacing="16" styleClass="auth-topbar" BorderPane.alignment="CENTER">
                <padding>
                    <Insets top="14" right="24" bottom="8" left="24"/>
                </padding>
                <StackPane styleClass="auth-logo-shell">
                    <ImageView fitWidth="156" fitHeight="52" preserveRatio="true" smooth="true">
                        <image>
                            <Image url="@../images/sport-insight-logo.png"/>
                        </image>
                    </ImageView>
                </StackPane>
                <Region HBox.hgrow="ALWAYS"/>
                <ToggleButton fx:id="themeToggleButton"
                              mnemonicParsing="false"
                              contentDisplay="GRAPHIC_ONLY"
                              styleClass="theme-toggle">
                    <graphic>
                        <StackPane styleClass="theme-toggle-track">
                            <StackPane styleClass="theme-toggle-thumb">
                                <StackPane styleClass="theme-toggle-icon-shell">
                                    <Label text="&#9728;" styleClass="theme-toggle-icon theme-toggle-sun"/>
                                    <Label text="&#9790;" styleClass="theme-toggle-icon theme-toggle-moon"/>
                                </StackPane>
                            </StackPane>
                        </StackPane>
                    </graphic>
                </ToggleButton>
            </HBox>
        </top>

        <center>
            <ScrollPane fx:id="authScrollPane"
                        fitToWidth="true"
                        hbarPolicy="NEVER"
                        styleClass="auth-scroll"
                        BorderPane.alignment="CENTER">
                <content>
                    <StackPane styleClass="page-shell-wrap">
                        <VBox spacing="18" styleClass="page-shell auth-shell">
                            <padding>
                                <Insets top="12" right="28" bottom="28" left="28"/>
                            </padding>

                            <!-- Hero banner -->
                            <StackPane styleClass="auth-hero">
                                <Region styleClass="auth-hero-glow auth-hero-glow-left"/>
                                <Region styleClass="auth-hero-glow auth-hero-glow-right"/>
                                <StackPane styleClass="auth-hero-card">
                                    <Region styleClass="auth-hero-photo"/>
                                    <Region styleClass="auth-hero-overlay"/>
                                    <VBox spacing="12" styleClass="auth-hero-content">
                                        <Label text="Authentication" styleClass="auth-eyebrow"/>
                                        <Label text="Welcome back to Sport Insight" styleClass="auth-hero-title"/>
                                        <Label text="Sign in to continue with matches, players, training sessions, and announcements."
                                               wrapText="true"
                                               styleClass="auth-hero-text"/>
                                    </VBox>
                                </StackPane>
                            </StackPane>

                            <!-- Main panel: aside + form -->
                            <HBox spacing="18" styleClass="auth-panel">

                                <!-- Left aside -->
                                <VBox spacing="16" styleClass="auth-panel-aside" HBox.hgrow="ALWAYS">
                                    <Label text="Secure access" styleClass="auth-panel-badge"/>
                                    <Label text="Sign in fast and keep control." wrapText="true" styleClass="auth-panel-title"/>
                                    <Label text="Use your account to sync your activity across the Sport Insight workspace."
                                           wrapText="true"
                                           styleClass="auth-panel-copy"/>
                                    <VBox spacing="10">
                                        <HBox spacing="10" alignment="CENTER_LEFT" styleClass="auth-point">
                                            <Region styleClass="auth-point-dot"/>
                                            <Label text="Protected authentication flow" wrapText="true" styleClass="auth-point-text"/>
                                        </HBox>
                                        <HBox spacing="10" alignment="CENTER_LEFT" styleClass="auth-point">
                                            <Region styleClass="auth-point-dot"/>
                                            <Label text="Continue with matches, teams, and announcements" wrapText="true" styleClass="auth-point-text"/>
                                        </HBox>
                                        <HBox spacing="10" alignment="CENTER_LEFT" styleClass="auth-point">
                                            <Region styleClass="auth-point-dot"/>
                                            <Label text="Admin controls stay limited to admin accounts" wrapText="true" styleClass="auth-point-text"/>
                                        </HBox>
                                    </VBox>
                                </VBox>

                                <!-- Right form -->
                                <VBox spacing="14" styleClass="auth-panel-form" HBox.hgrow="ALWAYS">
                                    <Label text="Sign in" styleClass="auth-form-title"/>
                                    <Label text="Enter your credentials to access your account."
                                           wrapText="true"
                                           styleClass="auth-form-copy"/>

                                    <Label fx:id="feedbackLabel"
                                           managed="false"
                                           visible="false"
                                           wrapText="true"
                                           styleClass="auth-feedback"/>

                                    <VBox spacing="12" styleClass="auth-form">

                                        <VBox spacing="6">
                                            <Label text="Email" styleClass="auth-label"/>
                                            <TextField fx:id="emailField"
                                                       promptText="name@example.com"
                                                       styleClass="auth-input"/>
                                        </VBox>

                                        <VBox spacing="6">
                                            <Label text="Password" styleClass="auth-label"/>
                                            <PasswordField fx:id="passwordField"
                                                           promptText="Enter your password"
                                                           onAction="#handleSignIn"
                                                           styleClass="auth-input"/>
                                        </VBox>

                                        <!-- Sign in + Face login -->
                                        <HBox spacing="10" styleClass="auth-actions">
                                            <Button fx:id="signInButton"
                                                    onAction="#handleSignIn"
                                                    text="Sign in"
                                                    maxWidth="Infinity"
                                                    styleClass="auth-primary-button"
                                                    HBox.hgrow="ALWAYS"/>
                                            <Button fx:id="faceLoginButton"
                                                    text="Face login"
                                                    onAction="#onFaceLogin"
                                                    maxWidth="Infinity"
                                                    styleClass="auth-primary-button"
                                                    HBox.hgrow="ALWAYS"/>
                                        </HBox>

                                        <!-- Forgot password -->
                                        <Button text="Forgot password?"
                                                onAction="#onForgotPassword"
                                                maxWidth="Infinity"
                                                styleClass="auth-ghost-button"/>

                                        <!-- Google login -->
                                        <Button text="Continue with Google"
                                                onAction="#onGoogleLogin"
                                                maxWidth="Infinity"
                                                styleClass="auth-ghost-button"/>

                                    </VBox>
                                </VBox>

                            </HBox>
                        </VBox>
                    </StackPane>
                </content>
            </ScrollPane>
        </center>

    </BorderPane>
</StackPane>
