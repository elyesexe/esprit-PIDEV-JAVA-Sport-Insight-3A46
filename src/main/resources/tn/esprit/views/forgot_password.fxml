<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="tn.esprit.Controller.ForgotPasswordController"
      alignment="CENTER"
      spacing="0"
      style="-fx-background-color: #1a1a2e;">

    <VBox alignment="CENTER" spacing="20" maxWidth="400"
          style="-fx-background-color: #16213e;
                 -fx-background-radius: 14;
                 -fx-padding: 36 40 36 40;">

        <Label text="Sport Insight"
               style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #e0e0e0;"/>

        <VBox fx:id="stepEmailPane" spacing="14" alignment="CENTER">
            <Label text="Reset your password"
                   style="-fx-font-size: 15px; -fx-text-fill: #c0c0d0;"/>
            <Label text="Enter the email address on your account."
                   wrapText="true"
                   style="-fx-font-size: 12px; -fx-text-fill: #8a8aaa; -fx-text-alignment: center;"/>

            <TextField fx:id="emailField"
                       promptText="your.email@example.com"
                       style="-fx-background-color: #0f0f23;
                              -fx-text-fill: #e0e0e0;
                              -fx-prompt-text-fill: #555577;
                              -fx-background-radius: 7;
                              -fx-padding: 10 14 10 14;
                              -fx-font-size: 13px;
                              -fx-pref-width: 300;"/>

            <Label fx:id="emailStatusLabel" text=""
                   wrapText="true"
                   style="-fx-font-size: 12px;" managed="false" visible="false"/>

            <Button fx:id="sendOtpBtn"
                    text="Send reset code"
                    onAction="#onSendOtp"
                    style="-fx-background-color: #5865f2;
                           -fx-text-fill: white;
                           -fx-font-size: 13px;
                           -fx-background-radius: 7;
                           -fx-padding: 10 0 10 0;
                           -fx-pref-width: 300;"/>
        </VBox>

        <VBox fx:id="stepOtpPane" spacing="14" alignment="CENTER" visible="false" managed="false">
            <Label text="Check your email"
                   style="-fx-font-size: 15px; -fx-text-fill: #c0c0d0;"/>
            <Label fx:id="otpHintLabel"
                   text="A 6-digit code was sent to your inbox."
                   wrapText="true"
                   style="-fx-font-size: 12px; -fx-text-fill: #8a8aaa; -fx-text-alignment: center;"/>

            <TextField fx:id="otpField"
                       promptText="000000"
                       style="-fx-background-color: #0f0f23;
                              -fx-text-fill: #e0e0e0;
                              -fx-prompt-text-fill: #555577;
                              -fx-background-radius: 7;
                              -fx-padding: 12 14 12 14;
                              -fx-font-size: 22px;
                              -fx-font-weight: bold;
                              -fx-alignment: center;
                              -fx-pref-width: 300;"/>

            <Label fx:id="otpStatusLabel" text=""
                   wrapText="true"
                   style="-fx-font-size: 12px;" managed="false" visible="false"/>

            <Button fx:id="verifyOtpBtn"
                    text="Verify code"
                    onAction="#onVerifyOtp"
                    style="-fx-background-color: #5865f2;
                           -fx-text-fill: white;
                           -fx-font-size: 13px;
                           -fx-background-radius: 7;
                           -fx-padding: 10 0 10 0;
                           -fx-pref-width: 300;"/>

            <Button fx:id="resendOtpBtn"
                    text="Resend code"
                    onAction="#onResendOtp"
                    style="-fx-background-color: transparent;
                           -fx-text-fill: #7289da;
                           -fx-font-size: 12px;
                           -fx-underline: true;"/>
        </VBox>

        <VBox fx:id="stepNewPassPane" spacing="14" alignment="CENTER" visible="false" managed="false">
            <Label text="Set a new password"
                   style="-fx-font-size: 15px; -fx-text-fill: #c0c0d0;"/>
            <Label text="Choose a password with at least 8 characters."
                   wrapText="true"
                   style="-fx-font-size: 12px; -fx-text-fill: #8a8aaa; -fx-text-alignment: center;"/>

            <PasswordField fx:id="newPasswordField"
                           promptText="New password"
                           style="-fx-background-color: #0f0f23;
                                  -fx-text-fill: #e0e0e0;
                                  -fx-prompt-text-fill: #555577;
                                  -fx-background-radius: 7;
                                  -fx-padding: 10 14 10 14;
                                  -fx-font-size: 13px;
                                  -fx-pref-width: 300;"/>

            <PasswordField fx:id="confirmPasswordField"
                           promptText="Confirm new password"
                           style="-fx-background-color: #0f0f23;
                                  -fx-text-fill: #e0e0e0;
                                  -fx-prompt-text-fill: #555577;
                                  -fx-background-radius: 7;
                                  -fx-padding: 10 14 10 14;
                                  -fx-font-size: 13px;
                                  -fx-pref-width: 300;"/>

            <Label fx:id="passStatusLabel" text=""
                   wrapText="true"
                   style="-fx-font-size: 12px;" managed="false" visible="false"/>

            <Button fx:id="savePasswordBtn"
                    text="Update password"
                    onAction="#onSavePassword"
                    style="-fx-background-color: #5865f2;
                           -fx-text-fill: white;
                           -fx-font-size: 13px;
                           -fx-background-radius: 7;
                           -fx-padding: 10 0 10 0;
                           -fx-pref-width: 300;"/>
        </VBox>

        <Button fx:id="backToLoginBtn"
                text="Back to login"
                onAction="#onBackToLogin"
                style="-fx-background-color: transparent;
                       -fx-text-fill: #7289da;
                       -fx-font-size: 12px;
                       -fx-underline: true;"/>
    </VBox>
</VBox>