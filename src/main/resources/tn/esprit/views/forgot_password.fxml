<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="tn.esprit.Controller.ForgotPasswordController"
           styleClass="page-root auth-page-root auth-feature-root">
    <Region styleClass="auth-scene-backdrop"/>

    <BorderPane styleClass="auth-layout">
        <top>
            <HBox alignment="CENTER_LEFT" spacing="16" styleClass="auth-topbar" BorderPane.alignment="CENTER">
                <padding>
                    <Insets top="14" right="24" bottom="8" left="24"/>
                </padding>
                <StackPane styleClass="auth-logo-shell">
                    <ImageView fitWidth="156" fitHeight="52" preserveRatio="true" smooth="true">
                        <image>
                            <Image url="@../images/sport-insight-logo.png"/>
                        </image>
                    </ImageView>
                </StackPane>
                <Region HBox.hgrow="ALWAYS"/>
            </HBox>
        </top>

        <center>
            <StackPane styleClass="auth-feature-center">
                <VBox alignment="CENTER" spacing="18" maxWidth="440" styleClass="auth-feature-card">
                    <VBox alignment="CENTER" spacing="6" styleClass="auth-feature-heading">
                        <Label text="Reset password" styleClass="auth-form-title"/>
                        <Label text="Use your email code, then set a new password."
                               wrapText="true"
                               textAlignment="CENTER"
                               styleClass="auth-form-copy"/>
                    </VBox>

                    <VBox fx:id="stepEmailPane" spacing="14" alignment="CENTER" styleClass="auth-feature-step">
                        <VBox spacing="6" maxWidth="330">
                            <Label text="Email" styleClass="auth-label"/>
                            <TextField fx:id="emailField"
                                       promptText="your.email@example.com"
                                       maxWidth="Infinity"
                                       styleClass="auth-input"/>
                        </VBox>

                        <Label fx:id="emailStatusLabel"
                               text=""
                               wrapText="true"
                               managed="false"
                               visible="false"
                               styleClass="auth-status-label"/>

                        <Button fx:id="sendOtpBtn"
                                text="Send reset code"
                                onAction="#onSendOtp"
                                maxWidth="330"
                                styleClass="auth-primary-button"/>
                    </VBox>

                    <VBox fx:id="stepOtpPane" spacing="14" alignment="CENTER" visible="false" managed="false"
                          styleClass="auth-feature-step">
                        <Label text="Check your email" styleClass="auth-section-title"/>
                        <Label fx:id="otpHintLabel"
                               text="A 6-digit code was sent to your inbox."
                               wrapText="true"
                               textAlignment="CENTER"
                               styleClass="auth-form-copy"/>

                        <TextField fx:id="otpField"
                                   promptText="000000"
                                   maxWidth="330"
                                   styleClass="auth-input auth-code-input"/>

                        <Label fx:id="otpStatusLabel"
                               text=""
                               wrapText="true"
                               managed="false"
                               visible="false"
                               styleClass="auth-status-label"/>

                        <Button fx:id="verifyOtpBtn"
                                text="Verify code"
                                onAction="#onVerifyOtp"
                                maxWidth="330"
                                styleClass="auth-primary-button"/>

                        <Button fx:id="resendOtpBtn"
                                text="Resend code"
                                onAction="#onResendOtp"
                                maxWidth="330"
                                styleClass="auth-link-button"/>
                    </VBox>

                    <VBox fx:id="stepNewPassPane" spacing="14" alignment="CENTER" visible="false" managed="false"
                          styleClass="auth-feature-step">
                        <Label text="Set a new password" styleClass="auth-section-title"/>
                        <Label text="Choose a password with at least 8 characters."
                               wrapText="true"
                               textAlignment="CENTER"
                               styleClass="auth-form-copy"/>

                        <VBox spacing="6" maxWidth="330">
                            <Label text="New password" styleClass="auth-label"/>
                            <PasswordField fx:id="newPasswordField"
                                           promptText="New password"
                                           maxWidth="Infinity"
                                           styleClass="auth-input"/>
                        </VBox>

                        <VBox spacing="6" maxWidth="330">
                            <Label text="Confirm password" styleClass="auth-label"/>
                            <PasswordField fx:id="confirmPasswordField"
                                           promptText="Confirm new password"
                                           maxWidth="Infinity"
                                           styleClass="auth-input"/>
                        </VBox>

                        <Label fx:id="passStatusLabel"
                               text=""
                               wrapText="true"
                               managed="false"
                               visible="false"
                               styleClass="auth-status-label"/>

                        <Button fx:id="savePasswordBtn"
                                text="Update password"
                                onAction="#onSavePassword"
                                maxWidth="330"
                                styleClass="auth-primary-button"/>
                    </VBox>

                    <Button fx:id="backToLoginBtn"
                            text="Back to login"
                            onAction="#onBackToLogin"
                            maxWidth="330"
                            styleClass="auth-ghost-button"/>
                </VBox>
            </StackPane>
        </center>
    </BorderPane>
</StackPane>
