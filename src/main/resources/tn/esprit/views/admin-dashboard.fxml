<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fitToWidth="true"
            hbarPolicy="NEVER"
            styleClass="page-scroll"
            fx:controller="tn.esprit.Controller.AdminDashboardController">
    <content>
        <StackPane styleClass="page-shell-wrap">
            <VBox spacing="22" styleClass="page-shell admin-dashboard-shell">
                <padding>
                    <Insets top="24" right="28" bottom="28" left="28"/>
                </padding>

                <HBox alignment="CENTER_LEFT" spacing="16">
                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                        <Label text="Dashboard admin" styleClass="admin-dashboard-title"/>
                        <Label text="Vue generale de l'administration avec les modules utilisateurs, annonces, entrainements, equipes, joueurs et matchs."
                               wrapText="true"
                               styleClass="admin-dashboard-subtitle"/>
                    </VBox>
                    <Label fx:id="dashboardStatusLabel"
                           text="Chargement..."
                           styleClass="status-pill status-muted"/>
                </HBox>

                <FlowPane hgap="16" vgap="16" prefWrapLength="1180" styleClass="admin-kpi-row">
                    <VBox spacing="8" styleClass="admin-kpi-card">
                        <Label text="Utilisateurs" styleClass="admin-kpi-label"/>
                        <Label fx:id="userCountLabel" text="..." styleClass="admin-kpi-value"/>
                        <Label text="comptes enregistres" styleClass="admin-kpi-meta"/>
                    </VBox>
                    <VBox spacing="8" styleClass="admin-kpi-card">
                        <Label text="Annonces" styleClass="admin-kpi-label"/>
                        <Label fx:id="annonceCountLabel" text="..." styleClass="admin-kpi-value"/>
                        <Label text="publications disponibles" styleClass="admin-kpi-meta"/>
                    </VBox>
                    <VBox spacing="8" styleClass="admin-kpi-card">
                        <Label text="Entrainements" styleClass="admin-kpi-label"/>
                        <Label fx:id="entrainementCountLabel" text="..." styleClass="admin-kpi-value"/>
                        <Label text="sessions planifiees" styleClass="admin-kpi-meta"/>
                    </VBox>
                    <VBox spacing="8" styleClass="admin-kpi-card">
                        <Label text="Equipes" styleClass="admin-kpi-label"/>
                        <Label fx:id="equipeCountLabel" text="..." styleClass="admin-kpi-value"/>
                        <Label text="equipes actives" styleClass="admin-kpi-meta"/>
                    </VBox>
                    <VBox spacing="8" styleClass="admin-kpi-card">
                        <Label text="Joueurs" styleClass="admin-kpi-label"/>
                        <Label fx:id="joueurCountLabel" text="..." styleClass="admin-kpi-value"/>
                        <Label text="profils disponibles" styleClass="admin-kpi-meta"/>
                    </VBox>
                    <VBox spacing="8" styleClass="admin-kpi-card">
                        <Label text="Matchs" styleClass="admin-kpi-label"/>
                        <Label fx:id="matchCountLabel" text="..." styleClass="admin-kpi-value"/>
                        <Label text="rencontres en base" styleClass="admin-kpi-meta"/>
                    </VBox>
                </FlowPane>

                <FlowPane hgap="18" vgap="18" prefWrapLength="1180" styleClass="admin-dashboard-grid">
                    <VBox spacing="12" styleClass="panel-card admin-table-card admin-chart-card">
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <VBox spacing="4" HBox.hgrow="ALWAYS">
                                <Label text="Statistiques equipe" styleClass="section-title admin-section-title"/>
                                <Label text="Choisissez une equipe pour afficher son taux de victoire, nul et defaite."
                                       wrapText="true"
                                       styleClass="section-subtitle"/>
                            </VBox>
                        </HBox>

                        <ComboBox fx:id="teamStatsComboBox"
                                  promptText="Choisir une equipe"
                                  styleClass="glass-combo"/>

                        <Label fx:id="teamStatsSummaryLabel"
                               text="Selectionnez une equipe pour voir ses statistiques."
                               wrapText="true"
                               styleClass="admin-chart-summary"/>

                        <BarChart fx:id="teamRateChart"
                                  animated="false"
                                  categoryGap="18"
                                  legendVisible="false"
                                  prefHeight="260"
                                  styleClass="admin-stats-chart">
                            <xAxis>
                                <CategoryAxis side="BOTTOM"/>
                            </xAxis>
                            <yAxis>
                                <NumberAxis autoRanging="false" lowerBound="0.0" upperBound="100.0" tickUnit="20.0" side="LEFT"/>
                            </yAxis>
                        </BarChart>
                    </VBox>

                    <VBox spacing="12" styleClass="panel-card admin-table-card admin-chart-card">
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <VBox spacing="4" HBox.hgrow="ALWAYS">
                                <Label text="Statistiques joueurs" styleClass="section-title admin-section-title"/>
                                <Label text="Repartition des joueurs par equipe pour suivre les effectifs."
                                       wrapText="true"
                                       styleClass="section-subtitle"/>
                            </VBox>
                        </HBox>

                        <Label fx:id="playerChartSummaryLabel"
                               text="Chargement des statistiques joueurs..."
                               wrapText="true"
                               styleClass="admin-chart-summary"/>

                        <BarChart fx:id="playerDistributionChart"
                                  animated="false"
                                  categoryGap="14"
                                  legendVisible="false"
                                  prefHeight="260"
                                  styleClass="admin-stats-chart">
                            <xAxis>
                                <CategoryAxis side="BOTTOM"/>
                            </xAxis>
                            <yAxis>
                                <NumberAxis forceZeroInRange="true" side="LEFT"/>
                            </yAxis>
                        </BarChart>
                    </VBox>

                    <VBox spacing="12" styleClass="panel-card admin-table-card admin-chart-card">
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <VBox spacing="4" HBox.hgrow="ALWAYS">
                                <Label text="Statistiques matchs" styleClass="section-title admin-section-title"/>
                                <Label text="Vue de la repartition des matchs selon leur statut actuel."
                                       wrapText="true"
                                       styleClass="section-subtitle"/>
                            </VBox>
                        </HBox>

                        <Label fx:id="matchChartSummaryLabel"
                               text="Chargement des statistiques matchs..."
                               wrapText="true"
                               styleClass="admin-chart-summary"/>

                        <PieChart fx:id="matchStatusChart"
                                  clockwise="true"
                                  labelsVisible="true"
                                  legendVisible="true"
                                  prefHeight="260"
                                  styleClass="admin-stats-chart"/>
                    </VBox>
                </FlowPane>

                <HBox spacing="18" styleClass="admin-dashboard-grid">
                    <VBox spacing="12" styleClass="panel-card admin-table-card" HBox.hgrow="ALWAYS">
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <VBox spacing="4" HBox.hgrow="ALWAYS">
                                <Label text="Utilisateurs recents" styleClass="section-title admin-section-title"/>
                                <Label text="Derniers comptes avec leur role principal et leur statut."
                                       wrapText="true"
                                       styleClass="section-subtitle"/>
                            </VBox>
                            <Label text="6 lignes" styleClass="toolbar-chip-soft"/>
                        </HBox>

                        <TableView fx:id="usersTableView"
                                   prefHeight="280"
                                   styleClass="data-table admin-dashboard-table">
                            <columns>
                                <TableColumn fx:id="userIdColumn" text="ID" prefWidth="70"/>
                                <TableColumn fx:id="userNameColumn" text="Utilisateur" prefWidth="210"/>
                                <TableColumn fx:id="userRoleColumn" text="Role" prefWidth="140"/>
                                <TableColumn fx:id="userStatusColumn" text="Statut" prefWidth="120"/>
                            </columns>
                            <placeholder>
                                <Label text="Aucun utilisateur disponible." styleClass="empty-text"/>
                            </placeholder>
                        </TableView>
                    </VBox>

                    <VBox spacing="12" styleClass="panel-card admin-table-card" HBox.hgrow="ALWAYS">
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <VBox spacing="4" HBox.hgrow="ALWAYS">
                                <Label text="Annonces recentes" styleClass="section-title admin-section-title"/>
                                <Label text="Dernieres publications avec leur statut et niveau requis."
                                       wrapText="true"
                                       styleClass="section-subtitle"/>
                            </VBox>
                            <Label text="6 lignes" styleClass="toolbar-chip-soft"/>
                        </HBox>

                        <TableView fx:id="annoncesTableView"
                                   prefHeight="280"
                                   styleClass="data-table admin-dashboard-table">
                            <columns>
                                <TableColumn fx:id="annonceIdColumn" text="ID" prefWidth="70"/>
                                <TableColumn fx:id="annonceTitleColumn" text="Titre" prefWidth="240"/>
                                <TableColumn fx:id="annonceLevelColumn" text="Niveau" prefWidth="150"/>
                                <TableColumn fx:id="annonceStatusColumn" text="Statut" prefWidth="130"/>
                            </columns>
                            <placeholder>
                                <Label text="Aucune annonce disponible." styleClass="empty-text"/>
                            </placeholder>
                        </TableView>
                    </VBox>
                </HBox>

                <HBox spacing="18" styleClass="admin-dashboard-grid">
                    <VBox spacing="12" styleClass="panel-card admin-table-card" HBox.hgrow="ALWAYS">
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <VBox spacing="4" HBox.hgrow="ALWAYS">
                                <Label text="Entrainements recents" styleClass="section-title admin-section-title"/>
                                <Label text="Sessions recentes avec type, lieu et horaire."
                                       wrapText="true"
                                       styleClass="section-subtitle"/>
                            </VBox>
                            <Label text="6 lignes" styleClass="toolbar-chip-soft"/>
                        </HBox>

                        <TableView fx:id="entrainementsTableView"
                                   prefHeight="280"
                                   styleClass="data-table admin-dashboard-table">
                            <columns>
                                <TableColumn fx:id="entrainementIdColumn" text="ID" prefWidth="70"/>
                                <TableColumn fx:id="entrainementDateColumn" text="Date" prefWidth="140"/>
                                <TableColumn fx:id="entrainementTypeColumn" text="Type" prefWidth="160"/>
                                <TableColumn fx:id="entrainementPlaceColumn" text="Lieu" prefWidth="160"/>
                                <TableColumn fx:id="entrainementTimeColumn" text="Horaire" prefWidth="170"/>
                            </columns>
                            <placeholder>
                                <Label text="Aucun entrainement disponible." styleClass="empty-text"/>
                            </placeholder>
                        </TableView>
                    </VBox>

                    <VBox spacing="12" styleClass="panel-card admin-table-card" HBox.hgrow="ALWAYS">
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <VBox spacing="4" HBox.hgrow="ALWAYS">
                                <Label text="Vue operationnelle" styleClass="section-title admin-section-title"/>
                                <Label text="Resume croise des equipes, joueurs et matchs les plus recents."
                                       wrapText="true"
                                       styleClass="section-subtitle"/>
                            </VBox>
                            <Label text="8 lignes" styleClass="toolbar-chip-soft"/>
                        </HBox>

                        <TableView fx:id="operationsTableView"
                                   prefHeight="280"
                                   styleClass="data-table admin-dashboard-table">
                            <columns>
                                <TableColumn fx:id="operationModuleColumn" text="Module" prefWidth="130"/>
                                <TableColumn fx:id="operationPrimaryColumn" text="Element" prefWidth="280"/>
                                <TableColumn fx:id="operationSecondaryColumn" text="Detail" prefWidth="240"/>
                                <TableColumn fx:id="operationMetaColumn" text="Meta" prefWidth="170"/>
                            </columns>
                            <placeholder>
                                <Label text="Aucune donnee operationnelle disponible." styleClass="empty-text"/>
                            </placeholder>
                        </TableView>
                    </VBox>
                </HBox>
            </VBox>
        </StackPane>
    </content>
</ScrollPane>
