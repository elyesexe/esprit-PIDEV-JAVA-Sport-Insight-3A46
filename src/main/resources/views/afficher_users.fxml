<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="tn.esprit.controllers.AfficherUsersController"
      prefWidth="1000" prefHeight="650" spacing="0"
      style="-fx-background-color: #f4f6f8;">

    <!-- TOP BAR -->
    <HBox style="-fx-background-color: #1a3a5c; -fx-padding: 14 24 14 24;"
          alignment="CENTER_LEFT" spacing="12">
        <Label text="Sport Insight - Gestion des utilisateurs"
               style="-fx-font-size: 15px; -fx-font-weight: bold;
                      -fx-text-fill: white; -fx-font-family: 'Georgia';"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="errorLabel" text=""
               style="-fx-text-fill: #ff9999; -fx-font-size: 12px;"/>
    </HBox>

    <!-- SEARCH BAR -->
    <HBox style="-fx-padding: 12 24 8 24; -fx-background-color: #eaf0f6;"
          spacing="10" alignment="CENTER_LEFT">
        <Label text="Recherche par ID :"
               style="-fx-font-size: 12px; -fx-text-fill: #444;"/>
        <TextField fx:id="searchIdField" promptText="Ex: 3"
                   prefWidth="90" prefHeight="32"
                   style="-fx-background-radius: 4; -fx-border-color: #ccc;
                          -fx-border-radius: 4; -fx-font-size: 13px;"/>
        <Button text="Chercher" onAction="#handleSearchById"
                prefHeight="32"
                style="-fx-background-color: #1a3a5c; -fx-text-fill: white;
                       -fx-font-size: 12px; -fx-background-radius: 4; -fx-cursor: hand;"/>
        <Separator orientation="VERTICAL"/>
        <Label text="Recherche par nom :"
               style="-fx-font-size: 12px; -fx-text-fill: #444;"/>
        <TextField fx:id="searchNomField" promptText="Ex: Dupont"
                   prefWidth="150" prefHeight="32"
                   style="-fx-background-radius: 4; -fx-border-color: #ccc;
                          -fx-border-radius: 4; -fx-font-size: 13px;"/>
        <Button text="Chercher" onAction="#handleSearchByNom"
                prefHeight="32"
                style="-fx-background-color: #1a3a5c; -fx-text-fill: white;
                       -fx-font-size: 12px; -fx-background-radius: 4; -fx-cursor: hand;"/>
        <Button text="Reinitialiser" onAction="#handleReset"
                prefHeight="32"
                style="-fx-background-color: #888; -fx-text-fill: white;
                       -fx-font-size: 12px; -fx-background-radius: 4; -fx-cursor: hand;"/>
    </HBox>

    <!-- ACTION BUTTONS -->
    <HBox style="-fx-padding: 10 24 10 24; -fx-background-color: #f4f6f8;"
          spacing="10" alignment="CENTER_LEFT">
        <Button fx:id="ajouterBtn" text="+ Ajouter" onAction="#handleAjouter"
                prefHeight="34"
                style="-fx-background-color: #1a3a5c; -fx-text-fill: white;
                       -fx-font-size: 13px; -fx-background-radius: 4;
                       -fx-cursor: hand; -fx-padding: 0 16 0 16;"/>
        <Button fx:id="modifierBtn" text="Modifier" onAction="#handleModifier"
                prefHeight="34"
                style="-fx-background-color: #3a7abd; -fx-text-fill: white;
                       -fx-font-size: 13px; -fx-background-radius: 4;
                       -fx-cursor: hand; -fx-padding: 0 16 0 16;"/>
        <Button fx:id="supprimerBtn" text="Supprimer" onAction="#handleSupprimer"
                prefHeight="34"
                style="-fx-background-color: #c0392b; -fx-text-fill: white;
                       -fx-font-size: 13px; -fx-background-radius: 4;
                       -fx-cursor: hand; -fx-padding: 0 16 0 16;"/>
        <Separator orientation="VERTICAL"/>
        <Button text="Tri A-Z" onAction="#handleTriAlpha"
                prefHeight="34"
                style="-fx-background-color: #5a6a7c; -fx-text-fill: white;
                       -fx-font-size: 13px; -fx-background-radius: 4;
                       -fx-cursor: hand; -fx-padding: 0 16 0 16;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Exporter PDF" onAction="#handleExportPdf"
                prefHeight="34"
                style="-fx-background-color: #c0392b; -fx-text-fill: white;
                       -fx-font-size: 13px; -fx-background-radius: 4;
                       -fx-cursor: hand; -fx-padding: 0 16 0 16;"/>
        <Button fx:id="rafraichirBtn" text="Rafraichir" onAction="#handleRafraichir"
                prefHeight="34"
                style="-fx-background-color: #888; -fx-text-fill: white;
                       -fx-font-size: 13px; -fx-background-radius: 4;
                       -fx-cursor: hand; -fx-padding: 0 16 0 16;"/>
    </HBox>

    <!-- TABLE -->
    <TableView fx:id="tableView" VBox.vgrow="ALWAYS"
               style="-fx-background-color: white;">
        <columns>
            <TableColumn fx:id="colId"        text="ID"        prefWidth="55"/>
            <TableColumn fx:id="colNom"       text="Nom"       prefWidth="130"/>
            <TableColumn fx:id="colPrenom"    text="Prenom"    prefWidth="130"/>
            <TableColumn fx:id="colEmail"     text="Email"     prefWidth="220"/>
            <TableColumn fx:id="colTelephone" text="Telephone" prefWidth="130"/>
            <TableColumn fx:id="colStatut"    text="Statut"    prefWidth="90"/>
            <TableColumn fx:id="colRoles"     text="Role"      prefWidth="130"/>
        </columns>
        <placeholder>
            <Label text="Aucun utilisateur trouve."
                   style="-fx-text-fill: #888; -fx-font-size: 13px;"/>
        </placeholder>
    </TableView>

    <!-- FOOTER -->
    <HBox style="-fx-background-color: #e8edf2; -fx-padding: 8 24 8 24;"
          alignment="CENTER_LEFT" spacing="16">
        <Label fx:id="countLabel" text="0 utilisateur(s)"
               style="-fx-font-size: 11px; -fx-text-fill: #555;"/>
        <Label text="| Selectionnez une ligne pour Modifier ou Supprimer"
               style="-fx-font-size: 11px; -fx-text-fill: #888;"/>
    </HBox>
</VBox>
