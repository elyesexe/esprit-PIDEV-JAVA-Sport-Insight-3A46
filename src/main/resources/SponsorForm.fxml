<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<GridPane xmlns="http://javafx.com/javafx/11.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.controllers.SponsorFormController" hgap="10" vgap="10" alignment="CENTER">
   <children>
      <Label text="Nom:" GridPane.rowIndex="0" GridPane.columnIndex="0" />
      <TextField fx:id="nomField" GridPane.rowIndex="0" GridPane.columnIndex="1" prefWidth="200" />

      <Label text="Email:" GridPane.rowIndex="1" GridPane.columnIndex="0" />
      <TextField fx:id="emailField" GridPane.rowIndex="1" GridPane.columnIndex="1" />

      <Label text="Téléphone:" GridPane.rowIndex="2" GridPane.columnIndex="0" />
      <TextField fx:id="telephoneField" GridPane.rowIndex="2" GridPane.columnIndex="1" />

      <Label text="Budget:" GridPane.rowIndex="3" GridPane.columnIndex="0" />
      <TextField fx:id="budgetField" GridPane.rowIndex="3" GridPane.columnIndex="1" />

      <Label text="Adresse:" GridPane.rowIndex="4" GridPane.columnIndex="0" />
      <TextField fx:id="adresseField" GridPane.rowIndex="4" GridPane.columnIndex="1" />

      <Label text="Logo Name:" GridPane.rowIndex="5" GridPane.columnIndex="0" />
      <TextField fx:id="logoNameField" GridPane.rowIndex="5" GridPane.columnIndex="1" />

      <HBox spacing="10" alignment="CENTER" GridPane.rowIndex="6" GridPane.columnIndex="0" GridPane.columnSpan="2">
         <Button text="Sauvegarder" onAction="#saveSponsor" />
         <Button text="Annuler" onAction="#cancel" />
      </HBox>
   </children>
</GridPane>
